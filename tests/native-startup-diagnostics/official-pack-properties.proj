<Project DefaultTargets="Parent">
  <PropertyGroup>
    <GuestPropertiesTarget Condition=" '$(GuestPropertiesTarget)' == '' ">..\..\build-tools\scripts\GuestReadinessPackProperties.targets</GuestPropertiesTarget>
  </PropertyGroup>
  <Import Project="$(GuestPropertiesTarget)" />
  <Target Name="_SetGlobalProperties">
    <ItemGroup>
      <_GlobalProperties Include="-p:Configuration=$(Configuration)" />
    </ItemGroup>
  </Target>
  <Target Name="Parent" DependsOnTargets="_SetGlobalProperties">
    <Exec Command="&quot;$(MSBuildBinPath)\MSBuild.exe&quot; &quot;$(MSBuildProjectFullPath)&quot; /nologo /v:q /t:Child @(_GlobalProperties, ' ') &quot;/p:ResultPath=$(ResultPath)&quot;" />
  </Target>
  <Target Name="Child">
    <WriteLinesToFile File="$(ResultPath)" Overwrite="true"
        Lines="$(AndroidGuestReadinessBuild)|$(AndroidPackVersionLong)|$(PackageVersion)|$(AndroidStartupDiagnosticsBuildId)|$(RunningOnCI)|$(Configuration)|$(RestoreConfigFile)" />
  </Target>
  <UsingTask TaskName="NuGet.Build.Tasks.GetRestoreSettingsTask" AssemblyFile="$(MSBuildToolsPath)\NuGet.Build.Tasks.dll" />
  <Target Name="RestoreSettings">
    <GetRestoreSettingsTask ProjectUniqueName="$(MSBuildProjectFullPath)"
        RestoreConfigFile="$(RestoreConfigFile)" RestorePackagesPath="$(RestorePackagesPath)"
        RestoreProjectStyle="PackageReference" MSBuildStartupDirectory="$(MSBuildStartupDirectory)">
      <Output TaskParameter="OutputSources" PropertyName="ObservedSources" />
      <Output TaskParameter="OutputConfigFilePaths" PropertyName="ObservedConfigs" />
    </GetRestoreSettingsTask>
    <WriteLinesToFile File="$(ResultPath)" Overwrite="true" Lines="$(ObservedSources)" />
    <WriteLinesToFile File="$(ResultPath).configs" Overwrite="true" Lines="$(ObservedConfigs)" />
  </Target>
</Project>
