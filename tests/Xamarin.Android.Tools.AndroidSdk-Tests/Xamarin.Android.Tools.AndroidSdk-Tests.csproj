<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\Configuration.props" />
  <Import Project="..\..\build-tools\scripts\MSTestReferences.projitems" />

  <PropertyGroup>
    <TargetFramework>$(DotNetStableTargetFramework)</TargetFramework>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\product.snk</AssemblyOriginatorKeyFile>
    <IsPackable>false</IsPackable>
    <OutputPath>$(TestOutputDirectory)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Microsoft.Android.Run\AdbHelper.cs" Link="AdbHelper.cs" />
    <Compile Include="..\..\src\Microsoft.Android.Run\AndroidTestAdapter.cs" Link="AndroidTestAdapter.cs" />
    <Compile Include="..\..\src\Microsoft.Android.Run\InstrumentationProtocol.cs" Link="InstrumentationProtocol.cs" />
    <PackageReference Include="SharpZipLib" Version="$(SharpZipLibVersion)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\manifest-simplewidget.xml">
      <LogicalName>manifest-simplewidget.xml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Xamarin.Android.Tools.AndroidSdk\Xamarin.Android.Tools.AndroidSdk.csproj" />
    <ProjectReference Include="..\..\src\Xamarin.Installer.AndroidSDK\Xamarin.Installer.AndroidSDK.csproj" />
  </ItemGroup>

</Project>
