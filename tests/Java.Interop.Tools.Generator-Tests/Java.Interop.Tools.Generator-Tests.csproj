<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>11.0.0</Version>
    <LangVersion>13.0</LangVersion>
    <TargetFramework>$(DotNetStableTargetFramework)</TargetFramework>
    <RootNamespace>Java.Interop.Tools.Common_Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <Import Project="..\..\Configuration.props" />

  <PropertyGroup>
    <OutputPath>$(TestOutputDirectory)$(DotNetStableTargetFramework)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="nunit" Version="3.14.0" />
    <PackageReference Include="NUnit.ConsoleRunner" Version="3.22.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Java.Interop.Tools.Generator\Java.Interop.Tools.Generator.csproj" />
  </ItemGroup>

</Project>
