<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <_JavaInteropTestsJarFile>Jars\Mono.Android-Test-classes-trimmable.jar</_JavaInteropTestsJarFile>
  </PropertyGroup>
  <ItemGroup>
    <AndroidJavaLibrary Include="$(_JavaInteropTestsJarFile)" />
    <!--
      Once BuildTestJarFile has written these, the SDK's default @(AndroidLibrary)
      glob (**\*.jar, %(Bind)=true) would bind our own test JAR on any later
      evaluation. Also exclude the legacy variant left by earlier builds.
      See dotnet/android#12254.
    -->
    <AndroidLibrary Remove="Jars\Mono.Android-Test-classes.jar" />
    <AndroidLibrary Remove="Jars\Mono.Android-Test-classes-trimmable.jar" />
  </ItemGroup>
  <Import Project="..\..\..\build-tools\scripts\Jar.targets" />
  <ItemDefinitionGroup>
    <TestJarEntry>
      <OutputFile>$(_JavaInteropTestsJarFile)</OutputFile>
    </TestJarEntry>
  </ItemDefinitionGroup>
  <ItemGroup>
    <!-- These fixtures are compiled into the test JAR, not individually by the Android SDK. -->
    <AndroidJavaSource Remove="java\**\*.java" />
  </ItemGroup>

  <ItemGroup>
    <TestJarEntry Include="$(MSBuildThisFileDirectory)java\**\*.java" />
  </ItemGroup>
  <Target Name="_CopyTestJarFiles"
      Inputs="%(TestJarEntry.OutputFile)"
      Outputs="$(OutputPath)$([System.IO.Path]::GetFileName('%(TestJarEntry.OutputFile)'))">
    <Copy
        SourceFiles="%(TestJarEntry.OutputFile)"
        DestinationFolder="$(OutputPath)"
    />
  </Target>
  <Target Name="CleanLocal">
    <RemoveDir Directories="Jars"/>
  </Target>
</Project>
