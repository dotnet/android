<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\Configuration.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(DotNetTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <OutputPath>$(TestOutputDirectory)ResourceDesignerBenchmarks\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <ProjectReference Include="..\..\src\Microsoft.Android.Build.Tasks\Microsoft.Android.Build.Tasks.csproj" />
    <None Include="..\..\src\Xamarin.Android.Build.Tasks\Tests\Xamarin.Android.Build.Tests\Resources\R.txt" Link="Resources\R.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
