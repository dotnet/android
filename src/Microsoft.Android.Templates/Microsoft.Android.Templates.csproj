<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DotNetTargetFramework)</TargetFramework>
    <LangVersion>preview</LangVersion>
    <MemorySafetyRulesVersion>2</MemorySafetyRulesVersion>
    <PackageType>Template</PackageType>
    <PackageId>Microsoft.Android.Templates</PackageId>
    <Title>.NET for Android Templates</Title>
    <Description>Templates for Android platforms.</Description>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Only localize templates on demand avoid verbose template localizer output during local development -->
    <!-- Set this property to `true` on command line, or uncomment it below, to enable localization -->
    <!-- LocalizeTemplates>true</LocalizeTemplates -->
    <ContentTargetFolders>content</ContentTargetFolders>
    <OutputPath>..\..\bin\Build$(Configuration)\nuget-unsigned\</OutputPath>
    <!-- Remove the `<group targetFramework=".NETStandard2.0" />` entry from the .nuspec. -->
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <Import Project="..\..\Configuration.props" />
  <Import Project="..\..\build-tools\create-packs\License.targets" />
  <Import Project="..\..\build-tools\scripts\LongBranchNames.props" />

  <ItemGroup>
    <Content Include="**\*" Exclude="**\bin\**;**\obj\**;.gitignore;Directory.Build.targets;Microsoft.Android.Templates.csproj" />
    <Compile Remove="**\*" />
  </ItemGroup>

  <ItemGroup Condition=" '$(LocalizeTemplates)' == 'true' ">
    <PackageReference Include="Microsoft.TemplateEngine.Authoring.Tasks" Version="$(MicrosoftTemplateEngineAuthoringTasksPackageVersion)" PrivateAssets="all" IsImplicitlyDefined="true" />
  </ItemGroup>

  <UsingTask AssemblyFile="$(PrepTasksAssembly)" TaskName="Xamarin.Android.BuildTools.PrepTasks.ReplaceFileContents" TaskFactory="TaskHostFactory" Runtime="NET" />

  <!-- Projects created from the templates reference the Microsoft.Android NuGet with the version of the templates. -->
  <Target Name="_ReplaceMicrosoftAndroidPackageVersion"
      BeforeTargets="_GetPackageFiles"
      DependsOnTargets="_GetDefaultPackageVersion">
    <ItemGroup>
      <_TemplateProject Include="@(Content)" Condition=" '%(Extension)' == '.csproj' ">
        <ReplacedPath>$(IntermediateOutputPath)templates\%(Identity)</ReplacedPath>
        <PackagePath>content\%(RelativeDir)</PackagePath>
      </_TemplateProject>
    </ItemGroup>
    <MakeDir Directories="@(_TemplateProject->'%(ReplacedPath)'->'%(RootDir)%(Directory)')" />
    <ReplaceFileContents
        SourceFile="%(_TemplateProject.Identity)"
        DestinationFile="%(_TemplateProject.ReplacedPath)"
        Replacements="MICROSOFT_ANDROID_PACKAGE_VERSION=$(PackageVersion)"
    />
    <ItemGroup>
      <Content Remove="@(_TemplateProject)" />
      <Content Include="@(_TemplateProject->'%(ReplacedPath)')" />
    </ItemGroup>
  </Target>

</Project>
