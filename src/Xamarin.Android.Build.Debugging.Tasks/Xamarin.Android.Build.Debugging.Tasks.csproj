
<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)..\..\Configuration.props" />
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1305</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <TargetFramework>net11.0</TargetFramework>
    <RuntimeFrameworkVersion>11.0.0-rtm.26479.103</RuntimeFrameworkVersion>
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet11/nuget/v3/index.json</RestoreAdditionalProjectSources>
    <LibZipSharpBundleAllNativeLibraries>true</LibZipSharpBundleAllNativeLibraries>
    <DefineConstants>$(DefineConstants);MSBUILD</DefineConstants>
    <OutputPath>$(MicrosoftAndroidSdkOutDir)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SignAssembly>true</SignAssembly>
    <DelaySign>false</DelaySign>
    <AssemblyOriginatorKeyFile>product.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <Import Project="..\Microsoft.Android.Build.BaseTasks\MSBuildReferences.projitems" />

  <Import Project="..\..\build-tools\scripts\XAVersionInfo.targets" />

  <ItemGroup>
    <FrameworkReference Update="Microsoft.NETCore.App" TargetingPackVersion="$(RuntimeFrameworkVersion)" />
    <Compile Remove="external\**" />
    <Compile Remove="Linker\**" />
    <Compile Remove="Mono.Android\**" />
    <Compile Remove="Resources\**" />
    <EmbeddedResource Remove="external\**" />
    <EmbeddedResource Remove="Linker\**" />
    <EmbeddedResource Remove="Mono.Android\**" />
    <EmbeddedResource Remove="Resources\**" />
    <None Remove="external\**" />
    <None Remove="Linker\**" />
    <None Remove="Mono.Android\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Xamarin.Android.Common.Debugging.targets">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Xamarin.Android.Common.Debugging.props">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xamarin.Android.Tools.AndroidSdk\Xamarin.Android.Tools.AndroidSdk.csproj" />
    <ProjectReference Include="..\Microsoft.Android.Build.BaseTasks\Microsoft.Android.Build.BaseTasks.csproj" />
  </ItemGroup>

  <Target Name="_SetAssemblyVersion"
      DependsOnTargets="GetXAVersionInfo"
      BeforeTargets="GetAssemblyVersion">
    <PropertyGroup>
      <Version>$(ProductVersion).$(PackVersionCommitCount)</Version>
    </PropertyGroup>
  </Target>

</Project>
