<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <UsingTask AssemblyFile="$(BootstrapTasksAssembly)" TaskName="Xamarin.Android.Tools.BootstrapTasks.RunParallelCmds" TaskFactory="TaskHostFactory" Runtime="NET" />

  <Target Name="_PrepareCommonProperties">
    <PropertyGroup>
      <FlavorIntermediateOutputPath>$(IntermediateOutputPath)\$(CMakeRuntimeFlavor)\</FlavorIntermediateOutputPath>
    </PropertyGroup>
  </Target>

  <Target Name="_BuildRuntimes" BeforeTargets="Build"
          DependsOnTargets="_PrepareCommonProperties;_ConfigureAndBuildTestJniLibrary;_ConfigureRuntimes;_BuildAndroidRuntimes;_CopyToPackDirs">
  </Target>

  <Target Name="_ConfigureRuntimesInputs">
    <ItemGroup>
      <_ConfigureRuntimesInputs  Include="..\..\build-tools\scripts\Ndk.targets" />
      <_ConfigureRuntimesInputs  Include="CMakeLists.txt" />
      <_ConfigureRuntimesInputs  Include="CMakePresets.json" />
      <_ConfigureRuntimesInputs  Include="common\java-interop\CMakeLists.txt" />
      <_ConfigureRuntimesInputs  Include="common\runtime-base\CMakeLists.txt" />

      <_ConfigureRuntimesOutputs Include="@(AndroidSupportedTargetJitAbi->'$(FlavorIntermediateOutputPath)\%(AndroidRID)-Debug\CMakeCache.txt')" />
      <_ConfigureRuntimesOutputs Include="@(AndroidSupportedTargetJitAbi->'$(FlavorIntermediateOutputPath)\%(AndroidRID)-Release\CMakeCache.txt')" />

      <_OutputDirsToCreate       Include="$(FlavorIntermediateOutputPath)\%(AndroidSupportedTargetJitAbi.AndroidRID)-Debug" />
      <_OutputDirsToCreate       Include="$(FlavorIntermediateOutputPath)\%(AndroidSupportedTargetJitAbi.AndroidRID)-Release" />
    </ItemGroup>

    <ItemGroup Condition=" '$(CMakeRuntimeFlavor)' == 'CoreCLR' ">
      <_ConfigureRuntimesInputs  Include="clr\host\CMakeLists.txt" />
      <_ConfigureRuntimesInputs  Include="clr\runtime-base\CMakeLists.txt" />
      <_ConfigureRuntimesInputs  Include="clr\shared\CMakeLists.txt" />
    </ItemGroup>

    <ItemGroup Condition=" '$(CMakeRuntimeFlavor)' == 'NativeAOT' ">
      <_ConfigureRuntimesInputs  Include="nativeaot\host\CMakeLists.txt" />
    </ItemGroup>
  </Target>

  <Target Name="_ConfigureTestJniLibraryInputsAndOutputs">
    <ItemGroup>
      <_TestJniLibraryAbi Include="@(AndroidSupportedTargetJitAbi)" />
      <_TestJniLibraryAbi Remove="armeabi-v7a" />
      <_TestJniLibraryAbi Remove="x86" />
    </ItemGroup>

    <ItemGroup>
      <_TestJniLibraryInput Include="common\test-jni-library\CMakeLists.txt" />
      <_TestJniLibraryInput Include="CMakePresets.json" />

      <_TestJniLibraryOutput Include="@(_TestJniLibraryAbi->'$(FlavorIntermediateOutputPath)%(AndroidRID)-test-jni-library\CMakeCache.txt')" />

      <_TestJniLibraryOutputDirToCreate Include="$(FlavorIntermediateOutputPath)%(_TestJniLibraryAbi.AndroidRID)-test-jni-library" />
    </ItemGroup>
  </Target>

  <Target Name="_ConfigureAndBuildTestJniLibrary"
          Condition="'$(CMakeRuntimeFlavor)' != 'NativeAOT' "
          DependsOnTargets="_PrepareCommonProperties;_ConfigureTestJniLibraryInputsAndOutputs"
          Inputs="@(_TestJniLibraryInput)"
          Outputs="@(_TestJniLibraryOutput)">
    <ItemGroup>
      <_ConfigureTestJniLibraryCommands Include="@(_TestJniLibraryAbi)">
        <Command>$(CmakePath)</Command>
        <Arguments>-DOUTPUT_PATH="$(OutputPath.TrimEnd('\'))" -DRUNTIME_FLAVOR="$(CMakeRuntimeFlavor)" --preset default-release-%(_TestJniLibraryAbi.Identity) -DBUILD_TEST_JNI_LIBRARY=ON "$(MSBuildThisFileDirectory.TrimEnd('\'))"</Arguments>
        <WorkingDirectory>$(FlavorIntermediateOutputPath)%(_TestJniLibraryAbi.AndroidRID)-test-jni-library</WorkingDirectory>
      </_ConfigureTestJniLibraryCommands>
    </ItemGroup>

    <MakeDir Directories="@(_TestJniLibraryOutputDirToCreate)" />
    <RunParallelCmds Commands="@(_ConfigureTestJniLibraryCommands)" />

    <Exec
        Command="$(NinjaPath) -v"
        WorkingDirectory="$(FlavorIntermediateOutputPath)%(_TestJniLibraryAbi.AndroidRID)-test-jni-library" />

    <Touch Files="@(_TestJniLibraryOutput)" />
  </Target>

  <Target Name="_ConfigureRuntimes"
          DependsOnTargets="_ConfigureRuntimesInputs"
          Inputs="@(_ConfigureRuntimesInputs)"
          Outputs="@(_ConfigureRuntimesOutputs)">
    <PropertyGroup>
      <_PresetPrefix Condition=" '$(CMakeRuntimeFlavor)' == 'NativeAOT' ">nativeaot-</_PresetPrefix>
      <_PresetPrefix Condition=" '$(CMakeRuntimeFlavor)' == 'CoreCLR' ">coreclr-</_PresetPrefix>
      <_NoInline Condition=" '$(DoNotInlineMonodroid)' == 'true' ">-DDONT_INLINE=ON</_NoInline>
      <_NoStrip Condition=" '$(DoNotStripMonodroid)' == 'true' ">-DSTRIP_DEBUG=OFF</_NoStrip>
      <_LocalDotNetRuntimePath Condition=" '$(CLRLocalRuntimePath)' != '' And '$(CMakeRuntimeFlavor)' == 'CoreCLR' ">-DLOCAL_CORECLR_PATH="$(CLRLocalRuntimePath)"</_LocalDotNetRuntimePath>
      <_LocalDotNetRuntimeConfig Condition=" '$(CLRLocalRuntimeConfig)' != '' And '$(CMakeRuntimeFlavor)' == 'CoreCLR' ">-DLOCAL_CORECLR_CONFIG="$(CLRLocalRuntimeConfig)"</_LocalDotNetRuntimeConfig>
      <_CmakeAndroidFlags>-DOUTPUT_PATH="$(OutputPath.TrimEnd('\'))" -DRUNTIME_FLAVOR="$(CMakeRuntimeFlavor)" $(_NoInline) $(_NoStrip) $(_LocalDotNetRuntimePath) $(_LocaLDotNetRuntimeConfig) "$(MSBuildThisFileDirectory.TrimEnd('\'))"</_CmakeAndroidFlags>
    </PropertyGroup>

    <ItemGroup>
      <_ConfigureRuntimeCommands Include="@(AndroidSupportedTargetJitAbi)">
        <Command>$(CmakePath)</Command>
        <Arguments>--preset $(_PresetPrefix)default-debug-%(AndroidSupportedTargetJitAbi.Identity) $(_CmakeAndroidFlags)</Arguments>
        <WorkingDirectory>$(FlavorIntermediateOutputPath)%(AndroidSupportedTargetJitAbi.AndroidRID)-Debug</WorkingDirectory>
      </_ConfigureRuntimeCommands>

      <_ConfigureRuntimeCommands Include="@(AndroidSupportedTargetJitAbi)">
        <Command>$(CmakePath)</Command>
        <Arguments>--preset $(_PresetPrefix)default-release-%(AndroidSupportedTargetJitAbi.Identity) $(_CmakeAndroidFlags)</Arguments>
        <WorkingDirectory>$(FlavorIntermediateOutputPath)%(AndroidSupportedTargetJitAbi.AndroidRID)-Release</WorkingDirectory>
      </_ConfigureRuntimeCommands>
    </ItemGroup>

    <MakeDir Directories="@(_OutputDirsToCreate)"/>
    <RunParallelCmds Commands="@(_ConfigureRuntimeCommands)" />
    <Touch Files="@(_ConfigureRuntimesOutputs)" />
  </Target>

  <!-- TODO: update for the changes -->
  <Target Name="_FindRuntimeSources">
    <ItemGroup>
      <_RuntimeSources Include="$(JavaInteropFullPath)\src\java-interop\*.cc;$(JavaInteropFullPath)\src\java-interop\*.h" />
      <_RuntimeSources Include="common\include\**\*.hh" />
      <_RuntimeSources Include="common\runtime-base\*.cc" />
    </ItemGroup>

    <ItemGroup Condition=" '$(CMakeRuntimeFlavor)' == 'CoreCLR' ">
      <_RuntimeSources Include="clr\include\**\*.hh" />
      <_RuntimeSources Include="clr\host\*.cc;clr\host\*.hh" />
      <_RuntimeSources Include="clr\startup\*.cc;clr\startup\*.hh" />
      <_RuntimeSources Include="clr\runtime-base\*.cc;clr\runtime-base\*.hh" />
      <_RuntimeSources Include="clr\shared\*.cc;clr\shared\*.hh" />
    </ItemGroup>

    <ItemGroup Condition=" '$(CMakeRuntimeFlavor)' == 'NativeAOT' ">
      <_RuntimeSources Include="clr\include\constants.hh" />
      <_RuntimeSources Include="clr\include\runtime-base\android-system.hh" />
      <_RuntimeSources Include="clr\include\runtime-base\app-bootstrap-properties.hh" />
      <_RuntimeSources Include="clr\runtime-base\app-bootstrap-properties.cc" />
      <_RuntimeSources Include="clr\runtime-base\android-system-shared.cc" />
      <_RuntimeSources Include="clr\runtime-base\logger.cc" />
      <_RuntimeSources Include="nativeaot\include\**\*.hh" />
      <_RuntimeSources Include="nativeaot\host\*.cc" />
    </ItemGroup>
  </Target>

  <Target Name="_BuildAndroidRuntimesInputs"
          DependsOnTargets="_FindRuntimeSources">
    <ItemGroup>
      <_BuildAndroidRuntimesInputs  Include="@(AndroidSupportedTargetJitAbi->'$(FlavorIntermediateOutputPath)\%(AndroidRID)-Debug\CMakeCache.txt')" />
      <_BuildAndroidRuntimesInputs  Include="@(AndroidSupportedTargetJitAbi->'$(FlavorIntermediateOutputPath)\%(AndroidRID)-Release\CMakeCache.txt')" />
      <_BuildAndroidRuntimesInputs  Include="@(_RuntimeSources)" />
      <_BuildAndroidRuntimesInputs  Include="..\..\build-tools\scripts\Ndk.targets" />
    </ItemGroup>

    <ItemGroup Condition=" '$(CMakeRuntimeFlavor)' == 'CoreCLR' ">
      <_BuildAndroidRuntimesOutputs Include="@(AndroidSupportedTargetJitAbi->'$(OutputPath)\%(AndroidRID)\libnet-android.debug.so')" />
      <_BuildAndroidRuntimesOutputs Include="@(AndroidSupportedTargetJitAbi->'$(OutputPath)\%(AndroidRID)\libnet-android.release.so')" />
    </ItemGroup>

    <ItemGroup Condition=" '$(CMakeRuntimeFlavor)' == 'NativeAOT' ">
      <_BuildAndroidRuntimesOutputs Include="@(AndroidSupportedTargetJitAbi->'$(OutputPath)\%(AndroidRID)\libnaot-android.release.so')" />
      <_BuildAndroidRuntimesOutputs Include="@(AndroidSupportedTargetJitAbi->'$(OutputPath)\%(AndroidRID)\libnaot-android.release-static-release.a')" />
    </ItemGroup>

  </Target>

  <Target Name="_BuildAndroidRuntimes"
          DependsOnTargets="_BuildAndroidRuntimesInputs"
          Inputs="@(_BuildAndroidRuntimesInputs)"
          Outputs="@(_BuildAndroidRuntimesOutputs)">
    <Exec
        Command="$(NinjaPath) -v"
        WorkingDirectory="$(FlavorIntermediateOutputPath)%(AndroidSupportedTargetJitAbi.AndroidRID)-Debug" />

    <Exec
        Command="$(NinjaPath) -v"
        WorkingDirectory="$(FlavorIntermediateOutputPath)%(AndroidSupportedTargetJitAbi.AndroidRID)-Release" />

    <Touch Files="@(_BuildAndroidRuntimesOutputs)" />
  </Target>

  <Target Name="_CleanRuntimes"
          AfterTargets="Clean">
    <Exec
        Command="$(NinjaPath) -v clean"
        WorkingDirectory="$(FlavorIntermediateOutputPath)%(AndroidSupportedTargetJitAbi.AndroidRID)-Debug"/>
    <Exec
        Command="$(NinjaPath) -v clean"
        WorkingDirectory="$(FlavorIntermediateOutputPath)%(AndroidSupportedTargetJitAbi.AndroidRID)-Release"/>

    <RemoveDir Directories="obj\local;libs" />
    <RemoveDir Directories="$(FlavorIntermediateOutputPath)%(AndroidSupportedTargetJitAbi.AndroidRID)-Debug" />
    <RemoveDir Directories="$(FlavorIntermediateOutputPath)%(AndroidSupportedTargetJitAbi.AndroidRID)-Release" />
    <Delete Files="jni\config.include;jni\machine.config.include;jni\Application.mk" />
    <Delete Files="%(_EmbeddedBlob.Include)" />
  </Target>

  <Target Name="CoreCompile"
          DependsOnTargets="Build">
  </Target>

  <Target Name="_CopyToPackDirsInputs">
    <ItemGroup Condition=" '$(CMakeRuntimeFlavor)' == 'CoreCLR' ">
      <_AndroidRuntimePackFile Include="@(AndroidSupportedTargetJitAbi->'$(OutputPath)\%(AndroidRID)\libnet-android.debug.so')" />
      <_AndroidRuntimePackFile Include="@(AndroidSupportedTargetJitAbi->'$(OutputPath)\%(AndroidRID)\libnet-android.release.so')" />
    </ItemGroup>

    <ItemGroup Condition=" '$(CMakeRuntimeFlavor)' == 'NativeAOT' ">
      <_AndroidRuntimePackFile Include="@(AndroidSupportedTargetJitAbi->'$(OutputPath)\%(AndroidRID)\libnaot-android.release-static-release.a')" />
    </ItemGroup>

    <ItemGroup>
      <_AndroidRuntimePackFile>
        <DestinationFile>$(MicrosoftAndroidPacksRootDir)Microsoft.Android.Runtime.$(CMakeRuntimeFlavor).$(AndroidApiLevel).%(_AndroidRuntimePackFile.AndroidRID)\$(AndroidPackVersion)\runtimes\%(_AndroidRuntimePackFile.AndroidRID)\native\%(_AndroidRuntimePackFile.Filename)%(_AndroidRuntimePackFile.Extension)</DestinationFile>
      </_AndroidRuntimePackFile>
      <_AndroidRuntimePackDirectory Include="@(AndroidSupportedTargetJitAbi->'$(MicrosoftAndroidPacksRootDir)Microsoft.Android.Runtime.$(CMakeRuntimeFlavor).$(AndroidApiLevel).%(AndroidRID)\$(AndroidPackVersion)\runtimes\%(AndroidRID)\native')" />
    </ItemGroup>
  </Target>

  <!-- Run even when the copied assets are up to date, without deleting unrelated pack files. -->
  <Target Name="_AndroidRemoveObsoleteRuntimePackFiles">
    <ItemGroup>
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\libarchive-dso-stub.so')" />
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\libc.so')" />
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\libdl.so')" />
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\liblog.so')" />
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\libm.so')" />
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\libz.so')" />
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\crtbegin_so.o')" />
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\crtend_so.o')" />
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\libclang_rt.builtins-%(ClangArch)-android.a')" />
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\libc++_static.a')" />
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\libc++abi.a')" />
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\libunwind.a')" />
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\libruntime-base-debug.a')" />
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\libruntime-base-release.a')" />
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\libruntime-base-common-debug.a')" />
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\libruntime-base-common-release.a')" />
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\libxa-java-interop-debug.a')" />
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\libxa-java-interop-release.a')" />
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\libxa-lz4-debug.a')" />
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\libxa-lz4-release.a')" />
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\libxa-shared-bits-debug.a')" />
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\libxa-shared-bits-release.a')" />
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\libxamarin-startup-debug.a')" />
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\libxamarin-startup-release.a')" />
    </ItemGroup>

    <ItemGroup Condition=" '$(CMakeRuntimeFlavor)' == 'CoreCLR' ">
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\libnet-android.debug-static-debug.a')" />
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\libnet-android.release-static-release.a')" />
    </ItemGroup>

    <ItemGroup Condition=" '$(CMakeRuntimeFlavor)' == 'NativeAOT' ">
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\libnaot-android.debug-static-debug.a')" />
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\libnaot-android.debug.so')" />
      <_AndroidObsoleteRuntimePackFile Include="@(_AndroidRuntimePackDirectory->'%(Identity)\libnaot-android.release.so')" />
    </ItemGroup>

    <Delete Files="@(_AndroidObsoleteRuntimePackFile)" />
  </Target>

  <Target Name="_CopyToPackDirs"
          DependsOnTargets="_CopyToPackDirsInputs;_AndroidRemoveObsoleteRuntimePackFiles"
          Inputs="@(_AndroidRuntimePackFile)"
          Outputs="@(_AndroidRuntimePackFile->'%(DestinationFile)')">
    <Copy
        SourceFiles="@(_AndroidRuntimePackFile)"
        DestinationFiles="@(_AndroidRuntimePackFile->'%(DestinationFile)')"
        SkipUnchangedFiles="true" />

    <ItemGroup>
      <FileWrites Include="@(_AndroidRuntimePackFile->'%(DestinationFile)')" />
    </ItemGroup>
  </Target>
</Project>
