set(XA_STARTUP_DIAGNOSTICS_BUILD_ID "" CACHE STRING "Producer receipt marker for opt-in startup metadata")
if(NOT XA_STARTUP_DIAGNOSTICS_BUILD_ID STREQUAL "")
  string(LENGTH "${XA_STARTUP_DIAGNOSTICS_BUILD_ID}" STARTUP_BUILD_ID_LENGTH)
  if(STARTUP_BUILD_ID_LENGTH GREATER 64 OR NOT XA_STARTUP_DIAGNOSTICS_BUILD_ID MATCHES "^[a-z0-9][a-z0-9._-]*$")
    message(FATAL_ERROR "XA_STARTUP_DIAGNOSTICS_BUILD_ID must match [a-z0-9][a-z0-9._-]{0,63}")
  endif()
endif()
