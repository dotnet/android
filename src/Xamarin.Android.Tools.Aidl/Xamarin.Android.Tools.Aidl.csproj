<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\Configuration.props" />
  <PropertyGroup>
    <!--
      CA1305 - Generated AIDL source preserves the established formatting behavior.
    -->
    <NoWarn>$(NoWarn);CA1305</NoWarn>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MicrosoftAndroidSdkOutDir)</OutputPath>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\product.snk</AssemblyOriginatorKeyFile>
    <LangVersion>preview</LangVersion>
    <MemorySafetyRulesVersion>2</MemorySafetyRulesVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="$(MonoCecilVersion)" />
    <PackageReference Include="Irony" />
    <PackageReference Include="System.CodeDom" />
  </ItemGroup>
</Project>
