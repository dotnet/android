<Project Sdk="Microsoft.Build.NoTargets">

  <Import Project="..\..\Configuration.props" />

  <PropertyGroup>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>11.0.0</Version>
    <LangVersion>13.0</LangVersion>
    <TargetFramework>$(DotNetStableTargetFramework)</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <OutputPath>$(MicrosoftAndroidSdkOutDir)</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <CompileJava Include="src\main\**\*.java" />
  </ItemGroup>

  <ItemGroup>
    <CompileTestJava Include="src\test\java\**\*.java" />
  </ItemGroup>

  <ItemGroup>
    <CompileTestJavaResources Include="src\test\resources\com\microsoft\**\*.java" />
  </ItemGroup>

  <Import Project="java-source-utils.targets" />

</Project>
