<!--
***********************************************************************************************
workloads.csproj

Restores the CoreCLR Android runtime packs used by the native build.

Run via:

  dotnet build src/workloads/workloads.csproj -c $(Configuration)

This replaces the runtime-pack restore that `Step_PrepareDotNetWorkloads`
previously performed inside xaprepare.
***********************************************************************************************
-->
<Project Sdk="Microsoft.Build.NoTargets">

  <PropertyGroup>
    <TargetFramework>$(DotNetStableTargetFramework)</TargetFramework>
    <DotNetRuntimePacksVersion Condition=" '$(DotNetRuntimePacksVersion)' == '' ">$(MicrosoftNETCoreAppRefPackageVersion)</DotNetRuntimePacksVersion>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\Configuration.props" />

  <ItemGroup>
    <!-- CoreCLR Android runtime packs -->
    <PackageDownload Include="Microsoft.NETCore.App.Runtime.android-arm"   Version="[$(DotNetRuntimePacksVersion)]" />
    <PackageDownload Include="Microsoft.NETCore.App.Runtime.android-arm64" Version="[$(DotNetRuntimePacksVersion)]" />
    <PackageDownload Include="Microsoft.NETCore.App.Runtime.android-x64"   Version="[$(DotNetRuntimePacksVersion)]" />
  </ItemGroup>

</Project>
