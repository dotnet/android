<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\Configuration.props" />

  <PropertyGroup>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>11.0.0</Version>
    <LangVersion>13.0</LangVersion>
    <TargetFramework>$(DotNetStableTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <MemorySafetyRulesVersion>2</MemorySafetyRulesVersion>
  </PropertyGroup>

  <PropertyGroup>
    <OutputPath>$(BuildOutputDirectory)$(DotNetStableTargetFramework)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Irony" Version="1.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xamarin.Android.Tools.ApiXmlAdjuster\Xamarin.Android.Tools.ApiXmlAdjuster.csproj" />
  </ItemGroup>

</Project>
