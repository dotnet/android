<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\..\..\Configuration.props" />

  <PropertyGroup>
    <TargetFramework>$(DotNetTargetFramework)</TargetFramework>
    <OutputPath>..\..\..\..\bin\Test$(Configuration)</OutputPath>
    <IsPackable>false</IsPackable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\..\..\product.snk</AssemblyOriginatorKeyFile>
    <Nullable>annotations</Nullable>
  </PropertyGroup>

  <Import Project="..\..\..\..\build-tools\scripts\NUnitReferences.projitems" />

  <ItemGroup>
    <Compile Include="..\..\..\Xamarin.Android.Build.Tasks\Tests\Xamarin.Android.Build.Tests\Utilities\MockBuildEngine.cs" Link="MockBuildEngine.cs" />
    <AssemblyMetadata Include="DotNetToolPath" Value="$(DotNetPreviewTool)" />
    <Content Include="..\..\..\Xamarin.Android.Build.Tasks\Xamarin.Android.Common.targets" Link="TargetInputs\Xamarin.Android.Common.targets" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\Xamarin.Android.Build.Tasks\Microsoft.Android.Sdk\targets\Microsoft.Android.Sdk.NativeAOT.targets" Link="TargetInputs\Microsoft.Android.Sdk.NativeAOT.targets" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Microsoft.Android.Build.Tasks.csproj" />
    <ProjectReference Include="..\..\..\Microsoft.Android.Sdk.TrimmableTypeMap\Microsoft.Android.Sdk.TrimmableTypeMap.csproj" />
  </ItemGroup>

</Project>
