<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <_Destination>$(MicrosoftAndroidSdkOutDir)</_Destination>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <_BundleToolDownloadLocation>$(AndroidToolchainCacheDirectory)\bundletool-all-$(XABundleToolVersion).jar</_BundleToolDownloadLocation>
  </PropertyGroup>

  <Import Project="..\..\build-tools\scripts\DownloadFileWithRetry.targets" />

  <Target Name="_DownloadBundleTool">
    <ItemGroup>
      <_DownloadFile Include="bundletool-all-$(XABundleToolVersion).jar">
        <AdditionalProperties>_DownloadUrl=https://github.com/google/bundletool/releases/download/$(XABundleToolVersion)/bundletool-all-$(XABundleToolVersion).jar;_DownloadFolder=$(AndroidToolchainCacheDirectory);_DownloadFileName=bundletool-all-$(XABundleToolVersion).jar;_DownloadSha256=$(XABundleToolHash)</AdditionalProperties>
      </_DownloadFile>
    </ItemGroup>
    <MSBuild Projects="@(_DownloadFile->'$(DownloadFileWithRetryFile)')"
        Targets="DownloadOneFileWithRetry"
        BuildInParallel="true" />
  </Target>

  <Target Name="_StripAndCopyBundleToolInputs" DependsOnTargets="_DownloadBundleTool">
    <PropertyGroup>
      <_AndroidBundleToolInputsFile>$(IntermediateOutputPath)bundletool.inputs</_AndroidBundleToolInputsFile>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile
        File="$(_AndroidBundleToolInputsFile)"
        Lines="BundleTool=$(_BundleToolDownloadLocation);SHA256=$(XABundleToolHash);JDK=$(JavaSdkDirectory);Gradle=$(GradleWPath);GradleArgs=$(GradleArgs)"
        Overwrite="true"
        WriteOnlyWhenDifferent="true"
    />
    <ItemGroup>
      <FileWrites Include="$(_AndroidBundleToolInputsFile)" />
    </ItemGroup>
  </Target>

  <Target Name="_StripAndCopyBundleTool"
      BeforeTargets="Build"
      DependsOnTargets="_StripAndCopyBundleToolInputs"
      Inputs="$(MSBuildThisFile);$(_AndroidBundleToolInputsFile);$(_BundleToolDownloadLocation);build.gradle;settings.gradle;proguard.pro;$(MSBuildThisFileDirectory)..\..\eng\gradle\dependency-repositories.gradle;$(MSBuildThisFileDirectory)..\..\eng\gradle\plugin-repositories.gradle;$(GradleHome)\gradle\wrapper\gradle-wrapper.properties;$(JavaSdkDirectory)\release"
      Outputs="$(_Destination)bundletool.jar">
    <Exec
        Command="&quot;$(GradleWPath)&quot; build $(GradleArgs) -PbundletoolJar=&quot;$(_BundleToolDownloadLocation)&quot;"
        EnvironmentVariables="JAVA_HOME=$(JavaSdkDirectory);APP_HOME=$(GradleHome)"
        WorkingDirectory="$(MSBuildThisFileDirectory)"
    />
    <Copy
        SourceFiles="$(MSBuildThisFileDirectory)build\libs\bundletool.jar"
        DestinationFiles="$(_Destination)bundletool.jar"
    />
    <Touch Files="$(_Destination)bundletool.jar" />
    <ItemGroup>
      <FileWrites Include="$(_Destination)bundletool.jar;$(MSBuildThisFileDirectory)build\libs\bundletool.jar;$(MSBuildThisFileDirectory)build\libs\bundletool-processed.jar;$(MSBuildThisFileDirectory)build\libs\bundletool-unshrunk.jar" />
    </ItemGroup>
  </Target>

  <Target Name="_CleanBundleTool" BeforeTargets="Clean">
    <Delete Files="$(_BundleToolDownloadLocation);$(_Destination)bundletool.jar" />
  </Target>

</Project>
