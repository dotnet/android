{
  "version": "@WORKLOAD_VERSION@",
  "workloads": {
    "android": {
      "description": ".NET SDK Workload for building Android applications.",
      "packs": [
        "Microsoft.Android",
        "@MICROSOFT_ANDROID_SDK_PACKAGE_ID@",
        @MICROSOFT_ANDROID_REF_PACKAGE_IDS@
        "Microsoft.Android.Tools.Darwin",
        "Microsoft.Android.Tools.Linux",
        "Microsoft.Android.Tools.Windows",
        "Microsoft.Android.Sdk.net11",
        "Microsoft.Android.Templates"
      ],
      "platforms": [ "win-x64", "win-arm64", "linux-x64", "linux-arm64", "osx-x64", "osx-arm64" ],
      "extends": [
        "microsoft-net-runtime-mono-tooling-net11",
        "microsoft-net-runtime-mono-tooling"
      ]
    }
  },
  "packs": {
    "Microsoft.Android": {
      "kind": "library",
      "version": "@WORKLOAD_VERSION@"
    },
    "@MICROSOFT_ANDROID_SDK_PACKAGE_ID@": {
      "kind": "library",
      "version": "@WORKLOAD_VERSION@"
    },
    @MICROSOFT_ANDROID_REF_PACKS@
    "Microsoft.Android.Tools.Darwin": {
      "kind": "library",
      "version": "@WORKLOAD_VERSION@"
    },
    "Microsoft.Android.Tools.Linux": {
      "kind": "library",
      "version": "@WORKLOAD_VERSION@"
    },
    "Microsoft.Android.Tools.Windows": {
      "kind": "library",
      "version": "@WORKLOAD_VERSION@"
    },
    "Microsoft.Android.Sdk.net11": {
      "kind": "sdk",
      "version": "@NET_PREVIOUS_VERSION@",
      "alias-to": {
        "osx-x64": "Microsoft.Android.Sdk.Darwin",
        "osx-arm64": "Microsoft.Android.Sdk.Darwin",
        "win-x86": "Microsoft.Android.Sdk.Windows",
        "win-x64": "Microsoft.Android.Sdk.Windows",
        "win-arm64": "Microsoft.Android.Sdk.Windows",
        "linux-x64": "Microsoft.Android.Sdk.Linux",
        "linux-arm64": "Microsoft.Android.Sdk.Linux"
      }
    },
    "Microsoft.Android.Templates": {
      "kind": "template",
      "version": "@WORKLOAD_VERSION@"
    }
  }
}
