<!--
***********************************************************************************************
Xamarin.Android.Javac.targets

This file contains the core MSBuild logic for .NET for Android Java Invocations.

It is shared between "legacy" binding projects and .NET 7+ projects.

***********************************************************************************************
-->

<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <UsingTask TaskName="Xamarin.Android.Tasks.AdjustJavacVersionArguments" AssemblyFile="Xamarin.Android.Build.Tasks.dll" />
  <UsingTask TaskName="Xamarin.Android.Tasks.DetermineJavaLibrariesToCompile" AssemblyFile="Xamarin.Android.Build.Tasks.dll" />
  <UsingTask TaskName="Microsoft.Android.Tasks.CreateJavaArchive" AssemblyFile="$(_MicrosoftAndroidBuildTasksAssembly)" Runtime="NET" TaskFactory="TaskHostFactory" Condition=" '$(MSBuildRuntimeType)' == 'Full' " />
  <UsingTask TaskName="Microsoft.Android.Tasks.CreateJavaArchive" AssemblyFile="$(_MicrosoftAndroidBuildTasksAssembly)" Runtime="NET" Condition=" '$(MSBuildRuntimeType)' == 'Core' " />

  <PropertyGroup>
    <_AndroidIntermediateBindingJavaClassDirectory>$(IntermediateOutputPath)binding\bin\classes\</_AndroidIntermediateBindingJavaClassDirectory>
    <_AndroidIntermediateBindingJavaSourceDirectory>$(IntermediateOutputPath)binding\src</_AndroidIntermediateBindingJavaSourceDirectory>
    <_AndroidIntermediateBindingClassesZip>$(IntermediateOutputPath)binding\bin\$(MSBuildProjectName).jar</_AndroidIntermediateBindingClassesZip>
    <_AndroidIntermediateBindingClassesDocs>$(IntermediateOutputPath)binding\bin\$(MSBuildProjectName)-docs.xml</_AndroidIntermediateBindingClassesDocs>
    <_AndroidCompileJavaStampFile>$(_AndroidStampDirectory)_CompileJava.stamp</_AndroidCompileJavaStampFile>
    <_AndroidCompileJavaFileList>$(IntermediateOutputPath)_CompileJava.FileList.txt</_AndroidCompileJavaFileList>
    <_AndroidCompileBindingJavaStampFile>$(_AndroidStampDirectory)_CompileBindingJava.stamp</_AndroidCompileBindingJavaStampFile>
    <_AndroidCompileBindingJavaFileList>$(IntermediateOutputPath)_CompileBindingJava.FileList.txt</_AndroidCompileBindingJavaFileList>
  </PropertyGroup>

  <Target Name="_AdjustJavacVersionArguments">
    <AdjustJavacVersionArguments
        Condition=" '$(JavacTargetVersion)' == '' or '$(JavacSourceVersion)' == '' "
        JdkVersion="$(_JdkVersion)"
        DefaultJdkVersion="$(_DefaultJdkVersion)"
        SkipJavacVersionCheck="$(AndroidSkipJavacVersionCheck)"
        EnableMultiDex="$(AndroidEnableMultiDex)">
      <Output TaskParameter="TargetVersion" PropertyName="JavacTargetVersion" />
      <Output TaskParameter="SourceVersion" PropertyName="JavacSourceVersion" />
    </AdjustJavacVersionArguments>
  </Target>

  <Target Name="_AndroidJavacCommand">
    <PropertyGroup>
      <_AndroidJavacShellQuote>'</_AndroidJavacShellQuote>
      <_AndroidJavacShellEscapeFrom>'</_AndroidJavacShellEscapeFrom>
      <_AndroidJavacShellEscapeTo>'\''</_AndroidJavacShellEscapeTo>
      <_AndroidJavacPathSeparator>:</_AndroidJavacPathSeparator>
      <_AndroidJavacShellQuote Condition=" $([MSBuild]::IsOSPlatform('Windows')) ">&quot;</_AndroidJavacShellQuote>
      <_AndroidJavacShellEscapeFrom Condition=" $([MSBuild]::IsOSPlatform('Windows')) ">%25</_AndroidJavacShellEscapeFrom>
      <_AndroidJavacShellEscapeTo Condition=" $([MSBuild]::IsOSPlatform('Windows')) ">%25%25</_AndroidJavacShellEscapeTo>
      <_AndroidJavacPathSeparator Condition=" $([MSBuild]::IsOSPlatform('Windows')) ">;</_AndroidJavacPathSeparator>
      <_AndroidJavacEscapedPathSeparator>$([MSBuild]::Escape('$(_AndroidJavacPathSeparator)'))</_AndroidJavacEscapedPathSeparator>
      <_AndroidJavacToolExe>$(JavacToolExe)</_AndroidJavacToolExe>
      <_AndroidJavacToolExe Condition=" '$(_AndroidJavacToolExe)' == '' ">javac</_AndroidJavacToolExe>
      <_AndroidJavacToolExe Condition=" '$(JavacToolExe)' == '' and $([MSBuild]::IsOSPlatform('windows')) ">javac.exe</_AndroidJavacToolExe>
      <_AndroidJavacToolPath>$([System.IO.Path]::Combine('$(JavacToolPath)', '$(_AndroidJavacToolExe)'))</_AndroidJavacToolPath>
      <_AndroidJavacToolPath>$([System.String]::Copy('$(_AndroidJavacToolPath)').Replace('$(_AndroidJavacShellEscapeFrom)', '$(_AndroidJavacShellEscapeTo)').Insert(0, '$(_AndroidJavacShellQuote)'))$(_AndroidJavacShellQuote)</_AndroidJavacToolPath>
      <_AndroidJavacVersionArguments>-target $(JavacTargetVersion) -source $(JavacSourceVersion) -Xlint:-options</_AndroidJavacVersionArguments>
      <_AndroidJavacVersionArguments
          Condition=" '$(_JdkVersion)' != '' and $([System.Version]::Parse('$(_JdkVersion)').Major) &gt;= 17 and
                      $([System.Text.RegularExpressions.Regex]::IsMatch('$(JavacSourceVersion)', '^\s*[+-]?[0-9]+\s*$')) and
                      $([System.Text.RegularExpressions.Regex]::IsMatch('$(JavacTargetVersion)', '^\s*[+-]?[0-9]+\s*$')) ">--release $([System.Math]::Max($([System.Convert]::ToInt32('$(JavacSourceVersion)')), $([System.Convert]::ToInt32('$(JavacTargetVersion)'))))</_AndroidJavacVersionArguments>
      <_AndroidJavacCommand>$(_AndroidJavacToolPath) -J-Dfile.encoding=UTF8 $(_AndroidJavacVersionArguments)</_AndroidJavacCommand>
    </PropertyGroup>
  </Target>

  <Target Name="_DetermineBindingJavaLibrariesToCompile"
      Condition=" '@(_JavaBindingSource->Count())' != '0' "
      DependsOnTargets="_CollectRuntimeJarFilenames">
    <DetermineJavaLibrariesToCompile
        MonoPlatformJarPaths="$(_RuntimeJar)"
        JavaSourceFiles="@(_JavaBindingSource)"
        JavaLibraries="@(AndroidJavaLibrary);@(EmbeddedJar)"
        ExternalJavaLibraries="@(AndroidExternalJavaLibrary)"
        LibraryProjectJars="@(ExtractedJarImports)"
        DoNotPackageJavaLibraries="@(_ResolvedDoNotPackageAttributes)">
      <Output TaskParameter="JavaLibrariesToCompile" ItemName="_BindingJavaLibrariesToCompile" />
      <Output TaskParameter="ReferenceJavaLibraries" ItemName="_ReferenceJavaLibs" />
    </DetermineJavaLibrariesToCompile>
  </Target>

  <Target Name="_DetermineJavaLibrariesToCompile"
      DependsOnTargets="_CollectRuntimeJarFilenames;_CategorizeAndroidLibraries;_CollectJavaSourceForBinding;_CompileBindingJava">

    <DetermineJavaLibrariesToCompile
        MonoPlatformJarPaths="$(_RuntimeJar)"
        JavaSourceFiles="@(AndroidJavaSource)"
        JavaLibraries="@(AndroidJavaLibrary)"
        ExternalJavaLibraries="@(AndroidExternalJavaLibrary)"
        LibraryProjectJars="@(ExtractedJarImports)"
        DoNotPackageJavaLibraries="@(_ResolvedDoNotPackageAttributes)">
      <Output TaskParameter="JavaLibrariesToCompile" ItemName="_JavaLibrariesToCompile" />
      <Output TaskParameter="ReferenceJavaLibraries" ItemName="_ReferenceJavaLibs" />
    </DetermineJavaLibrariesToCompile>

    <ItemGroup>
      <_JavaLibrariesToCompileForApp Include="@(_JavaLibrariesToCompile)" />
    </ItemGroup>
  </Target>

  <Target Name="_CollectJavaSourceForBinding">
    <ItemGroup>
      <_JavaBindingSource Include="@(AndroidJavaSource)" Condition=" '%(AndroidJavaSource.Bind)' == 'True' " />
    </ItemGroup>
    <WriteLinesToFile
        File="$(_AndroidCompileBindingJavaFileList)"
        Lines="@(_JavaBindingSource->ToLowerInvariant())"
        Overwrite="true"
        WriteOnlyWhenDifferent="true"
    />
    <ItemGroup>
      <FileWrites Include="$(_AndroidCompileBindingJavaFileList)" />
    </ItemGroup>
  </Target>

  <Target Name="_CollectJavaSource">
    <ItemGroup>
      <_JavaSource Include="@(AndroidJavaSource)" Condition=" '%(AndroidJavaSource.Bind)' != 'True' " />
    </ItemGroup>
   <WriteLinesToFile
        File="$(_AndroidCompileJavaFileList)"
        Lines="@(_JavaSource->ToLowerInvariant())"
        Overwrite="true"
        WriteOnlyWhenDifferent="true"
    />
    <ItemGroup>
      <FileWrites Include="$(_AndroidCompileJavaFileList)" />
    </ItemGroup>
  </Target>

  <Target Name="_CompileBindingJava"
      Condition=" '@(_JavaBindingSource->Count())' != '0' "
      DependsOnTargets="_CollectRuntimeJarFilenames;$(_CompileBindingJavaDependsOnTargets);_AndroidJavacCommand"
      Inputs="@(_AndroidMSBuildAllProjects);$(_AndroidCompileBindingJavaFileList);$(_RuntimeJar);@(_JavaBindingSource)"
      Outputs="$(_AndroidCompileBindingJavaStampFile)">

    <!-- Remove existing compiler outputs, since *.class files and classes.zip could contain old files. -->
    <RemoveDirFixed Directories="$(_AndroidIntermediateBindingJavaClassDirectory)" Condition="Exists('$(_AndroidIntermediateBindingJavaClassDirectory)')" />
    <Delete Files="$(_AndroidIntermediateBindingClassesZip)" Condition="Exists('$(_AndroidIntermediateBindingClassesZip)')" />
    <MakeDir Directories="$(_AndroidIntermediateBindingJavaClassDirectory)" />
    <PropertyGroup>
      <_AndroidBindingJavacResponseFile>$([MSBuild]::NormalizePath('$(IntermediateOutputPath)', '_CompileBindingJava.rsp'))</_AndroidBindingJavacResponseFile>
      <_AndroidBindingJavacResponseFileArgument>@_CompileBindingJava.rsp</_AndroidBindingJavacResponseFileArgument>
      <_AndroidBindingJavacResponseFileArgument>$([System.String]::Copy('$(_AndroidBindingJavacResponseFileArgument)').Replace('$(_AndroidJavacShellEscapeFrom)', '$(_AndroidJavacShellEscapeTo)').Insert(0, '$(_AndroidJavacShellQuote)'))$(_AndroidJavacShellQuote)</_AndroidBindingJavacResponseFileArgument>
    </PropertyGroup>
    <ItemGroup>
      <_AndroidBindingJavacClasspath Include="@(_BindingJavaLibrariesToCompile);@(_ReferenceJavaLibs);$(JavaPlatformJarPath)" />
      <_AndroidBindingJavacSource Include="@(_JavaBindingSource)" Condition=" '%(_JavaBindingSource.Extension)' == '.java' " />
      <_AndroidBindingJavacStub Include="$(_AndroidIntermediateBindingJavaSourceDirectory)\**\*.java" />
    </ItemGroup>
    <PropertyGroup>
      <_AndroidBindingJavacClasspathArgument>@(_AndroidBindingJavacClasspath->'%(FullPath)'->Replace('\', '\\'), '$(_AndroidJavacEscapedPathSeparator)')</_AndroidBindingJavacClasspathArgument>
    </PropertyGroup>
    <!-- javac response files interpret backslashes as escape characters. -->
    <WriteLinesToFile
        File="$(_AndroidBindingJavacResponseFile)"
        Lines="-d &quot;$([MSBuild]::NormalizeDirectory('$(_AndroidIntermediateBindingJavaClassDirectory)').Replace('\', '\\'))&quot;;
               -classpath &quot;$(_AndroidBindingJavacClasspathArgument)&quot;;
               -encoding UTF8;
               @(_AndroidBindingJavacSource->'&quot;%(FullPath)&quot;'->Replace('\', '\\'));
               @(_AndroidBindingJavacStub->'&quot;%(FullPath)&quot;'->Replace('\', '\\')->Normalize())"
        Overwrite="true" />
    <ItemGroup>
      <FileWrites Include="$(_AndroidBindingJavacResponseFile)" />
    </ItemGroup>
    <!-- The Windows javac launcher cannot preserve Unicode command-line arguments. Pass only the
         response-file name, with absolute paths inside it since javac runs from its directory. -->
    <Exec Command="$(_AndroidJavacCommand) $(_AndroidBindingJavacResponseFileArgument)"
        WorkingDirectory="$([MSBuild]::NormalizeDirectory('$(IntermediateOutputPath)'))"
        IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" ConsoleToMSBuild="true">
      <Output TaskParameter="ConsoleOutput" ItemName="_AndroidBindingJavacOutput" />
      <Output TaskParameter="ExitCode" PropertyName="_AndroidBindingJavacExitCode" />
    </Exec>
    <AndroidError Code="XA5213" ResourceName="XA5213"
        FormatArguments="$(_AndroidJavacToolExe);$(_AndroidJavacCommand) $(_AndroidBindingJavacResponseFileArgument)"
        Condition=" '$(_AndroidBindingJavacExitCode)' != '0' and $([System.String]::Copy('@(_AndroidBindingJavacOutput)').Contains('java.lang.OutOfMemoryError:')) " />
    <ItemGroup Condition=" '$(_AndroidBindingJavacExitCode)' != '0' ">
      <_AndroidBindingJavacError Include="@(_AndroidBindingJavacOutput)"
          Condition=" $([System.Text.RegularExpressions.Regex]::IsMatch('%(_AndroidBindingJavacOutput.Identity)', '^.+\.java:\d+:')) " />
    </ItemGroup>
    <Error Code="JAVAC0000"
        File="$([System.Text.RegularExpressions.Regex]::Replace('%(_AndroidBindingJavacError.Identity)', '^(.+\.java):(\d+):(.+)$', '$1'))"
        HelpKeyword="JAVAC0000"
        Text="$([System.Text.RegularExpressions.Regex]::Replace('%(_AndroidBindingJavacError.Identity)', '^.+\.java:(\d+):\s*(?:error:\s*)?', 'line $1: '))"
        Condition=" '@(_AndroidBindingJavacError->Count())' != '0' "
        ContinueOnError="ErrorAndContinue" />
    <Error Code="JAVAC0000" Text="javac exited with code $(_AndroidBindingJavacExitCode).%0A@(_AndroidBindingJavacOutput, '%0A')"
        Condition=" '$(_AndroidBindingJavacExitCode)' != '0' " />
    <CreateJavaArchive
        Condition=" '@(_JavaBindingSource->Count())' != '0' "
        SourceDirectory="$(_AndroidIntermediateBindingJavaClassDirectory)"
        OutputFile="$(_AndroidIntermediateBindingClassesZip)"
    />
    <JavaSourceUtils
        Condition=" '@(_JavaBindingSource->Count())' != '0' "
        JavaSourceUtilsJar="$(AndroidJavaSourceUtilsJar)"
        InputFiles="@(_JavaBindingSource)"
        JavadocCopyrightFile="%(_JavaBindingSource.CopyrightFile)"
        JavadocUrlPrefix="%(_JavaBindingSource.UrlPrefix)"
        JavadocUrlStyle="%(_JavaBindingSource.UrlStyle)"
        JavadocDocRootUrl="%(_JavaBindingSource.DocRootUrl)"
        JavaMaximumHeapSize="$(JavaMaximumHeapSize)"
        JavaOptions="$(JavaOptions)"
        JavaSdkDirectory="$(_JavaSdkDirectory)"
        OutputJavadocXml="$(_AndroidIntermediateBindingClassesDocs)"
        References="@(JavaSourceJar)"
    />
    <Touch Files="$(_AndroidCompileBindingJavaStampFile)" AlwaysCreate="true" />
    <ItemGroup>
      <EmbeddedJar Include="$(_AndroidIntermediateBindingClassesZip)" Condition="Exists('$(_AndroidIntermediateBindingClassesZip)')" />
      <AndroidJavaLibrary Include="$(_AndroidIntermediateBindingClassesZip)" Condition="Exists('$(_AndroidIntermediateBindingClassesZip)')" />
      <FileWrites Include="$(_AndroidIntermediateBindingClassesZip)" Condition="Exists('$(_AndroidIntermediateBindingClassesZip)')" />
      <FileWrites Include="$(_AndroidIntermediateBindingClassesDocs)" Condition=" Exists('$(_AndroidIntermediateBindingClassesDocs)') " />
    </ItemGroup>
  </Target>

  <Target Name="_CompileJava"
    DependsOnTargets="_CollectRuntimeJarFilenames;$(_CompileJavaDependsOnTargets);_CollectJavaSource;_AndroidJavacCommand"
    Inputs="@(_AndroidMSBuildAllProjects);$(_AndroidCompileJavaFileList);$(_RuntimeJar);@(_JavaStubFiles);@(_JavaSource)"
    Outputs="$(_AndroidCompileJavaStampFile)">

    <!-- Remove existing compiler outputs, since *.class files could contain old files. -->
    <RemoveDirFixed Directories="$(_AndroidIntermediateJavaClassDirectory)" />

    <MakeDir Directories="$(_AndroidIntermediateJavaClassDirectory)" />
    <PropertyGroup>
      <_AndroidJavacResponseFile>$([MSBuild]::NormalizePath('$(IntermediateOutputPath)', '_CompileJava.rsp'))</_AndroidJavacResponseFile>
      <_AndroidJavacResponseFileArgument>@_CompileJava.rsp</_AndroidJavacResponseFileArgument>
      <_AndroidJavacResponseFileArgument>$([System.String]::Copy('$(_AndroidJavacResponseFileArgument)').Replace('$(_AndroidJavacShellEscapeFrom)', '$(_AndroidJavacShellEscapeTo)').Insert(0, '$(_AndroidJavacShellQuote)'))$(_AndroidJavacShellQuote)</_AndroidJavacResponseFileArgument>
    </PropertyGroup>
    <ItemGroup>
      <_AndroidJavacClasspath Include="@(_JavaLibrariesToCompile);@(_ReferenceJavaLibs);$(JavaPlatformJarPath)" />
      <_AndroidJavacSource Include="@(_JavaSource)" Condition=" '%(_JavaSource.Extension)' == '.java' " />
      <_AndroidJavacStub Include="$(_AndroidIntermediateJavaSourceDirectory)\**\*.java" />
    </ItemGroup>
    <ItemGroup Condition=" '@(_AdditionalJavaStubDirectory->Count())' != '0' ">
      <_AndroidJavacStub Include="%(_AdditionalJavaStubDirectory.Identity)\**\*.java" />
    </ItemGroup>
    <PropertyGroup>
      <_AndroidJavacClasspathArgument>@(_AndroidJavacClasspath->'%(FullPath)'->Replace('\', '\\'), '$(_AndroidJavacEscapedPathSeparator)')</_AndroidJavacClasspathArgument>
    </PropertyGroup>
    <!-- javac response files interpret backslashes as escape characters. -->
    <WriteLinesToFile
        File="$(_AndroidJavacResponseFile)"
        Lines="-d &quot;$([MSBuild]::NormalizeDirectory('$(_AndroidIntermediateJavaClassDirectory)').Replace('\', '\\'))&quot;;
               -classpath &quot;$(_AndroidJavacClasspathArgument)&quot;;
               -encoding UTF8;
               @(_AndroidJavacSource->'&quot;%(FullPath)&quot;'->Replace('\', '\\'));
               @(_AndroidJavacStub->'&quot;%(FullPath)&quot;'->Replace('\', '\\')->Normalize())"
        Overwrite="true" />
    <ItemGroup>
      <FileWrites Include="$(_AndroidJavacResponseFile)" />
    </ItemGroup>
    <Exec Command="$(_AndroidJavacCommand) $(_AndroidJavacResponseFileArgument)"
        WorkingDirectory="$([MSBuild]::NormalizeDirectory('$(IntermediateOutputPath)'))"
        IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" ConsoleToMSBuild="true">
      <Output TaskParameter="ConsoleOutput" ItemName="_AndroidJavacOutput" />
      <Output TaskParameter="ExitCode" PropertyName="_AndroidJavacExitCode" />
    </Exec>
    <AndroidError Code="XA5213" ResourceName="XA5213"
        FormatArguments="$(_AndroidJavacToolExe);$(_AndroidJavacCommand) $(_AndroidJavacResponseFileArgument)"
        Condition=" '$(_AndroidJavacExitCode)' != '0' and $([System.String]::Copy('@(_AndroidJavacOutput)').Contains('java.lang.OutOfMemoryError:')) " />
    <ItemGroup Condition=" '$(_AndroidJavacExitCode)' != '0' ">
      <_AndroidJavacError Include="@(_AndroidJavacOutput)"
          Condition=" $([System.Text.RegularExpressions.Regex]::IsMatch('%(_AndroidJavacOutput.Identity)', '^.+\.java:\d+:')) " />
    </ItemGroup>
    <Error Code="JAVAC0000"
        File="$([System.Text.RegularExpressions.Regex]::Replace('%(_AndroidJavacError.Identity)', '^(.+\.java):(\d+):(.+)$', '$1'))"
        HelpKeyword="JAVAC0000"
        Text="$([System.Text.RegularExpressions.Regex]::Replace('%(_AndroidJavacError.Identity)', '^.+\.java:(\d+):\s*(?:error:\s*)?', 'line $1: '))"
        Condition=" '@(_AndroidJavacError->Count())' != '0' "
        ContinueOnError="ErrorAndContinue" />
    <Error Code="JAVAC0000" Text="javac exited with code $(_AndroidJavacExitCode).%0A@(_AndroidJavacOutput, '%0A')"
        Condition=" '$(_AndroidJavacExitCode)' != '0' " />

    <Touch Files="$(_AndroidCompileJavaStampFile)" AlwaysCreate="true" />
  </Target>
</Project>