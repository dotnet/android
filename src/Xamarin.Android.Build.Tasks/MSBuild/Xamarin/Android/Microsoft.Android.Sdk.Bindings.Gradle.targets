<!--
***********************************************************************************************
Microsoft.Android.Sdk.Bindings.Gradle.targets

This file contains MSBuild targets that support building and operating on Android Gradle projects.

***********************************************************************************************
-->

<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <_AGPOutDirAbs>$(IntermediateOutputPath)gradle/</_AGPOutDirAbs>
    <_AGPOutDirAbs Condition=" !$([System.IO.Path]::IsPathRooted('$(_AGPOutDirAbs)')) ">$(MSBuildProjectDirectory)/$(_AGPOutDirAbs)</_AGPOutDirAbs>
    <_AGPInitScriptTemplate>$(MSBuildThisFileDirectory)net.android.init.gradle.kts</_AGPInitScriptTemplate>
    <!-- Users can override _AGPInitScriptPath to point to their own init.gradle.kts file as an escape hatch -->
    <_AGPInitScriptPath Condition=" '$(_AGPInitScriptPath)' == '' ">$(_AGPOutDirAbs)net.android.init.gradle.kts</_AGPInitScriptPath>
    <_BuildAndroidGradleProjectsStamp>$(_AndroidStampDirectory)_BuildAndroidGradleProjects.stamp</_BuildAndroidGradleProjectsStamp>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <AndroidGradleProject>
      <Bind>true</Bind>
      <Configuration>Release</Configuration>
      <ModuleName></ModuleName>
      <OutputPath></OutputPath>
      <Pack>true</Pack>
      <CreateAndroidLibrary>true</CreateAndroidLibrary>
      <Visible></Visible>
    </AndroidGradleProject>
  </ItemDefinitionGroup>

  <Target Name="_GetBuildAndroidGradleProjectsInputs"
        Condition=" '@(AndroidGradleProject->Count())' != '0' ">
    <ItemGroup>
      <_AllGradleFiles Include="%(AndroidGradleProject.RootDir)%(AndroidGradleProject.Directory)/**/*"
          Condition= " Exists('%(AndroidGradleProject.RootDir)%(AndroidGradleProject.Directory)') "/>
      <_GradleInputs Include="@(_AllGradleFiles)"
          Condition="  '%(Extension)' == '.java'
                    or '%(Extension)' == '.kt'
                    or '%(Extension)' == '.kts'
                    or '%(Extension)' == '.gradle'
                    or '%(Extension)' == '.properties'
                    or '%(Extension)' == '.xml' " />
      <_GradleInputs Include="$(MSBuildProjectFullPath)" />
      <_GradleInputs Include="$(_AGPInitScriptTemplate)" />
      <_GradleInputs Include="@(_AndroidMSBuildAllProjects)" />
    </ItemGroup>
  </Target>

  <Target Name="_CalculateAndroidGradleProjectOutputPath"
        Condition=" '@(AndroidGradleProject->Count())' != '0' "
        Outputs="%(AndroidGradleProject.Identity)" >
    <Hash
        ItemsToHash="%(AndroidGradleProject.Identity)"
        IgnoreCase="true">
      <Output TaskParameter="HashResult" PropertyName="_AndroidGradleProjectHash" />
    </Hash>
    <ItemGroup>
      <AndroidGradleProject Condition=" '%(AndroidGradleProject.OutputPath)' == '' " >
        <OutputPath>$(_AGPOutDirAbs)%(ModuleName)%(Configuration)-$([System.String]::Copy($(_AndroidGradleProjectHash)).Substring(0, 5))</OutputPath>
      </AndroidGradleProject>
      <AndroidGradleProject>
        <OutputPath>$([MSBuild]::EnsureTrailingSlash('%(OutputPath)'))</OutputPath>
      </AndroidGradleProject>
    </ItemGroup>
  </Target>

  <Target Name="_AndroidPrepareGradleProjects"
      Condition=" '@(AndroidGradleProject->Count())' != '0' ">
    <!--
      Exec runs the command through /bin/sh on Unix and cmd.exe on Windows, so every argument is
      shell-quoted: single quotes (with ' escaped as '\'') on Unix, double quotes (with % escaped as %%)
      on Windows. The opening quote is added with Insert() so MSBuild does not treat the result as a
      Unix path and rewrite the backslash in '\'' to a slash.
    -->
    <PropertyGroup>
      <_AndroidGradleToolName>gradlew</_AndroidGradleToolName>
      <_AndroidGradleToolName Condition=" $([MSBuild]::IsOSPlatform('windows')) ">gradlew.bat</_AndroidGradleToolName>
      <_AndroidGradleShellQuote>'</_AndroidGradleShellQuote>
      <_AndroidGradleShellEscapeFrom>'</_AndroidGradleShellEscapeFrom>
      <_AndroidGradleShellEscapeTo>'\''</_AndroidGradleShellEscapeTo>
      <_AndroidGradleShellQuote Condition=" $([MSBuild]::IsOSPlatform('Windows')) ">&quot;</_AndroidGradleShellQuote>
      <_AndroidGradleShellEscapeFrom Condition=" $([MSBuild]::IsOSPlatform('Windows')) ">%25</_AndroidGradleShellEscapeFrom>
      <_AndroidGradleShellEscapeTo Condition=" $([MSBuild]::IsOSPlatform('Windows')) ">%25%25</_AndroidGradleShellEscapeTo>
      <_AndroidGradleQuotedInitScriptPath>$([System.String]::Copy('$(_AGPInitScriptPath)').Replace('$(_AndroidGradleShellEscapeFrom)', '$(_AndroidGradleShellEscapeTo)').Insert(0, '$(_AndroidGradleShellQuote)'))$(_AndroidGradleShellQuote)</_AndroidGradleQuotedInitScriptPath>
    </PropertyGroup>
    <!-- OutputPath has a trailing separator; the final dot prevents it from escaping the closing quote on Windows. -->
    <ItemGroup>
      <AndroidGradleProject>
        <_AndroidGradleWrapperPath>%(RootDir)%(Directory)$(_AndroidGradleToolName)</_AndroidGradleWrapperPath>
        <_AndroidGradleBuildDirOverride>-PnetAndroidBuildDirOverride=%(OutputPath).</_AndroidGradleBuildDirOverride>
        <_AndroidGradleModule Condition=" '%(ModuleName)' != '' ">%(ModuleName):</_AndroidGradleModule>
      </AndroidGradleProject>
      <AndroidGradleProject>
        <_AndroidGradleAssembleTask>%(AndroidGradleProject._AndroidGradleModule)assemble%(Configuration)</_AndroidGradleAssembleTask>
        <_AndroidGradleCleanTask>%(AndroidGradleProject._AndroidGradleModule)clean</_AndroidGradleCleanTask>
      </AndroidGradleProject>
      <AndroidGradleProject>
        <_AndroidGradleQuotedAssembleTask>$([System.String]::Copy('%(_AndroidGradleAssembleTask)').Replace('$(_AndroidGradleShellEscapeFrom)', '$(_AndroidGradleShellEscapeTo)').Insert(0, '$(_AndroidGradleShellQuote)'))$(_AndroidGradleShellQuote)</_AndroidGradleQuotedAssembleTask>
        <_AndroidGradleQuotedCleanTask>$([System.String]::Copy('%(_AndroidGradleCleanTask)').Replace('$(_AndroidGradleShellEscapeFrom)', '$(_AndroidGradleShellEscapeTo)').Insert(0, '$(_AndroidGradleShellQuote)'))$(_AndroidGradleShellQuote)</_AndroidGradleQuotedCleanTask>
        <_AndroidGradleWrapperCommand>$([System.String]::Copy('%(_AndroidGradleWrapperPath)').Replace('$(_AndroidGradleShellEscapeFrom)', '$(_AndroidGradleShellEscapeTo)').Insert(0, '$(_AndroidGradleShellQuote)'))$(_AndroidGradleShellQuote)</_AndroidGradleWrapperCommand>
        <_AndroidGradleInitScriptArguments>$([System.String]::Copy('%(_AndroidGradleBuildDirOverride)').Replace('$(_AndroidGradleShellEscapeFrom)', '$(_AndroidGradleShellEscapeTo)').Insert(0, '$(_AndroidGradleShellQuote)'))$(_AndroidGradleShellQuote) --init-script $(_AndroidGradleQuotedInitScriptPath)</_AndroidGradleInitScriptArguments>
      </AndroidGradleProject>
    </ItemGroup>
  </Target>

  <Target Name="_BuildAndroidGradleProjects"
      Condition=" '@(AndroidGradleProject->Count())' != '0' "
      DependsOnTargets="_SetupMSBuildAllProjects;AndroidPrepareForBuild;_GetBuildAndroidGradleProjectsInputs;_CalculateAndroidGradleProjectOutputPath;_AndroidPrepareGradleProjects"
      Inputs="@(_GradleInputs)"
      Outputs="$(_BuildAndroidGradleProjectsStamp)" >
    <!-- Delete outputs folder if inputs have changed to force a partial rebuild -->
    <RemoveDir Directories="@(AndroidGradleProject->'%(OutputPath)outputs')" />

    <!-- Create the net.android.init.gradle.kts script used to override the Gradle project output directory -->
    <!-- Skip the copy if user has overridden _AGPInitScriptPath to point to their own file -->
    <AndroidError Code="XA0116"
        ResourceName="XA0116"
        FormatArguments="$(_AGPInitScriptTemplate)"
        Condition=" $(_AGPInitScriptPath.StartsWith('$(_AGPOutDirAbs)')) And !Exists('$(_AGPInitScriptTemplate)') "
    />
    <CopyIfChanged
        Condition=" $(_AGPInitScriptPath.StartsWith('$(_AGPOutDirAbs)')) "
        SourceFiles="$(_AGPInitScriptTemplate)"
        DestinationFiles="$(_AGPInitScriptPath)"
        VerifyContent="true"
    />

    <!-- Run assemble task for project outputs, android app and library project outputs are currently supported -->
    <AndroidError
        Condition=" !Exists('%(AndroidGradleProject.RootDir)%(AndroidGradleProject.Directory)$(_AndroidGradleToolName)') "
        Code="XAGRDL1000"
        ResourceName="XAGRDL1000"
        FormatArguments="%(AndroidGradleProject.RootDir)%(AndroidGradleProject.Directory)"
    />
    <!--
      AndroidPrepareForBuild resolves the SDK/JDK, and CopyResource creates the init script; a preceding Clean
      may have run _AndroidPrepareGradleProjects before either, so both are checked here.
    -->
    <ItemGroup>
      <_AndroidGradleAssembleEnvironment Include="ANDROID_HOME=$(AndroidSdkDirectory)" Condition=" $([System.IO.Directory]::Exists('$(AndroidSdkDirectory)')) " />
      <_AndroidGradleAssembleEnvironment Include="JAVA_HOME=$(JavaSdkDirectory)" Condition=" $([System.IO.Directory]::Exists('$(JavaSdkDirectory)')) " />
      <AndroidGradleProject>
        <_AndroidGradleAssembleArguments Condition=" Exists('$(_AGPInitScriptPath)') ">%(AndroidGradleProject._AndroidGradleInitScriptArguments)</_AndroidGradleAssembleArguments>
      </AndroidGradleProject>
      <AndroidGradleProject>
        <_AndroidGradleAssembleCommand>%(AndroidGradleProject._AndroidGradleWrapperCommand) %(AndroidGradleProject._AndroidGradleQuotedAssembleTask) %(AndroidGradleProject._AndroidGradleAssembleArguments) --no-daemon</_AndroidGradleAssembleCommand>
      </AndroidGradleProject>
    </ItemGroup>
    <Exec
        Command="%(AndroidGradleProject._AndroidGradleAssembleCommand)"
        WorkingDirectory="%(AndroidGradleProject.RootDir)%(AndroidGradleProject.Directory)"
        EnvironmentVariables="@(_AndroidGradleAssembleEnvironment)"
        StandardOutputImportance="Low"
    />

    <ItemGroup>
      <_AndroidGradleProjectAppOutputs      Include="%(AndroidGradleProject.OutputPath)outputs/**/*.apk" />
      <_AndroidGradleProjectLibraryOutputs  Include="%(AndroidGradleProject.OutputPath)outputs/**/*.aar"
          Condition=" '%(CreateAndroidLibrary)' == 'true' "
          Bind="%(AndroidGradleProject.Bind)"
          Pack="%(AndroidGradleProject.Pack)"
          Visible="%(AndroidGradleProject.Visible)" />
    </ItemGroup>

    <AndroidMessage ResourceName="XAGRDLRefLibraryOutputs"
        FormatArguments="%(_AndroidGradleProjectLibraryOutputs.Identity)"
        Condition=" '@(_AndroidGradleProjectLibraryOutputs->Count())' != '0' "
    />

    <Touch Files="$(_BuildAndroidGradleProjectsStamp)" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(_BuildAndroidGradleProjectsStamp);%(AndroidGradleProject.OutputPath)**/*" />
      <!-- Add app output files @(None) to be copied to $(OutputPath) -->
      <None Include="@(_AndroidGradleProjectAppOutputs)" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
      <!-- Automatically add library outputs to be bound or otherwise processed later in the build -->
      <AndroidLibrary Include="@(_AndroidGradleProjectLibraryOutputs)" Bind="%(Bind)" Pack="%(Pack)" Visible="%(Visible)" />
    </ItemGroup>
  </Target>

  <Target Name="_CleanAndroidGradleProjects"
      Condition=" '@(AndroidGradleProject->Count())' != '0' "
      DependsOnTargets="_CalculateAndroidGradleProjectOutputPath;_AndroidPrepareGradleProjects" >
    <AndroidError
        Condition=" !Exists('%(AndroidGradleProject.RootDir)%(AndroidGradleProject.Directory)$(_AndroidGradleToolName)') "
        Code="XAGRDL1000"
        ResourceName="XAGRDL1000"
        FormatArguments="%(AndroidGradleProject.RootDir)%(AndroidGradleProject.Directory)"
    />
    <ItemGroup>
      <_AndroidGradleCleanEnvironment Include="ANDROID_HOME=$(AndroidSdkDirectory)" Condition=" $([System.IO.Directory]::Exists('$(AndroidSdkDirectory)')) " />
      <_AndroidGradleCleanEnvironment Include="JAVA_HOME=$(JavaSdkDirectory)" Condition=" $([System.IO.Directory]::Exists('$(JavaSdkDirectory)')) " />
      <AndroidGradleProject>
        <_AndroidGradleCleanArguments Condition=" Exists('$(_AGPInitScriptPath)') ">%(AndroidGradleProject._AndroidGradleInitScriptArguments)</_AndroidGradleCleanArguments>
      </AndroidGradleProject>
      <AndroidGradleProject>
        <_AndroidGradleCleanCommand>%(AndroidGradleProject._AndroidGradleWrapperCommand) %(AndroidGradleProject._AndroidGradleQuotedCleanTask) %(AndroidGradleProject._AndroidGradleCleanArguments) --no-daemon</_AndroidGradleCleanCommand>
      </AndroidGradleProject>
    </ItemGroup>
    <Exec
        Command="%(AndroidGradleProject._AndroidGradleCleanCommand)"
        WorkingDirectory="%(AndroidGradleProject.RootDir)%(AndroidGradleProject.Directory)"
        EnvironmentVariables="@(_AndroidGradleCleanEnvironment)"
        StandardOutputImportance="Low"
    />
  </Target>

</Project>
