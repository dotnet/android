<!-- Retained typemap keys supply managed-peer class roots on the shrinking CoreCLR/NativeAOT path. -->
<Project>
  <UsingTask TaskName="Microsoft.Android.Tasks.ExtractTypeMapKeysFromNativeAotObject" AssemblyFile="$(_MicrosoftAndroidBuildTasksAssembly)" />
  <UsingTask TaskName="Microsoft.Android.Tasks.ExtractTypeMapKeysFromLlvmIr" AssemblyFile="$(_MicrosoftAndroidBuildTasksAssembly)" />
  <UsingTask TaskName="Microsoft.Android.Tasks.ExtractTypeMapKeysFromAssemblies" AssemblyFile="$(_MicrosoftAndroidBuildTasksAssembly)" />
  <UsingTask TaskName="Microsoft.Android.Tasks.GenerateTypeMapProguardConfiguration" AssemblyFile="$(_MicrosoftAndroidBuildTasksAssembly)" />
  <UsingTask TaskName="Microsoft.Android.Tasks.GenerateTypeMapMemberProguardConfiguration" AssemblyFile="$(_MicrosoftAndroidBuildTasksAssembly)" />

  <PropertyGroup>
    <_CompileToDalvikDependsOnTargets>$(_CompileToDalvikDependsOnTargets);_AndroidGenerateTypeMapProguardConfiguration</_CompileToDalvikDependsOnTargets>
  </PropertyGroup>

  <!-- NativeAOT is opt-in until llvm-readobj ships with the workload: the default workload
       linker must remain usable without an NDK. CoreCLR adapters need no native tools. -->
  <Target Name="_AndroidConfigureTypeMapProguard"
      BeforeTargets="_CalculateProguardConfigurationFiles"
      Condition=" '$(_AndroidEnableTypemapR8Trimming)' != 'false' and '$(PublishTrimmed)' == 'true' and '$(AndroidLinkTool)' == 'r8' and '$(_ComputeFilesToPublishForRuntimeIdentifiers)' != 'true' and ('$(_AndroidRuntime)' == 'CoreCLR' or ('$(_AndroidRuntime)' == 'NativeAOT' and '$(AndroidTypeMapImplementation)' == 'trimmable' and '$(_AndroidEnableTypemapR8Trimming)' == 'true')) ">
    <PropertyGroup>
      <_ProguardProjectConfiguration>$(IntermediateOutputPath)proguard\proguard_project_references.cfg</_ProguardProjectConfiguration>
      <_AndroidTypeMapProguardConfiguration>$(_ProguardProjectConfiguration)</_AndroidTypeMapProguardConfiguration>
      <!-- ProguardConfigFiles is the existing complete configuration override. -->
      <_AndroidUseTypeMapProguardConfiguration Condition=" '$(ProguardConfigFiles)' == '' ">true</_AndroidUseTypeMapProguardConfiguration>
      <_AndroidUseScopedTypeMapMembers Condition=" '$(_AndroidRuntime)' == 'CoreCLR' and '$(_AndroidUseTypeMapProguardConfiguration)' == 'true' ">true</_AndroidUseScopedTypeMapMembers>
    </PropertyGroup>
  </Target>

  <Target Name="_AndroidGenerateLegacyNativeAotProguardConfigurationInputs"
      DependsOnTargets="_GenerateJavaStubs">
    <PropertyGroup>
      <_ProguardProjectConfiguration>$(IntermediateOutputPath)proguard\proguard_project_references.cfg</_ProguardProjectConfiguration>
      <_AndroidTypeMapProguardConfiguration>$(_ProguardProjectConfiguration)</_AndroidTypeMapProguardConfiguration>
    </PropertyGroup>
  </Target>

  <!-- With the pipeline disabled, R8's legacy primary configuration keeps every ACW class
       and its members. No typemap-derived reference rules or modern tasks are needed. -->
  <Target Name="_AndroidGenerateLegacyNativeAotProguardConfiguration"
      BeforeTargets="_CalculateProguardConfigurationFiles"
      DependsOnTargets="_AndroidGenerateLegacyNativeAotProguardConfigurationInputs"
      Condition=" '$(_AndroidEnableTypemapR8Trimming)' != 'true' and '$(_AndroidRuntime)' == 'NativeAOT' and '$(AndroidTypeMapImplementation)' == 'trimmable' and '$(PublishTrimmed)' == 'true' and '$(AndroidLinkTool)' == 'r8' and '$(_ComputeFilesToPublishForRuntimeIdentifiers)' != 'true' "
      Inputs="$(_AcwMapFile);$(_AndroidBuildPropertiesCache)"
      Outputs="$(_ProguardProjectConfiguration)">
    <MakeDir Directories="$(IntermediateOutputPath)proguard" />
    <WriteLinesToFile File="$(_ProguardProjectConfiguration)"
        Lines="# Class roots are supplied by the legacy ACW configuration."
        Overwrite="true" />
    <ItemGroup>
      <FileWrites Include="$(_ProguardProjectConfiguration)" />
    </ItemGroup>
  </Target>

  <Target Name="_AndroidExtractTypeMapKeysInputs"
      DependsOnTargets="_GenerateJavaStubs;_AndroidConfigureTypeMapProguard">
    <PropertyGroup>
      <_AndroidTypeMapKeysFile>$(IntermediateOutputPath)typemap.keys.txt</_AndroidTypeMapKeysFile>
      <_AndroidTypeMapKeysInputsFile>$(IntermediateOutputPath)typemap.keys.inputs</_AndroidTypeMapKeysInputsFile>
      <_AndroidTypeMapTasksAssemblyFile>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '$(_MicrosoftAndroidBuildTasksAssembly)'))</_AndroidTypeMapTasksAssemblyFile>
      <_AndroidTypeMapKeysKind Condition=" '$(_AndroidRuntime)' == 'NativeAOT' ">native-object</_AndroidTypeMapKeysKind>
      <_AndroidTypeMapKeysKind Condition=" '$(_AndroidRuntime)' == 'CoreCLR' and '$(AndroidTypeMapImplementation)' != 'trimmable' ">llvm-ir</_AndroidTypeMapKeysKind>
      <_AndroidTypeMapKeysKind Condition=" '$(_AndroidRuntime)' == 'CoreCLR' and '$(AndroidTypeMapImplementation)' == 'trimmable' ">assemblies</_AndroidTypeMapKeysKind>
      <_AndroidTypeMapLinkedAssemblies>@(ResolvedFileToPublish->'%(AndroidTypeMapLinkedAssemblies)'->Distinct())</_AndroidTypeMapLinkedAssemblies>
      <_AndroidTypeMapLlvmReadObjPath />
      <_AndroidTypeMapLlvmReadObjPath Condition=" '$(_AndroidTypeMapKeysKind)' == 'native-object' ">@(ResolvedFileToPublish->'%(AndroidTypeMapLlvmReadObjPath)'->Distinct())</_AndroidTypeMapLlvmReadObjPath>
      <_AndroidTypeMapLlvmObjDumpPath />
      <_AndroidTypeMapLlvmObjDumpPath Condition=" '$(_AndroidTypeMapKeysKind)' == 'native-object' ">@(ResolvedFileToPublish->'%(AndroidTypeMapLlvmObjDumpPath)'->Distinct())</_AndroidTypeMapLlvmObjDumpPath>
    </PropertyGroup>
    <ItemGroup>
      <_AndroidTypeMapKeySource Remove="@(_AndroidTypeMapKeySource)" />
      <!-- Inner builds return exact producer paths, not globbed candidates from old RIDs/modes.
           Keep missing files in the list so extraction fails instead of silently losing a RID. -->
      <_AndroidTypeMapKeySource Include="@(ResolvedFileToPublish->'%(AndroidTypeMapNativeObject)'->Distinct())"
          Condition=" '$(_AndroidTypeMapKeysKind)' == 'native-object' " />
      <_AndroidTypeMapKeySource Include="@(_TypeMapAssemblySource->Distinct())"
          Condition=" '$(_AndroidTypeMapKeysKind)' == 'llvm-ir' " />
      <_AndroidTypeMapKeySource Include="$(_AndroidTypeMapLinkedAssemblies)"
          Condition=" '$(_AndroidTypeMapKeysKind)' == 'assemblies' " />
      <_AndroidTypeMapKeysState Remove="@(_AndroidTypeMapKeysState)" />
      <_AndroidTypeMapKeysState Include="Runtime=$(_AndroidRuntime);Representation=$(_AndroidTypeMapKeysKind);Optimize=$(Optimize);RuntimeIdentifier=$(RuntimeIdentifier);RuntimeIdentifiers=$(RuntimeIdentifiers);TypemapPolicy=$(_AndroidUseTypeMapProguardConfiguration);Enabled=$(_AndroidEnableTypemapR8Trimming);ReadObj=$(_AndroidTypeMapLlvmReadObjPath);ObjDump=$(_AndroidTypeMapLlvmObjDumpPath)" />
      <_AndroidTypeMapKeysState Include="@(_AndroidTypeMapKeySource->'%(FullPath)')" />
    </ItemGroup>
    <!-- Unlike the generated outputs, this input manifest must preserve its timestamp when
         unchanged. File timestamps alone cannot detect a removed source or a property switch. -->
    <WriteLinesToFile File="$(_AndroidTypeMapKeysInputsFile)" Lines="@(_AndroidTypeMapKeysState)"
        Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(_AndroidTypeMapKeysInputsFile)" />
    </ItemGroup>
  </Target>

  <Target Name="_AndroidExtractTypeMapKeys"
      DependsOnTargets="_AndroidExtractTypeMapKeysInputs"
      Inputs="@(_AndroidTypeMapKeySource);$(_AndroidTypeMapLlvmReadObjPath);$(_AndroidTypeMapLlvmObjDumpPath);$(_AndroidTypeMapKeysInputsFile);$(_AndroidTypeMapTasksAssemblyFile)"
      Outputs="$(_AndroidTypeMapKeysFile)">
    <ExtractTypeMapKeysFromNativeAotObject
        Condition=" '$(_AndroidTypeMapKeysKind)' == 'native-object' "
        NativeObjectFiles="@(_AndroidTypeMapKeySource)"
        LlvmReadObjPath="$(_AndroidTypeMapLlvmReadObjPath)"
        OutputFile="$(_AndroidTypeMapKeysFile)" />
    <ExtractTypeMapKeysFromLlvmIr
        Condition=" '$(_AndroidTypeMapKeysKind)' == 'llvm-ir' "
        LlvmIrFiles="@(_AndroidTypeMapKeySource)"
        OutputFile="$(_AndroidTypeMapKeysFile)" />
    <ExtractTypeMapKeysFromAssemblies
        Condition=" '$(_AndroidTypeMapKeysKind)' == 'assemblies' "
        LinkedAssemblies="@(_AndroidTypeMapKeySource)"
        OutputFile="$(_AndroidTypeMapKeysFile)" />
    <ItemGroup>
      <FileWrites Include="$(_AndroidTypeMapKeysFile)" />
    </ItemGroup>
  </Target>

  <Target Name="_AndroidGenerateTypeMapProguardConfigurationInputs"
      DependsOnTargets="_AndroidExtractTypeMapKeys">
    <ItemGroup>
      <_AndroidTypeMapKeyFile Remove="@(_AndroidTypeMapKeyFile)" />
      <_AndroidTypeMapKeyFile Include="$(_AndroidTypeMapKeysFile)" />
    </ItemGroup>
  </Target>

  <Target Name="_AndroidGenerateTypeMapProguardConfiguration"
      DependsOnTargets="_AndroidGenerateTypeMapProguardConfigurationInputs"
      Condition=" '$(_AndroidEnableTypemapR8Trimming)' != 'false' and '$(PublishTrimmed)' == 'true' and '$(AndroidLinkTool)' == 'r8' and '$(_ComputeFilesToPublishForRuntimeIdentifiers)' != 'true' and ('$(_AndroidRuntime)' == 'CoreCLR' or ('$(_AndroidRuntime)' == 'NativeAOT' and '$(AndroidTypeMapImplementation)' == 'trimmable' and '$(_AndroidEnableTypemapR8Trimming)' == 'true')) "
      Inputs="@(_AndroidTypeMapKeyFile);$(_AndroidTypeMapTasksAssemblyFile);$(_AndroidBuildPropertiesCache)"
      Outputs="$(_ProguardProjectConfiguration)">
    <GenerateTypeMapProguardConfiguration
        TypeMapKeyFiles="@(_AndroidTypeMapKeyFile)"
        OutputFile="$(_ProguardProjectConfiguration)" />
    <ItemGroup>
      <FileWrites Include="$(_ProguardProjectConfiguration)" />
    </ItemGroup>
  </Target>

  <Target Name="_AndroidGenerateTypeMapMemberProguardConfigurationInputs"
      DependsOnTargets="_AndroidGenerateTypeMapProguardConfigurationInputs">
    <PropertyGroup>
      <_AndroidTypeMapMemberProguardConfiguration>$(IntermediateOutputPath)proguard\proguard_typemap_members.cfg</_AndroidTypeMapMemberProguardConfiguration>
    </PropertyGroup>
  </Target>

  <Target Name="_AndroidGenerateTypeMapMemberProguardConfiguration"
      AfterTargets="_AndroidGenerateTypeMapProguardConfiguration"
      DependsOnTargets="_AndroidGenerateTypeMapMemberProguardConfigurationInputs"
      Condition=" '$(_AndroidUseScopedTypeMapMembers)' == 'true' "
      Inputs="@(_AndroidTypeMapKeyFile);$(_AndroidTypeMapTasksAssemblyFile);$(_AndroidBuildPropertiesCache)"
      Outputs="$(_AndroidTypeMapMemberProguardConfiguration)">
    <GenerateTypeMapMemberProguardConfiguration
        TypeMapKeyFiles="@(_AndroidTypeMapKeyFile)"
        OutputFile="$(_AndroidTypeMapMemberProguardConfiguration)" />
    <ItemGroup>
      <_ProguardConfiguration Include="$(_AndroidTypeMapMemberProguardConfiguration)" />
      <FileWrites Include="$(_AndroidTypeMapMemberProguardConfiguration)" />
    </ItemGroup>
  </Target>
</Project>
