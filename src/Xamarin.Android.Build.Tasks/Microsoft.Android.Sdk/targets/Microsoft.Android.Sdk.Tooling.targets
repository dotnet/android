<!--
***********************************************************************************************
Microsoft.Android.Sdk.Tooling.targets

This file contains .NET 6+ Java version validation and calls to the
<ResolveAndroidTooling/> MSBuild task.

***********************************************************************************************
-->

<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <UsingTask TaskName="Xamarin.Android.Tasks.ResolveAndroidTooling"      AssemblyFile="$(_XamarinAndroidBuildTasksAssembly)" />
  <UsingTask TaskName="Xamarin.Android.Tasks.RuntimeIdentifierToAbi"     AssemblyFile="$(_XamarinAndroidBuildTasksAssembly)" />

  <Target Name="_ComputeAndroidToolingInputs">
    <ItemGroup>
      <_AndroidToolingInput Include="AndroidApiLevel" />
      <_AndroidToolingInput Include="AndroidApplication" />
      <_AndroidToolingInput Include="AndroidSdkBuildToolsVersion" />
      <_AndroidToolingInput Include="AndroidCommandLineToolsVersion" />
      <_AndroidToolingInput Include="AndroidSdkBuildToolsPath" />
      <_AndroidToolingInput Include="AndroidSdkBuildToolsBinPath" />
      <_AndroidToolingInput Include="Aapt2ToolPath" />
      <_AndroidToolingInput Include="ZipAlignToolPath" />
      <_AndroidToolingInput Include="LintToolPath" />
      <_AndroidToolingInput Include="ApkSignerJar" />
      <_AndroidToolingInput Include="AndroidUseApkSigner" />
      <_AndroidToolingInput Include="JavaToolExe" />
      <_AndroidToolingInput Include="MinimumSupportedJavaVersion" />
      <_AndroidToolingInput Include="LatestSupportedJavaVersion" />
      <_AndroidToolingInput Update="@(_AndroidToolingInput)">
        <PropertyName Condition=" '%(_AndroidToolingInput.PropertyName)' == '' ">%(_AndroidToolingInput.Identity)</PropertyName>
      </_AndroidToolingInput>
      <_AndroidToolingInput Update="@(_AndroidToolingInput)">
        <EscapedValue>$([MSBuild]::Escape('$(%(_AndroidToolingInput.PropertyName))'))</EscapedValue>
        <EscapedOuterValue>$([MSBuild]::Escape('$(_AndroidOuterToolingInput%(_AndroidToolingInput.Identity))'))</EscapedOuterValue>
      </_AndroidToolingInput>
    </ItemGroup>
    <ItemGroup Condition=" '$(_AndroidUseResolvedSdk)' == 'true' ">
      <_AndroidChangedToolingInput Include="@(_AndroidToolingInput)"
          Condition=" !$([System.String]::Copy('%(_AndroidToolingInput.EscapedValue)').Equals('%(_AndroidToolingInput.EscapedOuterValue)')) " />
    </ItemGroup>
    <PropertyGroup>
      <_AndroidUseResolvedTooling Condition=" '$(_AndroidUseResolvedSdk)' == 'true' and '@(_AndroidChangedToolingInput->Count())' == '0' and '$(_AndroidOuterJdkVersion)' != '' and '$(_AndroidOuterDefaultJdkVersion)' != '' and '$(_AndroidOuterAapt2Version)' != '' ">true</_AndroidUseResolvedTooling>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(_AndroidUseResolvedTooling)' == 'true' ">
      <_JdkVersion>$(_AndroidOuterJdkVersion)</_JdkVersion>
      <_DefaultJdkVersion>$(_AndroidOuterDefaultJdkVersion)</_DefaultJdkVersion>
      <_AndroidApiLevel Condition=" '$(_AndroidApiLevel)' == '' ">$(_AndroidOuterApiLevel)</_AndroidApiLevel>
      <_AndroidApiLevelName>$(_AndroidOuterApiLevelName)</_AndroidApiLevelName>
      <AndroidSdkBuildToolsPath Condition=" '$(AndroidSdkBuildToolsPath)' == '' ">$(_AndroidOuterBuildToolsPath)</AndroidSdkBuildToolsPath>
      <AndroidSdkBuildToolsBinPath Condition=" '$(AndroidSdkBuildToolsBinPath)' == '' ">$(_AndroidOuterBuildToolsBinPath)</AndroidSdkBuildToolsBinPath>
      <ZipAlignToolPath Condition=" '$(ZipAlignToolPath)' == '' ">$(_AndroidOuterZipAlignToolPath)</ZipAlignToolPath>
      <LintToolPath Condition=" '$(LintToolPath)' == '' ">$(_AndroidOuterLintToolPath)</LintToolPath>
      <ApkSignerJar Condition=" '$(ApkSignerJar)' == '' ">$(_AndroidOuterApkSignerJar)</ApkSignerJar>
      <AndroidUseApkSigner Condition=" '$(AndroidUseApkSigner)' == '' ">$(_AndroidOuterUseApkSigner)</AndroidUseApkSigner>
      <_Aapt2Version>$(_AndroidOuterAapt2Version)</_Aapt2Version>
      <Aapt2ToolPath Condition=" '$(Aapt2ToolPath)' == '' ">$(_AndroidOuterAapt2ToolPath)</Aapt2ToolPath>
    </PropertyGroup>
  </Target>

  <!--
    Validates the JDK against $(MinimumSupportedJavaVersion) and $(LatestSupportedJavaVersion).
    The version comes from $(_JavaSdkDirectory)release, falling back to `java -version`.
  -->
  <Target Name="_ValidateJavaVersion"
      Condition=" '$(_AndroidUseResolvedTooling)' != 'true' and '$(DesignTimeBuild)' != 'true' ">
    <PropertyGroup>
      <_DefaultJdkVersion>$([System.Version]::Parse('$(MinimumSupportedJavaVersion)'))</_DefaultJdkVersion>
      <_JdkVersion />
      <_JdkVersion Condition=" '$(_JavaSdkDirectory)' != '' and Exists('$(_JavaSdkDirectory)/release') ">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText($([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(_JavaSdkDirectory)', 'release')))), '(?m)(?&lt;=^JAVA_VERSION=")\d+(\.\d+){0,3}'))</_JdkVersion>
    </PropertyGroup>
    <AndroidError
        Condition=" '$(_JavaSdkDirectory)' == '' "
        ContinueOnError="$(_AndroidAllowMissingSdkTooling)"
        Code="XA5300"
        ResourceName="XA5300_Java_SDK"
    />
    <!-- `java -version` prints e.g. `openjdk version "21.0.8" 2025-07-15` -->
    <Exec
        Condition=" '$(_JavaSdkDirectory)' != '' and '$(_JdkVersion)' == '' "
        ContinueOnError="$(_AndroidAllowMissingSdkTooling)"
        Command="&quot;$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(_JavaSdkDirectory)', 'bin', '$([MSBuild]::ValueOrDefault('$(JavaToolExe)', 'java'))'))&quot; -version"
        ConsoleToMSBuild="true"
        EchoOff="true"
        IgnoreExitCode="true"
        IgnoreStandardErrorWarningFormat="true"
        StandardOutputImportance="Low"
        StandardErrorImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_AndroidJavaVersionOutput" />
    </Exec>
    <PropertyGroup Condition=" '$(_JavaSdkDirectory)' != '' and '$(_JdkVersion)' == '' ">
      <_JdkVersion>$([System.Text.RegularExpressions.Regex]::Match('$(_AndroidJavaVersionOutput)', '(?&lt;=version ")\d+(\.\d+){0,3}'))</_JdkVersion>
    </PropertyGroup>
    <AndroidWarning
        Condition=" '$(_JavaSdkDirectory)' != '' and '$(_JdkVersion)' == '' "
        Code="XA0033"
        ResourceName="XA0033"
        FormatArguments="$([MSBuild]::ValueOrDefault('$(JavaToolExe)', 'java'));$([MSBuild]::Escape('$(_AndroidJavaVersionOutput)'))"
    />
    <Message Condition=" '$(_JdkVersion)' != '' " Text="Found Java SDK version $(_JdkVersion)." />
    <AndroidError
        Condition=" '$(_JdkVersion)' != '' and $([MSBuild]::VersionLessThan('$(_JdkVersion)', '$(_DefaultJdkVersion)')) "
        ContinueOnError="$(_AndroidAllowMissingSdkTooling)"
        Code="XA0031"
        ResourceName="XA0031_NET"
        FormatArguments="$(_DefaultJdkVersion)"
    />
    <AndroidError
        Condition=" '$(_JdkVersion)' != '' and $([MSBuild]::VersionGreaterThan('$(_JdkVersion)', '$(LatestSupportedJavaVersion)')) "
        ContinueOnError="$(_AndroidAllowMissingSdkTooling)"
        Code="XA0030"
        ResourceName="XA0030"
        FormatArguments="$(_JdkVersion);$([System.Version]::Parse('$(LatestSupportedJavaVersion)').ToString(2))"
    />
  </Target>

  <Target Name="_ResolveAndroidTooling" DependsOnTargets="_ComputeAndroidToolingInputs;_ValidateJavaVersion">
    <ResolveAndroidTooling
        Condition=" '$(_AndroidUseResolvedTooling)' != 'true' "
        ReferenceAssemblyPaths="@(_AndroidApiInfoDirectories)"
        ContinueOnError="$(_AndroidAllowMissingSdkTooling)"
        TargetPlatformVersion="$(TargetPlatformVersion)"
        AndroidApiLevel="$(AndroidApiLevel)"
        AndroidSdkPath="$(_AndroidSdkDirectory)"
        AndroidSdkBuildToolsVersion="$(AndroidSdkBuildToolsVersion)"
        Aapt2ToolPath="$(Aapt2ToolPath)"
        CommandLineToolsVersion="$(AndroidCommandLineToolsVersion)"
        LintToolPath="$(LintToolPath)"
        ZipAlignPath="$(ZipAlignToolPath)">
      <Output TaskParameter="AndroidApiLevel"             PropertyName="_AndroidApiLevel"            Condition="'$(_AndroidApiLevel)' == ''" />
      <Output TaskParameter="AndroidApiLevelName"         PropertyName="_AndroidApiLevelName" />
      <Output TaskParameter="AndroidSdkBuildToolsPath"    PropertyName="AndroidSdkBuildToolsPath"    Condition="'$(AndroidSdkBuildToolsPath)' == ''" />
      <Output TaskParameter="AndroidSdkBuildToolsBinPath" PropertyName="AndroidSdkBuildToolsBinPath" Condition="'$(AndroidSdkBuildToolsBinPath)' == ''" />
      <Output TaskParameter="ZipAlignPath"                PropertyName="ZipAlignToolPath"            Condition="'$(ZipAlignToolPath)' == ''" />
      <Output TaskParameter="LintToolPath"                PropertyName="LintToolPath"                Condition="'$(LintToolPath)' == ''" />
      <Output TaskParameter="ApkSignerJar"                PropertyName="ApkSignerJar"                Condition="'$(ApkSignerJar)' == ''" />
      <Output TaskParameter="AndroidUseApkSigner"         PropertyName="AndroidUseApkSigner"         Condition="'$(AndroidUseApkSigner)' == ''" />
      <Output TaskParameter="Aapt2Version"                PropertyName="_Aapt2Version" />
      <Output TaskParameter="Aapt2ToolPath"               PropertyName="Aapt2ToolPath"               Condition="'$(Aapt2ToolPath)' == ''" />
    </ResolveAndroidTooling>
    <RuntimeIdentifierToAbi
        Condition=" '$(AndroidApplication)' == 'true' "
        RuntimeIdentifier="$(RuntimeIdentifier)"
        RuntimeIdentifiers="$(RuntimeIdentifiers)"
        SupportedAbis="$(AndroidSupportedAbis)">
      <Output TaskParameter="SupportedAbis" PropertyName="AndroidSupportedAbis" />
    </RuntimeIdentifierToAbi>
    <PropertyGroup Condition=" '$(_AndroidResolvedSdkProperties)' != '' and '$(_JdkVersion)' != '' and '$(_DefaultJdkVersion)' != '' and '$(_Aapt2Version)' != '' ">
      <_AndroidResolvedToolingProperties>
        $(_AndroidResolvedSdkProperties)
        ;@(_AndroidToolingInput->'_AndroidOuterToolingInput%(Identity)=%(EscapedValue)')
        ;_AndroidOuterJdkVersion=$(_JdkVersion)
        ;_AndroidOuterDefaultJdkVersion=$(_DefaultJdkVersion)
        ;_AndroidOuterApiLevel=$(_AndroidApiLevel)
        ;_AndroidOuterApiLevelName=$(_AndroidApiLevelName)
        ;_AndroidOuterBuildToolsPath=$([MSBuild]::Escape('$(AndroidSdkBuildToolsPath)'))
        ;_AndroidOuterBuildToolsBinPath=$([MSBuild]::Escape('$(AndroidSdkBuildToolsBinPath)'))
        ;_AndroidOuterZipAlignToolPath=$([MSBuild]::Escape('$(ZipAlignToolPath)'))
        ;_AndroidOuterLintToolPath=$([MSBuild]::Escape('$(LintToolPath)'))
        ;_AndroidOuterApkSignerJar=$([MSBuild]::Escape('$(ApkSignerJar)'))
        ;_AndroidOuterUseApkSigner=$(AndroidUseApkSigner)
        ;_AndroidOuterAapt2Version=$(_Aapt2Version)
        ;_AndroidOuterAapt2ToolPath=$([MSBuild]::Escape('$(Aapt2ToolPath)'))
      </_AndroidResolvedToolingProperties>
    </PropertyGroup>
  </Target>

  <Target Name="_CheckGoogleSdkRequirements"
      Condition="Exists('$(IntermediateOutputPath)android\AndroidManifest.xml') And '$(AndroidEnableGooglePlayStoreChecks)' == 'true' ">
    <!-- A direct invocation need not generate the manifest or resolve SDK libraries. -->
    <ReadAndroidManifest
        Condition=" '$(_AndroidSdkRequirementsManifest)' != '$(IntermediateOutputPath)android\AndroidManifest.xml' Or '$(_AndroidSdkRequirementsApiLevel)' != '$(_AndroidApiLevel)' "
        ReadSdkVersionsOnly="true"
        AndroidApiLevel="$(_AndroidApiLevel)"
        ManifestFile="$(IntermediateOutputPath)android\AndroidManifest.xml">
      <Output TaskParameter="CompileSdkVersion" PropertyName="_AndroidManifestCompileSdkVersion" />
      <Output TaskParameter="MinimumSdkVersion" PropertyName="_AndroidManifestMinimumSdkVersion" />
      <Output TaskParameter="TargetSdkVersion" PropertyName="_AndroidManifestTargetSdkVersion" />
    </ReadAndroidManifest>
    <AndroidWarning
        Condition=" '$(_AndroidManifestCompileSdkVersion)' != '' And '$(_AndroidManifestTargetSdkVersion)' &lt; '$(_AndroidManifestCompileSdkVersion)' "
        Code="XA1006"
        ResourceName="XA1006"
        FormatArguments="$(_AndroidManifestCompileSdkVersion);$(_AndroidManifestTargetSdkVersion)"
    />
    <AndroidWarning
        Condition=" '$(_AndroidManifestCompileSdkVersion)' != '' And '$(_AndroidManifestCompileSdkVersion)' &lt; '$(_AndroidManifestTargetSdkVersion)' "
        Code="XA1008"
        ResourceName="XA1008"
        FormatArguments="$(_AndroidManifestCompileSdkVersion);$(_AndroidManifestTargetSdkVersion)"
    />
    <AndroidWarning
        Condition=" '$(_AndroidManifestMinimumSdkVersion)' &gt; '$(_AndroidManifestTargetSdkVersion)' "
        Code="XA1007"
        ResourceName="XA1007"
        FormatArguments="$(_AndroidManifestMinimumSdkVersion);$(_AndroidManifestTargetSdkVersion)"
    />
  </Target>

</Project>