<!-- R8 runs once, after managed trimming. Its final mapping is converted to replacement
     XML, then packaged as a mapped data-only JNI remapping library. Managed JNI names stay unchanged. -->
<Project>
  <UsingTask TaskName="Microsoft.Android.Tasks.WrapJniRemappingAsSharedLibrary" AssemblyFile="$(_MicrosoftAndroidBuildTasksAssembly)" />

  <UsingTask TaskName="Microsoft.Android.Tasks.GenerateR8JniRemapping" AssemblyFile="$(_MicrosoftAndroidBuildTasksAssembly)" Runtime="NET" TaskFactory="TaskHostFactory" Condition=" '$(MSBuildRuntimeType)' == 'Full' " />
  <UsingTask TaskName="Microsoft.Android.Tasks.GenerateR8JniRemapping" AssemblyFile="$(_MicrosoftAndroidBuildTasksAssembly)" Runtime="NET" Condition=" '$(MSBuildRuntimeType)' == 'Core' " />

  <Target Name="_AndroidR8JniRemappingInputs">
    <PropertyGroup>
      <_AndroidR8JniTaskAssembly>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '$(_MicrosoftAndroidBuildTasksAssembly)'))</_AndroidR8JniTaskAssembly>
      <_AndroidR8JniLegacyTaskAssembly>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '$(_XamarinAndroidBuildTasksAssembly)'))</_AndroidR8JniLegacyTaskAssembly>
    </PropertyGroup>
  </Target>

  <Target Name="_AndroidGenerateR8JniRemappingInputs"
      DependsOnTargets="_AndroidR8JniRemappingInputs;_ConvertAndroidMamMappingFileToXml;_AndroidPrepareR8JniRemappingAssemblies">
    <PropertyGroup>
      <_AndroidR8JniGeneratedRemappingXml>$(IntermediateOutputPath)r8-jni-generated-remap.xml</_AndroidR8JniGeneratedRemappingXml>
      <_AndroidR8JniRemappingXml>$(IntermediateOutputPath)r8-jni-remap.xml</_AndroidR8JniRemappingXml>
    </PropertyGroup>
  </Target>

  <Target Name="_AndroidGenerateR8JniRemapping"
      Condition=" '$(_AndroidR8RuntimeRemappingEnabled)' == 'true' and '$(_AndroidRuntime)' == 'CoreCLR' "
      DependsOnTargets="_AndroidGenerateR8JniRemappingInputs"
      Inputs="$(_AndroidR8JniMappingFile);@(_AndroidRemapMembers);@(_AndroidR8JniRemappingAssembly);$(_AndroidBuildPropertiesCache);$(_AndroidR8JniTaskAssembly);$(_AndroidR8JniLegacyTaskAssembly)"
      Outputs="$(_AndroidR8JniGeneratedRemappingXml);$(_AndroidR8JniRemappingXml)">
    <GenerateR8JniRemapping
        MappingFile="$(_AndroidR8JniMappingFile)"
        ExistingRemapXmlFiles="@(_AndroidRemapMembers)"
        LinkedAssemblies="@(_AndroidR8JniRemappingAssembly)"
        OutputFile="$(_AndroidR8JniGeneratedRemappingXml)" />
    <MergeRemapXml
        InputRemapXmlFiles="@(_AndroidRemapMembers);$(_AndroidR8JniGeneratedRemappingXml)"
        OutputFile="$(_AndroidR8JniRemappingXml)" />
    <Touch Files="$(_AndroidR8JniGeneratedRemappingXml);$(_AndroidR8JniRemappingXml)" />
    <ItemGroup>
      <FileWrites Include="$(_AndroidR8JniGeneratedRemappingXml);$(_AndroidR8JniRemappingXml)" />
    </ItemGroup>
  </Target>

  <!-- The first per-RID publish returns the actual ILC object path. No post-R8 project
       evaluation, native relink, or guessed SDK object filename is needed. -->
  <Target Name="_AndroidCollectNativeAotJniRemappingFileWrites"
      AfterTargets="_ResolveAssemblies"
      Condition=" '$(_AndroidRuntime)' == 'NativeAOT' and '$(_OuterIntermediateOutputPath)' == '' and '$(DesignTimeBuild)' != 'true' ">
    <ItemGroup>
      <_AndroidNativeAotJniRemappingFile Include="@(ResolvedFileToPublish)"
          Condition=" '%(ResolvedFileToPublish.AndroidNativeAotObjectFile)' != '' " />
      <FileWrites Include="@(_AndroidNativeAotJniRemappingFile)" />
      <FileWrites Include="@(_AndroidNativeAotJniRemappingFile->'%(AndroidNativeAotObjectFile)')" />
      <FileWrites Include="@(_AndroidNativeAotJniRemappingFile->'%(AndroidNativeAotSymbols)')" />
      <FileWrites Include="@(_AndroidNativeAotJniRemappingFile->'%(AndroidNativeAotIntermediateOutputPath)sections.ld')" />
    </ItemGroup>
  </Target>

  <Target Name="_AndroidGenerateNativeAotR8RemappingInputs"
      DependsOnTargets="_AndroidR8JniRemappingInputs;_ConvertAndroidMamMappingFileToXml;_ResolveAssemblies">
    <ItemGroup>
      <_AndroidNativeAotR8RemappingInput Include="@(ResolvedFileToPublish)"
          Condition=" '%(ResolvedFileToPublish.AndroidNativeAotObjectFile)' != '' " />
      <_AndroidNativeAotR8RemappingInput>
        <GeneratedXml>%(_AndroidNativeAotR8RemappingInput.AndroidNativeAotRemappingDirectory)r8-jni-generated-remap.xml</GeneratedXml>
        <MergedXml>%(_AndroidNativeAotR8RemappingInput.AndroidNativeAotRemappingDirectory)r8-jni-remap.xml</MergedXml>
        <BinaryFile>%(_AndroidNativeAotR8RemappingInput.AndroidNativeAotRemappingDirectory)jni-remap.bin</BinaryFile>
      </_AndroidNativeAotR8RemappingInput>
    </ItemGroup>
    <AndroidError Code="XA4325"
        ResourceName="XA4325_NativeAotObjectRequired"
        FormatArguments="@(_RIDs)"
        Condition=" '@(_AndroidNativeAotR8RemappingInput->Count())' != '@(_RIDs->Count())' " />
  </Target>

  <Target Name="_AndroidGenerateNativeAotR8Remapping"
      Condition=" '$(_AndroidR8RuntimeRemappingEnabled)' == 'true' and '$(_AndroidRuntime)' == 'NativeAOT' "
      DependsOnTargets="_AndroidGenerateNativeAotR8RemappingInputs"
      Inputs="%(_AndroidNativeAotR8RemappingInput.AndroidNativeAotObjectFile);$(_AndroidR8JniMappingFile);@(_AndroidRemapMembers);$(_AndroidBuildPropertiesCache);$(_AndroidR8JniTaskAssembly);$(_AndroidR8JniLegacyTaskAssembly)"
      Outputs="%(_AndroidNativeAotR8RemappingInput.GeneratedXml);%(_AndroidNativeAotR8RemappingInput.MergedXml)">
    <GenerateR8JniRemapping
        MappingFile="$(_AndroidR8JniMappingFile)"
        ExistingRemapXmlFiles="@(_AndroidRemapMembers)"
        NativeAot="true"
        NativeAotObjectFile="%(_AndroidNativeAotR8RemappingInput.AndroidNativeAotObjectFile)"
        OutputFile="%(_AndroidNativeAotR8RemappingInput.GeneratedXml)" />
    <MergeRemapXml
        InputRemapXmlFiles="@(_AndroidRemapMembers);%(_AndroidNativeAotR8RemappingInput.GeneratedXml)"
        OutputFile="%(_AndroidNativeAotR8RemappingInput.MergedXml)" />
    <Touch Files="%(_AndroidNativeAotR8RemappingInput.GeneratedXml);%(_AndroidNativeAotR8RemappingInput.MergedXml)" />
    <ItemGroup>
      <FileWrites Include="%(_AndroidNativeAotR8RemappingInput.GeneratedXml);%(_AndroidNativeAotR8RemappingInput.MergedXml)" />
    </ItemGroup>
  </Target>

  <Target Name="_AndroidGenerateNativeAotR8RemappingAsset"
      Condition=" '$(_AndroidR8RuntimeRemappingEnabled)' == 'true' and '$(_AndroidRuntime)' == 'NativeAOT' "
      DependsOnTargets="_AndroidGenerateNativeAotR8Remapping"
      Inputs="%(_AndroidNativeAotR8RemappingInput.MergedXml);$(_AndroidR8JniTaskAssembly)"
      Outputs="%(_AndroidNativeAotR8RemappingInput.BinaryFile)">
    <GenerateJniRemappingAsset
        MSBuildRuntime="NET"
        RemappingXmlFilePath="%(_AndroidNativeAotR8RemappingInput.MergedXml)"
        OutputFile="%(_AndroidNativeAotR8RemappingInput.BinaryFile)" />
    <ItemGroup>
      <FileWrites Include="%(_AndroidNativeAotR8RemappingInput.BinaryFile)" />
    </ItemGroup>
  </Target>

  <Target Name="_AndroidGenerateJniRemappingAssetInputs"
      DependsOnTargets="_AndroidR8JniRemappingInputs;_ConvertAndroidMamMappingFileToXml;_CollectAndroidRemapMembers">
    <PropertyGroup>
      <_AndroidJniRemappingAssetBin>$(IntermediateOutputPath)android\jni-remap\jni-remap.bin</_AndroidJniRemappingAssetBin>
      <_AndroidJniRemappingInputXml></_AndroidJniRemappingInputXml>
      <_AndroidJniRemappingInputXml Condition=" '@(_AndroidRemapMembers->Count())' != '0' ">$(_XARemapMembersFilePath)</_AndroidJniRemappingInputXml>
      <_AndroidJniRemappingInputXml Condition=" '$(_AndroidR8RuntimeRemappingEnabled)' == 'true' ">$(_AndroidR8JniRemappingXml)</_AndroidJniRemappingInputXml>
    </PropertyGroup>
  </Target>

  <Target Name="_AndroidGenerateJniRemappingAsset"
      Condition=" '$(_AndroidRuntime)' != 'NativeAOT' or '$(_AndroidR8RuntimeRemappingEnabled)' != 'true' "
      DependsOnTargets="_AndroidGenerateR8JniRemapping;_AndroidGenerateJniRemappingAssetInputs"
      Inputs="$(_AndroidJniRemappingInputXml);@(_AndroidMSBuildAllProjects);$(_AndroidBuildPropertiesCache);$(_AndroidR8JniTaskAssembly)"
      Outputs="$(_AndroidJniRemappingAssetBin)">
    <GenerateJniRemappingAsset
        MSBuildRuntime="NET"
        RemappingXmlFilePath="$(_AndroidJniRemappingInputXml)"
        OutputFile="$(_AndroidJniRemappingAssetBin)" />
    <ItemGroup>
      <FileWrites Include="$(_AndroidJniRemappingAssetBin)" />
    </ItemGroup>
  </Target>

  <Target Name="_AndroidGenerateJniRemappingElfInputs"
      DependsOnTargets="_CompileDex;_AndroidGenerateJniRemappingAsset;_AndroidGenerateNativeAotR8RemappingAsset">
    <ItemGroup>
      <_AndroidJniRemappingElf Include="@(_RIDs)"
          Condition=" '$(_AndroidRuntime)' != 'NativeAOT' or '$(_AndroidR8RuntimeRemappingEnabled)' != 'true' ">
        <BinaryFile>$(_AndroidJniRemappingAssetBin)</BinaryFile>
        <ElfFile>$(IntermediateOutputPath)android\jni-remap\%(Identity)\libandroid_runtime_blobs.so</ElfFile>
        <RuntimeIdentifier>%(Identity)</RuntimeIdentifier>
      </_AndroidJniRemappingElf>
      <_AndroidJniRemappingElf Include="@(_AndroidNativeAotR8RemappingInput)"
          Condition=" '$(_AndroidRuntime)' == 'NativeAOT' and '$(_AndroidR8RuntimeRemappingEnabled)' == 'true' ">
        <ElfFile>%(_AndroidNativeAotR8RemappingInput.AndroidNativeAotRemappingDirectory)libandroid_runtime_blobs.so</ElfFile>
      </_AndroidJniRemappingElf>
      <_AndroidJniRemappingElf>
        <Abi Condition=" '%(_AndroidJniRemappingElf.RuntimeIdentifier)' == 'android-arm64' ">arm64-v8a</Abi>
        <Abi Condition=" '%(_AndroidJniRemappingElf.RuntimeIdentifier)' == 'android-arm' ">armeabi-v7a</Abi>
        <Abi Condition=" '%(_AndroidJniRemappingElf.RuntimeIdentifier)' == 'android-x64' ">x86_64</Abi>
        <Abi Condition=" '%(_AndroidJniRemappingElf.RuntimeIdentifier)' == 'android-x86' ">x86</Abi>
      </_AndroidJniRemappingElf>
    </ItemGroup>
  </Target>

  <Target Name="_AndroidGenerateJniRemappingElf"
      DependsOnTargets="_AndroidGenerateJniRemappingElfInputs"
      Inputs="%(_AndroidJniRemappingElf.BinaryFile);$(_AndroidR8JniTaskAssembly)"
      Outputs="%(_AndroidJniRemappingElf.ElfFile)">
    <WrapJniRemappingAsSharedLibrary MSBuildRuntime="NET"
        InputFile="%(_AndroidJniRemappingElf.BinaryFile)"
        OutputFile="%(_AndroidJniRemappingElf.ElfFile)"
        RuntimeIdentifier="%(_AndroidJniRemappingElf.RuntimeIdentifier)" />
    <ItemGroup>
      <FileWrites Include="%(_AndroidJniRemappingElf.ElfFile)" />
    </ItemGroup>
  </Target>

  <Target Name="_AndroidCollectJniRemappingAssets" DependsOnTargets="_AndroidGenerateJniRemappingElf">
    <ItemGroup>
      <_AndroidJniRemappingAssetToArchive Include="@(_AndroidJniRemappingElf->'%(ElfFile)')">
        <ArchivePath>lib/%(_AndroidJniRemappingElf.Abi)/libandroid_runtime_blobs.so</ArchivePath>
      </_AndroidJniRemappingAssetToArchive>
    </ItemGroup>
  </Target>

</Project>
