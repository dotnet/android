<!--
***********************************************************************************************
Microsoft.Android.Sdk.AndroidLibraries.targets

This file contains the .NET 5-specific targets related to
@(AndroidLibrary) items and .aar files generation for class library
projects.

***********************************************************************************************
-->
<Project>

  <UsingTask TaskName="Xamarin.Android.Tasks.ExtractJarsFromAar" AssemblyFile="$(_XamarinAndroidBuildTasksAssembly)" />

  <PropertyGroup>
    <_AarCacheFile>$(IntermediateOutputPath)$(TargetName).aar.cache</_AarCacheFile>
    <_AarStagingDirectory>$(IntermediateOutputPath)aar\</_AarStagingDirectory>
    <_AarOutputPath>$(OutputPath)$(TargetName).aar</_AarOutputPath>
  </PropertyGroup>

  <Target Name="_ResolveAars" AfterTargets="ResolveReferences">
    <ItemGroup>
      <_AarSearchDirectory   Include="@(_ReferencePath->'%(RootDir)%(Directory)')" />
      <_AarSearchDirectory   Include="@(_ReferenceDependencyPaths->'%(RootDir)%(Directory)')" />
      <_AarDistinctDirectory Include="@(_AarSearchDirectory->Distinct())" />
      <_AarFromLibraries     Include="%(_AarDistinctDirectory.Identity)*.aar" NuGetPackageId="%(_AarDistinctDirectory.NuGetPackageId)" NuGetPackageVersion="%(_AarDistinctDirectory.NuGetPackageVersion)"/>
    </ItemGroup>
    <ItemGroup Condition=" '@(_AarFromLibraries->Count())' != '0' ">
      <!--
        NOTE:
        * set %(Pack) to false for located .aar files, we should not repackage into NuGets
        * %(AndroidSkipResourceProcessing) is required for located .aar's; there could be custom views.
      -->
      <AndroidAarLibrary
          Include="@(_AarFromLibraries)"
          Exclude="@(AndroidAarLibrary)"
          Pack="false"
          AndroidSkipResourceProcessing="false"
      />
    </ItemGroup>
  </Target>

  <Target Name="_CreateAarCache"
      Condition=" '$(AndroidApplication)' != 'true' ">
    <ItemGroup>
      <_CreateAarInputs Include="@(AndroidAsset)" />
      <_CreateAarInputs Include="@(_AndroidResourceDest)" />
      <_CreateAarInputs Include="@(AndroidEnvironment)" />
      <_CreateAarInputs Include="@(AndroidJavaLibrary)" />
      <_CreateAarInputs Include="$(AndroidManifest)" />
      <_CreateAarInputs Include="@(EmbeddedJar)" />
      <_CreateAarInputs Include="@(EmbeddedNativeLibrary)" />
      <_CreateAarInputs Include="@(ProguardConfiguration)" />
    </ItemGroup>
    <Hash
        ItemsToHash="@(_CreateAarInputs)"
        IgnoreCase="false">
      <Output TaskParameter="HashResult" PropertyName="_AarDependencyHash" />
    </Hash>
    <WriteLinesToFile
        Condition=" '$(_AarDependencyHash)' != '' "
        Lines="$(_AarDependencyHash)"
        File="$(_AarCacheFile)"
        Overwrite="True"
        WriteOnlyWhenDifferent="True"
    />
    <ItemGroup Condition=" '$(_AarDependencyHash)' != '' ">
      <_CreateAarInputs Include="$(_AarCacheFile)" />
      <FileWrites       Include="$(_AarCacheFile)" />
    </ItemGroup>
  </Target>

  <Target Name="_CreateAar"
      Condition=" '$(AndroidApplication)' != 'true' "
      DependsOnTargets="_CategorizeAndroidLibraries;_CreateAarCache"
      Inputs="@(_CreateAarInputs)"
      Outputs="$(_AarOutputPath)">
    <AndroidError
        Condition=" $([System.IO.Path]::IsPathRooted('$(MonoAndroidAssetsPrefix)')) "
        Code="XA1041"
        ResourceName="XA1041"
        FormatArguments="MonoAndroidAssetsPrefix;$(MonoAndroidAssetsPrefix)"
    />
    <!--
      Mirrors AndroidRidAbiHelper.GetNativeLibraryAbi: unless %(Abi) is set, try these names in order:
      %(RuntimeIdentifier), else the parent and grandparent directories of %(Link); then those of the library itself.
    -->
    <ItemGroup>
      <_AarAbiCandidate Include="@(EmbeddedNativeLibrary)" Condition=" '%(EmbeddedNativeLibrary.RuntimeIdentifier)' != '' "
          Name="%(EmbeddedNativeLibrary.RuntimeIdentifier)" />
      <_AarAbiCandidate Include="@(EmbeddedNativeLibrary)" Condition=" '%(EmbeddedNativeLibrary.RuntimeIdentifier)' == '' and '%(EmbeddedNativeLibrary.Link)' != '' "
          Name="$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '%(EmbeddedNativeLibrary.Link)'))))))" />
      <_AarAbiCandidate Include="@(EmbeddedNativeLibrary)" Condition=" '%(EmbeddedNativeLibrary.RuntimeIdentifier)' == '' and '%(EmbeddedNativeLibrary.Link)' != '' "
          Name="$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName($([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '%(EmbeddedNativeLibrary.Link)'))))))))" />
      <_AarAbiCandidate Include="@(EmbeddedNativeLibrary)"
          Name="$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('%(EmbeddedNativeLibrary.FullPath)'))))" />
      <_AarAbiCandidate Include="@(EmbeddedNativeLibrary)"
          Name="$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName('%(EmbeddedNativeLibrary.FullPath)'))))))" />
      <_AarAbiCandidate>
        <Name>$([System.String]::Copy('%(Name)').ToLowerInvariant().Replace('interpreter-', ''))</Name>
      </_AarAbiCandidate>
      <_AarAbiCandidate>
        <Rid Condition=" $([System.String]::Copy('%(Name)').StartsWith('android')) ">%(Name)</Rid>
      </_AarAbiCandidate>
      <_AarAbiCandidate>
        <Abi Condition=" '%(Abi)' == '' and ('%(Name)' == 'arm64-v8a'   or $([System.String]::Copy('%(Rid)').EndsWith('-arm64'))) ">arm64-v8a</Abi>
        <Abi Condition=" '%(Abi)' == '' and ('%(Name)' == 'armeabi-v7a' or $([System.String]::Copy('%(Rid)').EndsWith('-arm')))   ">armeabi-v7a</Abi>
        <Abi Condition=" '%(Abi)' == '' and ('%(Name)' == 'x86'         or $([System.String]::Copy('%(Rid)').EndsWith('-x86')))   ">x86</Abi>
        <Abi Condition=" '%(Abi)' == '' and ('%(Name)' == 'x86_64'      or $([System.String]::Copy('%(Rid)').EndsWith('-x64')))   ">x86_64</Abi>
      </_AarAbiCandidate>
      <!-- The first candidate with an ABI wins. -->
      <_AarAbiResolved Include="@(_AarAbiCandidate)" Condition=" '%(_AarAbiCandidate.Abi)' != '' " />
      <_AarNativeLibrary Include="@(_AarAbiResolved->Distinct())" RemoveMetadata="Name;Rid" />
      <_AarAbiUnresolved Include="@(EmbeddedNativeLibrary)" Exclude="@(_AarNativeLibrary)" />
    </ItemGroup>
    <AndroidError
        Condition=" '@(_AarAbiUnresolved)' != '' "
        Code="XA4301"
        ResourceName="XA4301_ABI"
        FormatArguments="%(_AarAbiUnresolved.Identity)"
        File="%(_AarAbiUnresolved.Identity)"
    />
    <!--
      Stage the AAR layout; when two items map to the same %(ArchivePath), the last one wins.
      Asset paths drop everything up to and including the first $(MonoAndroidAssetsPrefix) directory.
    -->
    <PropertyGroup>
      <_AndroidAarAssetDirectory>/$(MonoAndroidAssetsPrefix)</_AndroidAarAssetDirectory>
      <_AndroidAarAssetPrefix>$(_AndroidAarAssetDirectory)/</_AndroidAarAssetPrefix>
    </PropertyGroup>
    <ItemGroup>
      <_AndroidAarAsset Include="@(AndroidAsset)" Condition=" !$([System.IO.Directory]::Exists('%(AndroidAsset.FullPath)')) ">
        <_AndroidAssetPath>$([MSBuild]::ValueOrDefault('%(AndroidAsset.Link)', '%(AndroidAsset.Identity)').Replace('\', '/'))</_AndroidAssetPath>
        <_AndroidAssetSearchPath>/%(_AndroidAssetPath)</_AndroidAssetSearchPath>
        <_AndroidAssetPrefixIndex>$([System.String]::Copy('%(_AndroidAssetSearchPath)').IndexOf('$(_AndroidAarAssetPrefix)', System.StringComparison.OrdinalIgnoreCase))</_AndroidAssetPrefixIndex>
        <_AndroidAssetRelativeStart>$([MSBuild]::Add(%(_AndroidAssetPrefixIndex), $(_AndroidAarAssetPrefix.Length)))</_AndroidAssetRelativeStart>
        <_AndroidAssetRelativePath>%(_AndroidAssetPath)</_AndroidAssetRelativePath>
        <_AndroidAssetRelativePath
            Condition=" '%(_AndroidAssetPrefixIndex)' &gt;= '0' "
            >$([System.String]::Copy('%(_AndroidAssetSearchPath)').Substring(%(_AndroidAssetRelativeStart)).TrimStart('/'))</_AndroidAssetRelativePath>
        <_AndroidAssetRelativePath
            Condition=" '%(_AndroidAssetPrefixIndex)' == '-1' and $([System.String]::Copy('%(_AndroidAssetSearchPath)').EndsWith('$(_AndroidAarAssetDirectory)', System.StringComparison.OrdinalIgnoreCase)) "
            ></_AndroidAssetRelativePath>
        <ArchivePath>assets/%(_AndroidAssetRelativePath)</ArchivePath>
      </_AndroidAarAsset>
      <_AarFile Include="@(_AndroidAarAsset)" />
      <_AarResource Include="@(_AndroidResourceDest)" Condition=" !$([System.IO.Directory]::Exists('%(_AndroidResourceDest.FullPath)')) "
          ResourcePath="$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('%(_AndroidResourceDest.FullPath)'))))/%(_AndroidResourceDest.Filename)%(_AndroidResourceDest.Extension)"
          LogicalName="$([System.String]::Copy('%(_AndroidResourceDest.LogicalName)').Replace('\', '/'))" />
      <_AarFile Include="@(_AarResource)" ArchivePath="res/%(_AarResource.ResourcePath)" />
      <_AarFile Include="@(AndroidEnvironment)" ArchivePath=".net/env/$([MSBuild]::StableStringHash($([System.String]::Copy('%(AndroidEnvironment.Identity)').Replace('\', '/')))).env" />
      <_AarFile Include="@(AndroidJavaLibrary)" Condition=" '%(AndroidJavaLibrary.Pack)' != 'false' "
          ArchivePath="libs/$([MSBuild]::StableStringHash($([System.String]::Copy('%(AndroidJavaLibrary.Identity)').Replace('\', '/')))).jar" />
      <_AarFile Include="@(EmbeddedJar)" Condition=" '%(EmbeddedJar.Pack)' != 'false' "
          ArchivePath="libs/$([MSBuild]::StableStringHash($([System.String]::Copy('%(EmbeddedJar.Identity)').Replace('\', '/')))).jar" />
      <_AarFile Include="@(_AarNativeLibrary)" ArchivePath="jni/%(_AarNativeLibrary.Abi)/%(_AarNativeLibrary.Filename)%(_AarNativeLibrary.Extension)" />
    </ItemGroup>
    <XmlPeek
        Condition=" Exists('$(AndroidManifest)') "
        XmlInputPath="$(AndroidManifest)"
        Query="/manifest/@package"
        ProhibitDtd="true">
      <Output TaskParameter="Result" PropertyName="_AarManifestPackage" />
    </XmlPeek>
    <ItemGroup Condition=" '$(_AarManifestPackage)' != '' ">
      <_AarFile Include="$(AndroidManifest)" ArchivePath="AndroidManifest.xml" />
    </ItemGroup>
    <RemoveDirFixed Directories="$(_AarStagingDirectory)" />
    <Copy SourceFiles="@(_AarFile)" DestinationFiles="@(_AarFile->'$(_AarStagingDirectory)%(ArchivePath)')" />
    <WriteLinesToFile
        Condition=" '@(_AarResource)' != '' "
        File="$(_AarStagingDirectory).net/__res_name_case_map.txt"
        Lines="@(_AarResource->'%(LogicalName)%3B%(ResourcePath)')"
    />
    <ReadLinesFromFile File="%(ProguardConfiguration.Identity)">
      <Output TaskParameter="Lines" ItemName="_AarProguardLine" />
    </ReadLinesFromFile>
    <WriteLinesToFile
        Condition=" '@(ProguardConfiguration)' != '' "
        File="$(_AarStagingDirectory)proguard.txt"
        Lines="@(_AarProguardLine)"
    />
    <MakeDir Directories="$(_AarStagingDirectory);$(OutputPath)" />
    <ZipDirectory
        SourceDirectory="$(_AarStagingDirectory)"
        DestinationFile="$(_AarOutputPath)"
        Overwrite="true"
    />
    <ItemGroup>
      <FileWrites Include="$(_AarOutputPath)" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_IncludeAarInNuGetPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <Target Name="_IncludeAarInNuGetPackage"
      Condition=" '$(IncludeBuildOutput)' != 'false' and '$(AndroidApplication)' != 'true' "
      DependsOnTargets="$(_IncludeAarInNuGetPackageDependsOn)">
    <GetNuGetShortFolderName
        TargetFrameworkMoniker="$(TargetFrameworkMoniker)"
        TargetPlatformMoniker="$(TargetPlatformMoniker)">
      <Output TaskParameter="NuGetShortFolderName" PropertyName="_NuGetShortFolderName" />
    </GetNuGetShortFolderName>
    <ItemGroup>
      <TfmSpecificPackageFile Condition="Exists('$(_AarOutputPath)')" Include="$(_AarOutputPath)" PackagePath="lib\$(_NuGetShortFolderName)" />
      <TfmSpecificPackageFileWithRecursiveDir Include="@(None->WithMetadataValue ('TfmSpecificPackageFile', 'true'))" PackagePath="lib\$(_NuGetShortFolderName)" NuGetRecursiveDir="" />
    </ItemGroup>
  </Target>

  <Target Name="_ExtractAar"
      DependsOnTargets="_CategorizeAndroidLibraries"
      Inputs="@(LibraryProjectZip);@(_AndroidReferenceLibraryProjectZip);@(_AndroidMSBuildAllProjects)"
      Outputs="$(_AndroidStampDirectory)_ExtractAar.stamp">
    <ExtractJarsFromAar
        OutputJarsDirectory="$(IntermediateOutputPath)library_project_jars"
        OutputAnnotationsDirectory="$(IntermediateOutputPath)library_project_annotations"
        Libraries="@(LibraryProjectZip)"
        OutputReferenceJarsDirectory="$(IntermediateOutputPath)reference_library_project_jars"
        OutputReferenceAnnotationsDirectory="$(IntermediateOutputPath)reference_library_project_annotations"
        ReferenceLibraries="@(_AndroidReferenceLibraryProjectZip)"
    />
    <Touch Files="$(_AndroidStampDirectory)_ExtractAar.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="_CleanAarCache">
    <Delete Files="$(_AarCacheFile)" />
  </Target>

</Project>
