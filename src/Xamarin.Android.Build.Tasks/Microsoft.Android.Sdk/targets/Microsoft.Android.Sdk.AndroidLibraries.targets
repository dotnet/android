<!--
***********************************************************************************************
Microsoft.Android.Sdk.AndroidLibraries.targets

This file contains the .NET 5-specific targets related to
@(AndroidLibrary) items and .aar files generation for class library
projects.

***********************************************************************************************
-->
<Project>

  <UsingTask TaskName="Xamarin.Android.Tasks.CreateAar"          AssemblyFile="$(_XamarinAndroidBuildTasksAssembly)" />

  <PropertyGroup>
    <_AarCacheFile>$(IntermediateOutputPath)$(TargetName).aar.cache</_AarCacheFile>
    <_AarOutputPath>$(OutputPath)$(TargetName).aar</_AarOutputPath>
    <_ExtractAarStagingDirectory>$(IntermediateOutputPath)extract_aar_staging\</_ExtractAarStagingDirectory>
  </PropertyGroup>

  <Target Name="_ResolveAars" AfterTargets="ResolveReferences">
    <ItemGroup>
      <_AarSearchDirectory   Include="@(_ReferencePath->'%(RootDir)%(Directory)')" />
      <_AarSearchDirectory   Include="@(_ReferenceDependencyPaths->'%(RootDir)%(Directory)')" />
      <_AarDistinctDirectory Include="@(_AarSearchDirectory->Distinct())" />
      <_AarFromLibraries     Include="%(_AarDistinctDirectory.Identity)*.aar" NuGetPackageId="%(_AarDistinctDirectory.NuGetPackageId)" NuGetPackageVersion="%(_AarDistinctDirectory.NuGetPackageVersion)"/>
    </ItemGroup>
    <ItemGroup Condition=" '@(_AarFromLibraries->Count())' != '0' ">
      <!--
        NOTE:
        * set %(Pack) to false for located .aar files, we should not repackage into NuGets
        * %(AndroidSkipResourceProcessing) is required for located .aar's; there could be custom views.
      -->
      <AndroidAarLibrary
          Include="@(_AarFromLibraries)"
          Exclude="@(AndroidAarLibrary)"
          Pack="false"
          AndroidSkipResourceProcessing="false"
      />
    </ItemGroup>
  </Target>

  <Target Name="_CreateAarCache"
      Condition=" '$(AndroidApplication)' != 'true' ">
    <ItemGroup>
      <_CreateAarInputs Include="@(AndroidAsset)" />
      <_CreateAarInputs Include="@(_AndroidResourceDest)" />
      <_CreateAarInputs Include="@(AndroidEnvironment)" />
      <_CreateAarInputs Include="@(AndroidJavaLibrary)" />
      <_CreateAarInputs Include="$(AndroidManifest)" />
      <_CreateAarInputs Include="@(EmbeddedJar)" />
      <_CreateAarInputs Include="@(EmbeddedNativeLibrary)" />
      <_CreateAarInputs Include="@(ProguardConfiguration)" />
    </ItemGroup>
    <Hash
        ItemsToHash="@(_CreateAarInputs)"
        IgnoreCase="false">
      <Output TaskParameter="HashResult" PropertyName="_AarDependencyHash" />
    </Hash>
    <WriteLinesToFile
        Condition=" '$(_AarDependencyHash)' != '' "
        Lines="$(_AarDependencyHash)"
        File="$(_AarCacheFile)"
        Overwrite="True"
        WriteOnlyWhenDifferent="True"
    />
    <ItemGroup Condition=" '$(_AarDependencyHash)' != '' ">
      <_CreateAarInputs Include="$(_AarCacheFile)" />
      <FileWrites       Include="$(_AarCacheFile)" />
    </ItemGroup>
  </Target>

  <Target Name="_CreateAar"
      Condition=" '$(AndroidApplication)' != 'true' "
      DependsOnTargets="_CategorizeAndroidLibraries;_CreateAarCache"
      Inputs="@(_CreateAarInputs)"
      Outputs="$(_AarOutputPath)">
    <CreateAar
        AssetDirectory="$(MonoAndroidAssetsPrefix)"
        PrefixProperty="MonoAndroidAssetsPrefix"
        AndroidAssets="@(AndroidAsset)"
        AndroidResources="@(_AndroidResourceDest)"
        AndroidEnvironment="@(AndroidEnvironment)"
        AndroidManifest="$(AndroidManifest)"
        JarFiles="@(AndroidJavaLibrary);@(EmbeddedJar)"
        NativeLibraries="@(EmbeddedNativeLibrary)"
        ProguardConfigurationFiles="@(ProguardConfiguration)"
        OutputFile="$(_AarOutputPath)"
    />
    <ItemGroup>
      <FileWrites Include="$(_AarOutputPath)" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_IncludeAarInNuGetPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <Target Name="_IncludeAarInNuGetPackage"
      Condition=" '$(IncludeBuildOutput)' != 'false' and '$(AndroidApplication)' != 'true' "
      DependsOnTargets="$(_IncludeAarInNuGetPackageDependsOn)">
    <GetNuGetShortFolderName
        TargetFrameworkMoniker="$(TargetFrameworkMoniker)"
        TargetPlatformMoniker="$(TargetPlatformMoniker)">
      <Output TaskParameter="NuGetShortFolderName" PropertyName="_NuGetShortFolderName" />
    </GetNuGetShortFolderName>
    <ItemGroup>
      <TfmSpecificPackageFile Condition="Exists('$(_AarOutputPath)')" Include="$(_AarOutputPath)" PackagePath="lib\$(_NuGetShortFolderName)" />
      <TfmSpecificPackageFileWithRecursiveDir Include="@(None->WithMetadataValue ('TfmSpecificPackageFile', 'true'))" PackagePath="lib\$(_NuGetShortFolderName)" NuGetRecursiveDir="" />
    </ItemGroup>
  </Target>

  <Target Name="_ExtractAar"
      DependsOnTargets="_CategorizeAndroidLibraries"
      Inputs="@(LibraryProjectZip);@(_AndroidReferenceLibraryProjectZip);@(_AndroidMSBuildAllProjects)"
      Outputs="$(_AndroidStampDirectory)_ExtractAar.stamp">
    <ItemGroup>
      <_ExtractAarLibrary Include="@(LibraryProjectZip)" OutputPrefix="library_project" />
      <_ExtractAarLibrary Include="@(_AndroidReferenceLibraryProjectZip)" OutputPrefix="reference_library_project" />
    </ItemGroup>
    <PropertyGroup>
      <_ExtractAarStagingRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(_ExtractAarStagingDirectory)'))</_ExtractAarStagingRoot>
      <_ExtractAarOutputRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)'))</_ExtractAarOutputRoot>
      <_ExtractAarMatchOptions Condition=" '$(OS)' == 'Windows_NT' ">CaseInsensitive</_ExtractAarMatchOptions>
      <_ExtractAarMatchOptions Condition=" '$(OS)' != 'Windows_NT' ">CaseSensitive</_ExtractAarMatchOptions>
    </PropertyGroup>
    <RemoveDirFixed Directories="$(_ExtractAarStagingRoot)" />
    <!--
      Archives are extracted into a staging directory first; the final output directories are only updated once
      the staged files have been validated. Unzip rejects entries that would be written outside of DestinationFolder.
      .aar files only contribute classes.jar and libs/*.jar, see Files.ShouldSkipEntryInAar ().
      SkipUnchangedFiles="false" lets later archives win when libraries with the same file name share a staging directory.
    -->
    <Unzip
        SourceFiles="@(_ExtractAarLibrary)"
        DestinationFolder="$(_ExtractAarStagingRoot)%(OutputPrefix)_jars\%(Filename)%(Extension)"
        Include="*.jar"
        SkipUnchangedFiles="false"
        Condition=" '%(Extension)' != '.aar' "
    />
    <Unzip
        SourceFiles="@(_ExtractAarLibrary)"
        DestinationFolder="$(_ExtractAarStagingRoot)%(OutputPrefix)_jars\%(Filename)%(Extension)"
        Include="classes.jar;libs/*.jar"
        SkipUnchangedFiles="false"
        Condition=" '%(Extension)' == '.aar' "
    />
    <Unzip
        SourceFiles="@(_ExtractAarLibrary)"
        DestinationFolder="$(_ExtractAarStagingRoot)%(OutputPrefix)_annotations\%(Filename)%(Extension)"
        Include="annotations.zip;*/annotations.zip"
        SkipUnchangedFiles="false"
    />
    <!--
      On Unix, Unzip writes an entry such as 'libs\foo.jar' to a file literally named 'libs\foo.jar'.
      Move such files to the path the entry describes on Windows. MSBuild converts '\' to '/' in item
      specs, so file names are listed with a placeholder for '\' and moved using '%5C', which preserves it.
      Entries that would resolve outside of their archive's directory, or that are nested too deeply, are errors.
    -->
    <PropertyGroup Condition=" '$(OS)' != 'Windows_NT' and Exists('$(_ExtractAarStagingRoot)') ">
      <_ExtractAarBackslash>__XA_BACKSLASH__</_ExtractAarBackslash>
      <_ExtractAarSlash>__XA_SLASH__</_ExtractAarSlash>
      <_ExtractAarStagedPaths>$([System.String]::Join(';', $([System.IO.Directory]::GetFiles('$(_ExtractAarStagingRoot)', '*', System.IO.SearchOption.AllDirectories))).Replace('\', '$(_ExtractAarBackslash)'))</_ExtractAarStagedPaths>
    </PropertyGroup>
    <ItemGroup Condition=" '$(_ExtractAarStagedPaths)' != '' ">
      <_ExtractAarStagedPath Include="$([MSBuild]::Unescape('$(_ExtractAarStagedPaths)'))" />
      <_ExtractAarBackslashEntry
          Include="@(_ExtractAarStagedPath)"
          Condition=" $([System.String]::Copy('%(Identity)').StartsWith('$(_ExtractAarStagingRoot)')) and $([System.String]::Copy('%(Identity)').Contains('$(_ExtractAarBackslash)')) ">
        <RelativePath>$([System.String]::Copy('%(Identity)').Substring($(_ExtractAarStagingRoot.Length)))</RelativePath>
      </_ExtractAarBackslashEntry>
      <_ExtractAarBackslashEntry>
        <Pieces>$([System.String]::Copy('%(RelativePath)').Replace('/', '$(_ExtractAarSlash)').Replace('$(_ExtractAarBackslash)', '/'))////////</Pieces>
        <OutputDirectory>$([System.String]::Copy('%(RelativePath)//').Split('/').GetValue(0))</OutputDirectory>
        <Archive>$([System.String]::Copy('%(RelativePath)//').Split('/').GetValue(1))</Archive>
        <Destination>$([MSBuild]::NormalizePath('$(_ExtractAarStagingRoot)', $([System.String]::Copy('%(RelativePath)').Replace('$(_ExtractAarBackslash)', '/'))))</Destination>
      </_ExtractAarBackslashEntry>
      <_ExtractAarBackslashEntry>
        <Entry>$([System.String]::Copy('%(RelativePath)').Substring($([MSBuild]::Add($([System.String]::Copy('%(OutputDirectory)/%(Archive)/').Length), 0))).Replace('$(_ExtractAarBackslash)', '\'))</Entry>
        <PieceCount>$([MSBuild]::Subtract($([System.String]::Copy('%(Pieces)').Split('/').Length), 8))</PieceCount>
        <IsInsideArchive>$([System.String]::Copy('%(Destination)').StartsWith('$(_ExtractAarStagingRoot)%(OutputDirectory)/%(Archive)/'))</IsInsideArchive>
        <Piece0>$([System.String]::Copy($([System.String]::Copy('%(Pieces)').Split('/').GetValue(0))).Replace('$(_ExtractAarSlash)', '/'))</Piece0>
        <Piece1>$([System.String]::Copy($([System.String]::Copy('%(Pieces)').Split('/').GetValue(1))).Replace('$(_ExtractAarSlash)', '/'))</Piece1>
        <Piece2>$([System.String]::Copy($([System.String]::Copy('%(Pieces)').Split('/').GetValue(2))).Replace('$(_ExtractAarSlash)', '/'))</Piece2>
        <Piece3>$([System.String]::Copy($([System.String]::Copy('%(Pieces)').Split('/').GetValue(3))).Replace('$(_ExtractAarSlash)', '/'))</Piece3>
        <Piece4>$([System.String]::Copy($([System.String]::Copy('%(Pieces)').Split('/').GetValue(4))).Replace('$(_ExtractAarSlash)', '/'))</Piece4>
        <Piece5>$([System.String]::Copy($([System.String]::Copy('%(Pieces)').Split('/').GetValue(5))).Replace('$(_ExtractAarSlash)', '/'))</Piece5>
        <Piece6>$([System.String]::Copy($([System.String]::Copy('%(Pieces)').Split('/').GetValue(6))).Replace('$(_ExtractAarSlash)', '/'))</Piece6>
        <Piece7>$([System.String]::Copy($([System.String]::Copy('%(Pieces)').Split('/').GetValue(7))).Replace('$(_ExtractAarSlash)', '/'))</Piece7>
      </_ExtractAarBackslashEntry>
      <_ExtractAarInvalidEntry Include="@(_ExtractAarBackslashEntry)" Condition=" '%(IsInsideArchive)' != 'True' or %(PieceCount) &gt; 8 " />
      <_ExtractAarBackslashEntry Remove="@(_ExtractAarInvalidEntry)" />
    </ItemGroup>
    <AndroidError
        Code="XA4332"
        ResourceName="XA4332"
        FormatArguments="%(_ExtractAarInvalidEntry.Archive);%(_ExtractAarInvalidEntry.Entry)"
        ContinueOnError="ErrorAndContinue"
        Condition=" '@(_ExtractAarInvalidEntry)' != '' "
    />
    <MakeDir
        Directories="@(_ExtractAarBackslashEntry->'%(Destination)'->DirectoryName())"
        Condition=" '@(_ExtractAarInvalidEntry)' == '' "
    />
    <Move
        SourceFiles="$(_ExtractAarStagingRoot)%(_ExtractAarBackslashEntry.Piece0)%5C%(_ExtractAarBackslashEntry.Piece1)"
        DestinationFiles="%(_ExtractAarBackslashEntry.Destination)"
        Condition=" '@(_ExtractAarInvalidEntry)' == '' and '%(_ExtractAarBackslashEntry.PieceCount)' == '2' "
    />
    <Move
        SourceFiles="$(_ExtractAarStagingRoot)%(_ExtractAarBackslashEntry.Piece0)%5C%(_ExtractAarBackslashEntry.Piece1)%5C%(_ExtractAarBackslashEntry.Piece2)"
        DestinationFiles="%(_ExtractAarBackslashEntry.Destination)"
        Condition=" '@(_ExtractAarInvalidEntry)' == '' and '%(_ExtractAarBackslashEntry.PieceCount)' == '3' "
    />
    <Move
        SourceFiles="$(_ExtractAarStagingRoot)%(_ExtractAarBackslashEntry.Piece0)%5C%(_ExtractAarBackslashEntry.Piece1)%5C%(_ExtractAarBackslashEntry.Piece2)%5C%(_ExtractAarBackslashEntry.Piece3)"
        DestinationFiles="%(_ExtractAarBackslashEntry.Destination)"
        Condition=" '@(_ExtractAarInvalidEntry)' == '' and '%(_ExtractAarBackslashEntry.PieceCount)' == '4' "
    />
    <Move
        SourceFiles="$(_ExtractAarStagingRoot)%(_ExtractAarBackslashEntry.Piece0)%5C%(_ExtractAarBackslashEntry.Piece1)%5C%(_ExtractAarBackslashEntry.Piece2)%5C%(_ExtractAarBackslashEntry.Piece3)%5C%(_ExtractAarBackslashEntry.Piece4)"
        DestinationFiles="%(_ExtractAarBackslashEntry.Destination)"
        Condition=" '@(_ExtractAarInvalidEntry)' == '' and '%(_ExtractAarBackslashEntry.PieceCount)' == '5' "
    />
    <Move
        SourceFiles="$(_ExtractAarStagingRoot)%(_ExtractAarBackslashEntry.Piece0)%5C%(_ExtractAarBackslashEntry.Piece1)%5C%(_ExtractAarBackslashEntry.Piece2)%5C%(_ExtractAarBackslashEntry.Piece3)%5C%(_ExtractAarBackslashEntry.Piece4)%5C%(_ExtractAarBackslashEntry.Piece5)"
        DestinationFiles="%(_ExtractAarBackslashEntry.Destination)"
        Condition=" '@(_ExtractAarInvalidEntry)' == '' and '%(_ExtractAarBackslashEntry.PieceCount)' == '6' "
    />
    <Move
        SourceFiles="$(_ExtractAarStagingRoot)%(_ExtractAarBackslashEntry.Piece0)%5C%(_ExtractAarBackslashEntry.Piece1)%5C%(_ExtractAarBackslashEntry.Piece2)%5C%(_ExtractAarBackslashEntry.Piece3)%5C%(_ExtractAarBackslashEntry.Piece4)%5C%(_ExtractAarBackslashEntry.Piece5)%5C%(_ExtractAarBackslashEntry.Piece6)"
        DestinationFiles="%(_ExtractAarBackslashEntry.Destination)"
        Condition=" '@(_ExtractAarInvalidEntry)' == '' and '%(_ExtractAarBackslashEntry.PieceCount)' == '7' "
    />
    <Move
        SourceFiles="$(_ExtractAarStagingRoot)%(_ExtractAarBackslashEntry.Piece0)%5C%(_ExtractAarBackslashEntry.Piece1)%5C%(_ExtractAarBackslashEntry.Piece2)%5C%(_ExtractAarBackslashEntry.Piece3)%5C%(_ExtractAarBackslashEntry.Piece4)%5C%(_ExtractAarBackslashEntry.Piece5)%5C%(_ExtractAarBackslashEntry.Piece6)%5C%(_ExtractAarBackslashEntry.Piece7)"
        DestinationFiles="%(_ExtractAarBackslashEntry.Destination)"
        Condition=" '@(_ExtractAarInvalidEntry)' == '' and '%(_ExtractAarBackslashEntry.PieceCount)' == '8' "
    />
    <!-- Writing through a symbolic link or junction could modify files outside of the output directories. -->
    <ItemGroup>
      <_ExtractAarOutputDirectory Include="$(_ExtractAarOutputRoot)library_project_jars;$(_ExtractAarOutputRoot)library_project_annotations;$(_ExtractAarOutputRoot)reference_library_project_jars;$(_ExtractAarOutputRoot)reference_library_project_annotations" />
      <_ExtractAarOutputLink Include="@(_ExtractAarOutputDirectory)" Condition=" Exists('%(Identity)') and $([MSBuild]::BitwiseAnd(1024, $([System.IO.File]::GetAttributes('%(Identity)').ToString('D')))) != 0 " />
    </ItemGroup>
    <PropertyGroup Condition=" '@(_ExtractAarOutputLink)' == '' ">
      <_ExtractAarOutputEntries Condition=" Exists('%(_ExtractAarOutputDirectory.Identity)') ">$(_ExtractAarOutputEntries);$([System.String]::Join(';', $([System.IO.Directory]::GetDirectories('%(_ExtractAarOutputDirectory.Identity)', '*', System.IO.SearchOption.AllDirectories))));$([System.String]::Join(';', $([System.IO.Directory]::GetFiles('%(_ExtractAarOutputDirectory.Identity)', '*', System.IO.SearchOption.AllDirectories))))</_ExtractAarOutputEntries>
    </PropertyGroup>
    <ItemGroup Condition=" '$(_ExtractAarOutputEntries)' != '' ">
      <_ExtractAarOutputEntry Include="$([MSBuild]::Unescape('$(_ExtractAarOutputEntries)'))" />
      <_ExtractAarOutputLink Include="@(_ExtractAarOutputEntry)" Condition=" Exists('%(Identity)') and $([MSBuild]::BitwiseAnd(1024, $([System.IO.File]::GetAttributes('%(Identity)').ToString('D')))) != 0 " />
    </ItemGroup>
    <AndroidError
        Code="XA4333"
        ResourceName="XA4333"
        FormatArguments="%(_ExtractAarOutputLink.Identity)"
        ContinueOnError="ErrorAndContinue"
        Condition=" '@(_ExtractAarOutputLink)' != '' "
    />
    <!-- Delete outputs that are no longer extracted before copying, so case-only renames are recreated with their new name. -->
    <ItemGroup Condition=" '@(_ExtractAarInvalidEntry)' == '' and '@(_ExtractAarOutputLink)' == '' ">
      <_ExtractAarStagedFile Include="$(_ExtractAarStagingRoot)library_project_jars\**\*" OutputDirectory="library_project_jars" />
      <_ExtractAarStagedFile Include="$(_ExtractAarStagingRoot)library_project_annotations\**\*" OutputDirectory="library_project_annotations" />
      <_ExtractAarStagedFile Include="$(_ExtractAarStagingRoot)reference_library_project_jars\**\*" OutputDirectory="reference_library_project_jars" />
      <_ExtractAarStagedFile Include="$(_ExtractAarStagingRoot)reference_library_project_annotations\**\*" OutputDirectory="reference_library_project_annotations" />
      <_ExtractAarStagedFile>
        <OutputPath>%(OutputDirectory)/%(RecursiveDir)%(Filename)%(Extension)</OutputPath>
      </_ExtractAarStagedFile>
      <_ExtractAarStagedFile>
        <DestinationPath>$([MSBuild]::NormalizePath('$(_ExtractAarOutputRoot)', '%(OutputPath)'))</DestinationPath>
      </_ExtractAarStagedFile>
      <_ExtractAarExistingFile Include="$(_ExtractAarOutputRoot)library_project_jars\**\*" OutputDirectory="library_project_jars" />
      <_ExtractAarExistingFile Include="$(_ExtractAarOutputRoot)library_project_annotations\**\*" OutputDirectory="library_project_annotations" />
      <_ExtractAarExistingFile Include="$(_ExtractAarOutputRoot)reference_library_project_jars\**\*" OutputDirectory="reference_library_project_jars" />
      <_ExtractAarExistingFile Include="$(_ExtractAarOutputRoot)reference_library_project_annotations\**\*" OutputDirectory="reference_library_project_annotations" />
      <_ExtractAarExistingFile>
        <OutputPath>%(OutputDirectory)/%(RecursiveDir)%(Filename)%(Extension)</OutputPath>
      </_ExtractAarExistingFile>
      <_ExtractAarStaleFile Include="@(_ExtractAarExistingFile)" />
      <_ExtractAarStaleFile Remove="@(_ExtractAarStagedFile)" MatchOnMetadata="OutputPath" MatchOnMetadataOptions="$(_ExtractAarMatchOptions)" />
    </ItemGroup>
    <Delete Files="@(_ExtractAarStaleFile)" />
    <!-- Touch staged files so CopyIfChanged compares contents instead of trusting archive entry timestamps. -->
    <Touch Files="@(_ExtractAarStagedFile)" />
    <CopyIfChanged
        SourceFiles="@(_ExtractAarStagedFile)"
        DestinationFiles="@(_ExtractAarStagedFile->'%(DestinationPath)')"
    />
    <ItemGroup>
      <FileWrites Include="@(_ExtractAarStagedFile->'%(DestinationPath)')" />
    </ItemGroup>
    <RemoveDirFixed Directories="$(_ExtractAarStagingRoot)" />
    <Touch
        Files="$(_AndroidStampDirectory)_ExtractAar.stamp"
        AlwaysCreate="true"
        Condition=" '@(_ExtractAarInvalidEntry)' == '' and '@(_ExtractAarOutputLink)' == '' "
    />
    <OnError ExecuteTargets="_CleanExtractAarStaging" />
  </Target>

  <Target Name="_CleanExtractAarStaging">
    <RemoveDirFixed Directories="$(_ExtractAarStagingDirectory)" />
  </Target>

  <Target Name="_CleanAarCache">
    <Delete Files="$(_AarCacheFile)" />
  </Target>

</Project>
