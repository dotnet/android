<!--
***********************************************************************************************
Microsoft.Android.Sdk.NativeAOT.targets

This file contains the NativeAOT-specific MSBuild logic for .NET for Android.
***********************************************************************************************
-->
<Project>

  <UsingTask TaskName="Microsoft.Android.Tasks.GenerateNativeAotBootstrapSources" AssemblyFile="$(_MicrosoftAndroidBuildTasksAssembly)" />
  <UsingTask TaskName="Microsoft.Android.Tasks.GetNativeAotRuntimeProviders" AssemblyFile="$(_MicrosoftAndroidBuildTasksAssembly)" />
  <UsingTask TaskName="Microsoft.Android.Tasks.LinkNativeAotSharedLibrary" AssemblyFile="$(_MicrosoftAndroidBuildTasksAssembly)" />

  <!-- Default property values for NativeAOT -->
  <PropertyGroup>
    <_AndroidRuntimePackRuntime>NativeAOT</_AndroidRuntimePackRuntime>
    <!-- .NET SDK gives: error NETSDK1191: A runtime identifier for the property 'PublishAot' couldn't be inferred. Specify a rid explicitly. -->
    <AllowPublishAotWithoutRuntimeIdentifier Condition=" '$(AllowPublishAotWithoutRuntimeIdentifier)' == '' ">true</AllowPublishAotWithoutRuntimeIdentifier>
    <!-- NativeAOT's targets currently gives an error about cross-compilation -->
    <DisableUnsupportedError Condition=" $([MSBuild]::IsOSPlatform('windows')) and '$(DisableUnsupportedError)' == '' ">true</DisableUnsupportedError>
    <!-- HACK: make dotnet restore include Microsoft.NETCore.App.Runtime.NativeAOT.* packs -->
    <_IsPublishing Condition=" '$(_IsPublishing)' == '' ">true</_IsPublishing>
    <!-- ResolvedFileToPublish is not populated until _AndroidComputeIlcCompileInputs, so
         proguard generation must run after that target instead of after ILLink. -->
    <_GenerateProguardAfterTargets>_AndroidComputeIlcCompileInputs</_GenerateProguardAfterTargets>
    <!-- Ask ILC to produce a static library (.a) instead of a shared library (.so).
         This gives Android full control over the native linker invocation. -->
    <NativeLib>static</NativeLib>
    <!-- ILC only sets this for NativeLib=Shared, but we need [UnmanagedCallersOnly] methods
         exported as native symbols so JNI can find them via dlsym. -->
    <IlcExportUnmanagedEntrypoints>true</IlcExportUnmanagedEntrypoints>
  </PropertyGroup>

  <!-- Default property values for NativeAOT Debug configuration -->
  <PropertyGroup Condition="'$(DebugSymbols)' == 'true'">
    <NativeDebugSymbols>true</NativeDebugSymbols>
    <CompressSymbols>false</CompressSymbols>
  </PropertyGroup>

  <!-- Default feature switches -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Microsoft.Android.Runtime.RuntimeFeature.IsCoreClrRuntime"
        Value="false"
        Trim="true"
    />
    <RuntimeHostConfigurationOption Include="Microsoft.Android.Runtime.RuntimeFeature.IsNativeAotRuntime"
        Value="true"
        Trim="true"
    />
  </ItemGroup>

  <!-- Trimmable typemap: skip ILLink, ILC handles trimming directly -->
  <PropertyGroup>
    <IlcCompileDependsOn>
      _AndroidBeforeIlcCompile;
      SetupOSSpecificProps;
      ComputeIlcCompileInputs;
      _AndroidComputeIlcCompileInputs;
      $(IlcCompileDependsOn)
    </IlcCompileDependsOn>
    <_AndroidBeforeIlcCompileDependsOn>_AndroidValidateNativeAotJniInitFunctions;_CreatePropertiesCache;_AndroidResolveNdk</_AndroidBeforeIlcCompileDependsOn>
  </PropertyGroup>

  <Target Name="_AndroidValidateNativeAotJniInitFunctions"
      BeforeTargets="_GenerateTrimmableTypeMap;_GenerateJavaStubs">
    <AndroidError Code="XA1051"
        ResourceName="XA1051"
        Condition=" '@(AndroidStaticJniInitFunction->Count())' != '0' " />
  </Target>

  <Target Name="_AndroidGenerateNativeAotBootstrapSourcesInputs"
      DependsOnTargets="_GenerateJavaStubs;_GetGenerateJavaStubsInputs">
    <PropertyGroup>
      <_AndroidNativeAotBootstrapDirectory>$(IntermediateOutputPath)android</_AndroidNativeAotBootstrapDirectory>
      <_AndroidNativeAotBootstrapInputsFile>$(IntermediateOutputPath)nativeaot-bootstrap.inputs</_AndroidNativeAotBootstrapInputsFile>
    </PropertyGroup>
    <!-- Command-line library names and environment selection/order can change without newer file inputs. -->
    <WriteLinesToFile
        File="$(_AndroidNativeAotBootstrapInputsFile)"
        Lines="TargetName=$(TargetName);@(_EnvironmentFiles->'EnvironmentFile=%(FullPath)')"
        Overwrite="true"
        WriteOnlyWhenDifferent="true" />
    <!-- Task-generated provider names are not inferred when the typemap generator is skipped. -->
    <GetNativeAotRuntimeProviders MSBuildRuntime="NET" ManifestFile="$(IntermediateOutputPath)AndroidManifest.xml">
      <Output TaskParameter="AdditionalProviderSources" ItemName="_AndroidNativeAotRuntimeProvider" />
    </GetNativeAotRuntimeProviders>
    <ItemGroup>
      <_AndroidNativeAotBootstrapSource Include="$(_AndroidNativeAotBootstrapDirectory)/src/net/dot/jni/nativeaot/JavaInteropRuntime.java" />
      <_AndroidNativeAotBootstrapSource Include="$(_AndroidNativeAotBootstrapDirectory)/src/net/dot/jni/nativeaot/NativeAotEnvironmentVars.java" />
      <_AndroidNativeAotBootstrapSource Include="@(_AndroidNativeAotRuntimeProvider->'$(_AndroidNativeAotBootstrapDirectory)/src/net/dot/jni/nativeaot/%(Identity).java')" />
    </ItemGroup>
  </Target>

  <Target Name="_AndroidGenerateNativeAotBootstrapSources"
      BeforeTargets="_FindJavaStubFiles"
      DependsOnTargets="_AndroidGenerateNativeAotBootstrapSourcesInputs"
      Inputs="$(_AndroidNativeAotBootstrapInputsFile);@(_EnvironmentFiles);$(IntermediateOutputPath)AndroidManifest.xml;$(_AndroidBuildPropertiesCache);@(_AndroidMSBuildAllProjects)"
      Outputs="@(_AndroidNativeAotBootstrapSource)">
    <GenerateNativeAotBootstrapSources
        MSBuildRuntime="NET"
        OutputDirectory="$(_AndroidNativeAotBootstrapDirectory)"
        TargetName="$(TargetName)"
        Environments="@(_EnvironmentFiles)"
        AdditionalProviderSources="@(_AndroidNativeAotRuntimeProvider)" />
    <ItemGroup>
      <FileWrites Include="@(_AndroidNativeAotBootstrapSource)" />
      <FileWrites Include="$(_AndroidNativeAotBootstrapInputsFile)" />
    </ItemGroup>
  </Target>

  <Target Name="_AndroidBeforeIlcCompile"
      DependsOnTargets="$(_AndroidBeforeIlcCompileDependsOn)"
      BeforeTargets="SetupProperties">
    <!-- Example settings from: https://github.com/jonathanpeppers/Android-NativeAOT/blob/ea69d122cdc7de67aa6a5db14b7e560763c63cdd/DotNet/libdotnet.targets -->
    <PropertyGroup>
      <_NdkAbi Condition=" '$(RuntimeIdentifier)' == 'android-arm64' ">aarch64</_NdkAbi>
      <_NdkAbi Condition=" '$(RuntimeIdentifier)' == 'android-x64' ">x86_64</_NdkAbi>
      <_NdkAbi Condition=" '$(RuntimeIdentifier)' == 'android-arm' ">arm</_NdkAbi>
      <_NDKApiLevel Condition=" '$(RuntimeIdentifier)' == 'android-arm64' ">$(AndroidNdkApiLevel_Arm64)</_NDKApiLevel>
      <_NDKApiLevel Condition=" '$(RuntimeIdentifier)' == 'android-x64' ">$(AndroidNdkAPiLevel_X64)</_NDKApiLevel>
      <_NDKApiLevel Condition=" '$(RuntimeIdentifier)' == 'android-arm' ">$(AndroidNdkApiLevel_Arm)</_NDKApiLevel>
      <_NdkClangPrefix Condition=" '$(RuntimeIdentifier)' == 'android-arm64' ">aarch64-linux-android</_NdkClangPrefix>
      <_NdkClangPrefix Condition=" '$(RuntimeIdentifier)' == 'android-x64' ">x86_64-linux-android</_NdkClangPrefix>
      <_NdkClangPrefix Condition=" '$(RuntimeIdentifier)' == 'android-arm' ">armv7a-linux-androideabi</_NdkClangPrefix>
      <_NdkSysrootAbi Condition=" '$(RuntimeIdentifier)' == 'android-arm64' ">aarch64-linux-android</_NdkSysrootAbi>
      <_NdkSysrootAbi Condition=" '$(RuntimeIdentifier)' == 'android-x64' ">x86_64-linux-android</_NdkSysrootAbi>
      <_NdkSysrootAbi Condition=" '$(RuntimeIdentifier)' == 'android-arm' ">arm-linux-androideabi</_NdkSysrootAbi>

      <!-- We need to explicitly specify the extension on Windows, since some Android NDK versions
           for Windows contain bash shell scripts without the extension, in addition to the
           Windows-specific .cmd ones. We must use the latter since end users might not have bash
           installed on Windows -->
      <_NdkWrapperScriptExt Condition=" $([MSBuild]::IsOSPlatform('windows')) ">.cmd</_NdkWrapperScriptExt>
      <_NdkToolExecutableExt Condition=" $([MSBuild]::IsOSPlatform('windows')) ">.exe</_NdkToolExecutableExt>
      <_NdkSysrootDir>$(_AndroidNdkToolchainDirectory)/sysroot/usr/lib/$(_NdkSysrootAbi)/</_NdkSysrootDir>
      <_NdkBinDir>$([MSBuild]::NormalizeDirectory('$(_AndroidNdkToolchainDirectory)', 'bin'))</_NdkBinDir>

      <!--
          Don't call `clang` directly, use the wrapper scripts instead since they properly pass
          arguments required to link the application using the right API level libraries.
          Explicit tool paths avoid changing the MSBuild process's PATH.

          Also, do NOT use `clang++` here because it will link the dynamic libc++ library into the
          application. If, for some reason, `clang++` has to be used, `<LinkerArgs>` need to be
          added to pass `-nostdlib++` to it.
      -->
      <CppCompilerAndLinker>$([MSBuild]::NormalizePath('$(_NdkBinDir)', '$(_NdkClangPrefix)$(_NDKApiLevel)-clang$(_NdkWrapperScriptExt)'))</CppCompilerAndLinker>
      <CppLinker>$(CppCompilerAndLinker)</CppLinker>
      <CppLibCreator>$([MSBuild]::NormalizePath('$(_NdkBinDir)', 'llvm-ar$(_NdkToolExecutableExt)'))</CppLibCreator>
      <ObjCopyName>$(_AndroidNdkObjcopyToolPath)</ObjCopyName>
      <_AndroidIlcToolchainPath>$(_NdkBinDir)$([System.IO.Path]::PathSeparator)$([System.Environment]::GetEnvironmentVariable('PATH'))</_AndroidIlcToolchainPath>
      <_IlcEnvironmentVariables>$(_IlcEnvironmentVariables);PATH=$([MSBuild]::Escape($(_AndroidIlcToolchainPath)))</_IlcEnvironmentVariables>

      <!-- Android owns the final link, stripping, and debug sidecars. Disable ILC's unused
           stripping phase and its Windows tool probe, which rejects absolute tool paths. -->
      <StripSymbols>false</StripSymbols>

      <!-- We must ensure this is `false`, so that the compiler driver does not add libc++,
           which NativeAOT applications do not link. -->
      <LinkStandardCPlusPlusLibrary>false</LinkStandardCPlusPlusLibrary>
    </PropertyGroup>
  </Target>

  <Target Name="_AndroidComputeIlcCompileInputs">
    <ItemGroup>
      <!-- Android needs a proper soname property or it will refuse to load the library -->
      <LinkerArg Include="&quot;-Wl,-soname,lib$(TargetName).so&quot;" />
      <LinkerArg Include="-Wl,--error-unresolved-symbols" />
      <LinkerArg Include="-Wl,--no-undefined" />

      <!-- Required for [UnmanagedCallersOnly] to work inside this assembly -->
      <UnmanagedEntryPointsAssembly Include="Microsoft.Android.Runtime.NativeAOT" />

      <!-- The SDK's NativeCompile target uses _IlcManagedInputAssemblies to remove managed
           assemblies from ResolvedFileToPublish after native compilation. Clear it so the
           managed assemblies remain — the outer build needs them for _GenerateJavaStubs
           and typemap generation. -->
      <_IlcManagedInputAssemblies Remove="@(_IlcManagedInputAssemblies)" />

      <!-- Satellite assemblies -->
      <IlcSatelliteAssembly Include="$(_OuterIntermediateSatelliteAssembliesWithTargetPath)" />

      <_NdkLibs Include="@(RuntimePackAsset->WithMetadataValue('Filename', 'libnaot-android.release-static-release'))" />

      <LinkerArg Include="&quot;%(_NdkLibs.Identity)&quot;" />

      <!-- libstdc++compat.a supplies the C++ allocation ABI (operator new/delete, std::nothrow)
           that the NativeAOT runtime itself depends on.  It used to be removed here because it
           conflicts with static libc++, which we no longer link. -->

      <!-- Every p/invoke using the `xa-internal-api` "library" will be called directly -->
      <DirectPInvoke Include="xa-internal-api" />
      <!-- The managed JNI_OnLoad calls this initializer even when the app has no crypto P/Invokes. -->
      <DirectPInvoke Include="System.Security.Cryptography.Native.Android!AndroidCryptoNative_InitLibraryOnLoad" />
    </ItemGroup>
  </Target>

  <Target Name="_PrepareNativeAotAndroidAppInputs"
      DependsOnTargets="_AndroidValidateNativeAotJniInitFunctions">
    <ItemGroup>
      <_PrivateBuildTargetAbi Condition=" '$(RuntimeIdentifier)' == 'android-arm' " Include="armeabi-v7a" />
      <_PrivateBuildTargetAbi Condition=" '$(RuntimeIdentifier)' == 'android-arm64' " Include="arm64-v8a" />
      <_PrivateBuildTargetAbi Condition=" '$(RuntimeIdentifier)' == 'android-x64' " Include="x86_64" />
    </ItemGroup>
  </Target>

  <!--
    _AndroidLinkNativeAotSharedLibrary links the ILC .o output + all NativeLibrary/system
    libs into a .so.  LinkNative is overridden as a no-op in Microsoft.Android.Sdk.After.targets
    (which is imported after the ILC NuGet targets).
  -->
  <Target Name="_AndroidLinkNativeAotSharedLibraryInputs"
      DependsOnTargets="_PrepareNativeAotAndroidAppInputs;_AndroidResolveNdk">
    <PropertyGroup>
      <_AndroidNativeAotSharedLibrary>$(NativeOutputPath)$(NativeBinaryPrefix)$(TargetName).so</_AndroidNativeAotSharedLibrary>
      <_AndroidNativeAotAbi>@(_PrivateBuildTargetAbi)</_AndroidNativeAotAbi>
      <_AndroidNativeAotLinkResponseFile>$(NativeIntermediateOutputPath)ld.$([System.IO.Path]::GetFileNameWithoutExtension('$(_AndroidNativeAotSharedLibrary)')).$(_AndroidNativeAotAbi).rsp</_AndroidNativeAotLinkResponseFile>
      <_NdkApiSysrootDir>$(_NdkSysrootDir)$(_NDKApiLevel)/</_NdkApiSysrootDir>
    </PropertyGroup>

    <!-- CRT and toolchain items from NDK -->
    <ItemGroup>
      <_NativeAotCrtStartFiles Include="$(_NdkApiSysrootDir)crtbegin_so.o">
        <Abi>@(_PrivateBuildTargetAbi)</Abi>
      </_NativeAotCrtStartFiles>
      <_NativeAotCrtEndFiles Include="$(_NdkApiSysrootDir)crtend_so.o">
        <Abi>@(_PrivateBuildTargetAbi)</Abi>
      </_NativeAotCrtEndFiles>
      <_NativeAotLibSearchPaths Include="$(_NdkApiSysrootDir)" />
      <_NativeAotLibSearchPaths Include="$(_NdkSysrootDir)" />
      <_NativeAotCompilerRtLibs Include="$(_AndroidNdkClangRuntimeDirectory)/libclang_rt.builtins-$(_NdkAbi)-android.a" />
    </ItemGroup>

    <ItemGroup>
      <!-- Supplied by the SDK-resolved NativeAOT runtime pack, including the BCL native archives. -->
      <_NativeAotLinkLibraries Include="@(NativeLibrary);@(_NdkLibs)" />
      <_NativeAotSystemLibraries Include="dl" />
      <_NativeAotSystemLibraries Include="z" />
      <_NativeAotSystemLibraries Include="log" />
      <_NativeAotSystemLibraries Include="m" />
      <_NativeAotSystemLibraries Include="c" />
      <_AndroidNativeAotLinkOutputs Include="$(_AndroidNativeAotSharedLibrary)" />
      <_AndroidNativeAotLinkOutputs Include="$([System.IO.Path]::ChangeExtension('$(_AndroidNativeAotSharedLibrary)', '.dbg.so'))" Condition=" '$(AndroidIncludeDebugSymbols)' != 'true' " />
    </ItemGroup>
  </Target>

  <Target Name="_AndroidLinkNativeAotSharedLibrary"
      AfterTargets="LinkNative"
      DependsOnTargets="_AndroidLinkNativeAotSharedLibraryInputs"
      Inputs="$(NativeObject);@(_NativeAotLinkLibraries);@(_NativeAotCrtStartFiles);@(_NativeAotCrtEndFiles);@(_NativeAotCompilerRtLibs);$(ExportsFile);$(_AndroidNdkLinkerToolPath);$(_AndroidNdkObjcopyToolPath);$(_AndroidBuildPropertiesCache);$(MSBuildThisFileFullPath)"
      Outputs="@(_AndroidNativeAotLinkOutputs)">
    <LinkNativeAotSharedLibrary
        MSBuildRuntime="NET"
        LinkerToolPath="$(_AndroidNdkLinkerToolPath)"
        ObjcopyToolPath="$(_AndroidNdkObjcopyToolPath)"
        IntermediateOutputPath="$(NativeIntermediateOutputPath)"
        NativeObject="$(NativeObject)"
        OutputSharedLibrary="$(_AndroidNativeAotSharedLibrary)"
        NativeLibraries="@(_NativeAotLinkLibraries)"
        CrtStartFiles="@(_NativeAotCrtStartFiles)"
        CrtEndFiles="@(_NativeAotCrtEndFiles)"
        CompilerRuntimeLibraries="@(_NativeAotCompilerRtLibs)"
        SystemLibraries="@(_NativeAotSystemLibraries)"
        LibrarySearchPaths="@(_NativeAotLibSearchPaths)"
        ExportsFile="$(ExportsFile)"
        LinkerScript="$(NativeIntermediateOutputPath)sections.ld"
        LinkerScriptContent="OVERWRITE_SECTIONS { __modules : { KEEP(*(__modules)) } }"
        ExtraLinkerArgs="$(_AndroidNativeAotExtraLinkerArgs)"
        Abi="$(_AndroidNativeAotAbi)"
        DebugBuild="$(AndroidIncludeDebugSymbols)"
    />

    <ItemGroup>
      <FileWrites Include="@(_AndroidNativeAotLinkOutputs)" />
      <FileWrites Include="$(_AndroidNativeAotLinkResponseFile)" />
      <FileWrites Include="$(NativeIntermediateOutputPath)sections.ld" />
      <FileWrites Include="$(NativeIntermediateOutputPath)libRuntime.WorkstationGC.arm-ehabi.a" Condition=" '$(RuntimeIdentifier)' == 'android-arm' " />
    </ItemGroup>
  </Target>

  <!--
    dotnet/runtime#125629 moved the NativeAOT entry point from ComputeLinkedFilesToPublish
    (AfterTargets="ComputeResolvedFilesToPublishList") to NativeCompile (an SDK Publish hook).
    Android uses `dotnet build` not `dotnet publish`, so NativeCompile never fires.
    Restore the old scheduling so NativeCompile runs after ComputeResolvedFilesToPublishList
    in the inner per-RID build.
  -->
  <PropertyGroup>
    <_AndroidRunNativeCompileDependsOn>NativeCompile</_AndroidRunNativeCompileDependsOn>
  </PropertyGroup>
  <Target Name="_AndroidRunNativeCompile"
      AfterTargets="ComputeResolvedFilesToPublishList"
      DependsOnTargets="$(_AndroidRunNativeCompileDependsOn)" />

  <Target Name="_AndroidFixNativeLibraryFileName" AfterTargets="ComputeFilesToPublish">
    <PropertyGroup>
      <_AndroidNativeAotSharedLibraryName>lib$(TargetName).so</_AndroidNativeAotSharedLibraryName>
      <_AndroidNativeAotSharedLibrary Condition=" '$(NativeOutputPath)' != '' ">$(NativeOutputPath)$(_AndroidNativeAotSharedLibraryName)</_AndroidNativeAotSharedLibrary>
      <_AndroidNativeAotSharedLibrary Condition=" '$(NativeOutputPath)' == '' ">$(OutputPath)$(RuntimeIdentifier)/native/$(_AndroidNativeAotSharedLibraryName)</_AndroidNativeAotSharedLibrary>
    </PropertyGroup>
    <ItemGroup>
      <!-- The linker target is not always scheduled during incremental deployment builds. -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition=" '%(Filename)%(Extension)' == '$(TargetName).a' " />
      <ResolvedFileToPublish Include="$(_AndroidNativeAotSharedLibrary)" Condition=" Exists('$(_AndroidNativeAotSharedLibrary)') ">
        <RelativePath>$(_AndroidNativeAotSharedLibraryName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <!-- Fix paths to contain lib-prefix -->
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" ArchiveFileName="lib%(FileName)%(Extension)" Condition=" '%(Filename)%(Extension)' == '$(TargetName).so' " />
    </ItemGroup>
  </Target>

</Project>
