<!--
***********************************************************************************************
Xamarin.Android.EmbeddedResource.targets

This file contains MSBuild targets related to the extraction of
Android library content (resources, assets, jars, native libraries,
etc.) from referenced libraries:

* `.aar` files in @(AndroidAarLibrary), extracted by the
  `_AndroidExtractAarLibraries` target.

* "Classic" Xamarin.Android assemblies, which embed
  `__AndroidLibraryProjects__.zip`, `__AndroidNativeLibraries__.zip`
  or `.jar` files as `EmbeddedResource`s. These are only created by
  "classic" Xamarin.Android projects. We support *consuming* them in a
  backwards compatible fashion via the <ResolveLibraryProjectImports/>
  task, which warns (XA0150) that this support is deprecated.

This file is used by all project types, including binding projects.

***********************************************************************************************
-->

<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <UsingTask TaskName="Xamarin.Android.Tasks.GetImportedLibraries"                AssemblyFile="Xamarin.Android.Build.Tasks.dll" />
  <UsingTask TaskName="Xamarin.Android.Tasks.ReadImportedLibrariesCache"          AssemblyFile="Xamarin.Android.Build.Tasks.dll" />
  <UsingTask TaskName="Xamarin.Android.Tasks.ReadLibraryProjectImportsCache"      AssemblyFile="Xamarin.Android.Build.Tasks.dll" />
  <UsingTask TaskName="Xamarin.Android.Tasks.ResolveLibraryProjectImports"        AssemblyFile="Xamarin.Android.Build.Tasks.dll" />

  <PropertyGroup>
    <_LibraryProjectImportsDirectoryName Condition=" '$(_LibraryProjectImportsDirectoryName)' == '' ">jl</_LibraryProjectImportsDirectoryName>
    <_NativeLibraryImportsDirectoryName  Condition=" '$(_NativeLibraryImportsDirectoryName)' == '' ">nl</_NativeLibraryImportsDirectoryName>
    <_AndroidLibraryImportsCache>$(IntermediateOutputPath)libraryimports.cache</_AndroidLibraryImportsCache>
    <_AndroidLibraryProjectImportsCache>$(IntermediateOutputPath)libraryprojectimports.cache</_AndroidLibraryProjectImportsCache>
    <_AndroidLibrayProjectIntermediatePath Condition=" '$(_AndroidLibrayProjectIntermediatePath)' == '' ">$(IntermediateOutputPath)lp\</_AndroidLibrayProjectIntermediatePath>
    <_AndroidLibrayProjectAssemblyMapFile>$(_AndroidLibrayProjectIntermediatePath)map.cache</_AndroidLibrayProjectAssemblyMapFile>
    <!-- Must stay next to map.cache, see AssemblyIdentityMap.AarLibraryMapFileName -->
    <_AndroidAarLibraryMapFile>$(_AndroidLibrayProjectIntermediatePath)aar.map</_AndroidAarLibraryMapFile>
  </PropertyGroup>

  <Target Name="_ResolveLibraryProjectImports"
      DependsOnTargets="$(CoreResolveReferencesDependsOn)"
      Inputs="$(ProjectAssetsFile);$(MSBuildProjectFullPath);@(_MonoAndroidReferencePath);@(_MonoAndroidReferenceDependencyPaths);$(_AndroidBuildPropertiesCache)"
      Outputs="$(_AndroidStampDirectory)_ResolveLibraryProjectImports.stamp">
    <ResolveLibraryProjectImports
        ContinueOnError="$(DesignTimeBuild)"
        CacheFile="$(_AndroidLibraryProjectImportsCache)"
        Assemblies="@(_MonoAndroidReferencePath);@(_MonoAndroidReferenceDependencyPaths)"
        ImportsDirectory="$(_LibraryProjectImportsDirectoryName)"
        NativeImportsDirectory="$(_NativeLibraryImportsDirectoryName)"
        AssemblyIdentityMapFile="$(_AndroidLibrayProjectAssemblyMapFile)"
        OutputImportDirectory="$(_AndroidLibrayProjectIntermediatePath)"
    />
    <Touch Files="$(_AndroidStampDirectory)_ResolveLibraryProjectImports.stamp" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(_AndroidLibraryProjectImportsCache)"
          Condition="Exists ('$(_AndroidLibraryProjectImportsCache)')"/>
    </ItemGroup>
  </Target>

  <!--
    Each .aar is extracted to $(_AndroidLibrayProjectIntermediatePath)[id]/$(_LibraryProjectImportsDirectoryName)/,
    where [id] is a short hash of the .aar path. Files:
      [id].stamp            SHA256 of the extracted .aar; only rewritten when the .aar content changes.
                            <CollectNonEmptyDirectories/> uses it as the %(StampFile) of the res/ directory.
      [id]/extracted.stamp  Target output; touched whenever the .aar was checked.
      aar.map               [id]=[.aar path] lines, used to map lp/[id] paths in tool errors to the .aar.
  -->
  <Target Name="_AndroidExtractAarLibrariesInputs"
      DependsOnTargets="$(CoreResolveReferencesDependsOn)">
    <ItemGroup>
      <_AndroidAarLibraryImport Include="@(AndroidAarLibrary->'%(FullPath)'->Distinct())" />
      <_AndroidAarLibraryImport Remove="@(_AndroidAarLibraryImport)" Condition=" !Exists('%(Identity)') " />
      <_AndroidAarLibraryImport>
        <OriginalFile>%(Identity)</OriginalFile>
        <_AndroidImportId>$([MSBuild]::StableStringHash('%(Identity)').ToString('X8'))</_AndroidImportId>
      </_AndroidAarLibraryImport>
      <!-- .aar files may contain custom views, but resource processing is skipped by default -->
      <_AndroidAarLibraryImport Condition=" '%(_AndroidAarLibraryImport.AndroidSkipResourceProcessing)' == '' ">
        <AndroidSkipResourceProcessing>True</AndroidSkipResourceProcessing>
      </_AndroidAarLibraryImport>
      <_AndroidAarLibraryImport>
        <_AndroidImportDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(_AndroidLibrayProjectIntermediatePath)', '%(_AndroidImportId)'))</_AndroidImportDirectory>
        <_AndroidImportStamp>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(_AndroidLibrayProjectIntermediatePath)', '%(_AndroidImportId).stamp'))</_AndroidImportStamp>
      </_AndroidAarLibraryImport>
      <_AndroidAarLibraryImport>
        <_AndroidImportsDirectory>%(_AndroidImportDirectory)$(_LibraryProjectImportsDirectoryName)/</_AndroidImportsDirectory>
        <_AndroidImportExtractedStamp>%(_AndroidImportDirectory)extracted.stamp</_AndroidImportExtractedStamp>
      </_AndroidAarLibraryImport>
    </ItemGroup>
    <WriteLinesToFile
        File="$(_AndroidAarLibraryMapFile)"
        Lines="@(_AndroidAarLibraryImport->'%(_AndroidImportId)=%(Identity)')"
        Overwrite="true"
        WriteOnlyWhenDifferent="true"
    />
    <ItemGroup>
      <FileWrites Include="$(_AndroidAarLibraryMapFile)" />
    </ItemGroup>
  </Target>

  <Target Name="_AndroidExtractAarLibraries"
      DependsOnTargets="_AndroidExtractAarLibrariesInputs"
      Inputs="@(_AndroidAarLibraryImport)"
      Outputs="@(_AndroidAarLibraryImport->'%(_AndroidImportExtractedStamp)')">
    <!-- Only the .aar files that are newer than their extracted.stamp are processed here -->
    <GetFileHash Files="@(_AndroidAarLibraryImport)">
      <Output TaskParameter="Items" ItemName="_AndroidAarLibraryImportHash" />
    </GetFileHash>
    <ItemGroup>
      <_AndroidAarLibraryImportChanged
          Include="@(_AndroidAarLibraryImportHash)"
          Condition=" !Exists('%(_AndroidImportStamp)') or '$([System.IO.File]::ReadAllText(%(_AndroidImportStamp)).Trim())' != '%(FileHash)' "
      />
      <_AndroidAarLibraryImportUnchanged Include="@(_AndroidAarLibraryImportHash)" Exclude="@(_AndroidAarLibraryImportChanged)" />
    </ItemGroup>
    <!-- Changed .aar files are extracted by _AndroidExtractChangedAarLibrary, which touches their extracted.stamp on success -->
    <Touch Files="@(_AndroidAarLibraryImportUnchanged->'%(_AndroidImportExtractedStamp)')" AlwaysCreate="true" />
  </Target>

  <!--
    Batched per changed .aar, so that the [id].stamp and extracted.stamp of an .aar are only written
    when all of its steps succeeded. Errors are warnings in design-time builds, and a failed .aar is
    extracted again by the next build.
  -->
  <Target Name="_AndroidExtractChangedAarLibrary"
      Condition=" '@(_AndroidAarLibraryImportChanged->Count())' != '0' "
      Outputs="%(_AndroidAarLibraryImportChanged.Identity)">
    <PropertyGroup>
      <_AndroidAarLibraryImportsDirectory>@(_AndroidAarLibraryImportChanged->'%(_AndroidImportsDirectory)')</_AndroidAarLibraryImportsDirectory>
    </PropertyGroup>
    <RemoveDir Directories="$(_AndroidAarLibraryImportsDirectory)" ContinueOnError="$(DesignTimeBuild)" />
    <PropertyGroup>
      <_AndroidAarLibraryExtracted>$(MSBuildLastTaskResult)</_AndroidAarLibraryExtracted>
    </PropertyGroup>
    <!-- Extract everything except .jar files, then only classes.jar and libs/*.jar; other .jar files such as lint.jar are not needed -->
    <Unzip
        Condition=" '$(_AndroidAarLibraryExtracted)' == 'true' "
        ContinueOnError="$(DesignTimeBuild)"
        SourceFiles="@(_AndroidAarLibraryImportChanged)"
        DestinationFolder="$(_AndroidAarLibraryImportsDirectory)"
        Exclude="*.jar;**/*.jar;__MACOSX;__MACOSX/**;**/__MACOSX;**/__MACOSX/**;.DS_Store;**/.DS_Store"
    />
    <PropertyGroup>
      <_AndroidAarLibraryExtracted>$(MSBuildLastTaskResult)</_AndroidAarLibraryExtracted>
    </PropertyGroup>
    <Unzip
        Condition=" '$(_AndroidAarLibraryExtracted)' == 'true' "
        ContinueOnError="$(DesignTimeBuild)"
        SourceFiles="@(_AndroidAarLibraryImportChanged)"
        DestinationFolder="$(_AndroidAarLibraryImportsDirectory)"
        Include="classes.jar;libs/*.jar;libs/**/*.jar"
        Exclude="**/__MACOSX/**"
    />
    <PropertyGroup>
      <_AndroidAarLibraryExtracted>$(MSBuildLastTaskResult)</_AndroidAarLibraryExtracted>
    </PropertyGroup>
    <ItemGroup Condition=" '$(_AndroidAarLibraryExtracted)' == 'true' ">
      <_AndroidAarLibraryExtractedFile Remove="@(_AndroidAarLibraryExtractedFile)" />
      <_AndroidAarLibraryExtractedFile Include="$(_AndroidAarLibraryImportsDirectory)**" />
    </ItemGroup>
    <!-- <Unzip/> preserves the (often fixed) timestamps of .aar entries; make updated files newer than their outputs -->
    <Touch
        Condition=" '$(_AndroidAarLibraryExtracted)' == 'true' "
        ContinueOnError="$(DesignTimeBuild)"
        Files="@(_AndroidAarLibraryExtractedFile)"
    />
    <PropertyGroup>
      <_AndroidAarLibraryExtracted>$(MSBuildLastTaskResult)</_AndroidAarLibraryExtracted>
    </PropertyGroup>
    <WriteLinesToFile
        Condition=" '$(_AndroidAarLibraryExtracted)' == 'true' "
        File="@(_AndroidAarLibraryImportChanged->'%(_AndroidImportStamp)')"
        Lines="@(_AndroidAarLibraryImportChanged->'%(FileHash)')"
        Overwrite="true"
    />
    <Touch
        Condition=" '$(_AndroidAarLibraryExtracted)' == 'true' "
        Files="@(_AndroidAarLibraryImportChanged->'%(_AndroidImportExtractedStamp)')"
        AlwaysCreate="true"
    />
  </Target>

  <Target Name="_ExtractLibraryProjectImports" DependsOnTargets="_ResolveLibraryProjectImports;_AndroidExtractAarLibraries;_AndroidExtractChangedAarLibrary">
    <ReadLibraryProjectImportsCache
        CacheFile="$(_AndroidLibraryProjectImportsCache)">
      <Output TaskParameter="ResolvedResourceDirectories" ItemName="LibraryResourceDirectories" />
      <Output TaskParameter="ResolvedAssetDirectories" ItemName="LibraryAssetDirectories" />
      <Output TaskParameter="ResolvedResourceDirectoryStamps" ItemName="_LibraryResourceDirectoryStamps" />
      <Output TaskParameter="ExtractedDirectories" ItemName="_ExtractedDirectories" />
    </ReadLibraryProjectImportsCache>
    <ItemGroup>
      <_ExtractedDirectories
          Include="@(_AndroidAarLibraryImport->'%(_AndroidImportDirectory)')"
          KeepMetadata="OriginalFile;NuGetPackageId;NuGetPackageVersion"
      />
      <LibraryResourceDirectories
          Include="@(_AndroidAarLibraryImport->'%(_AndroidImportsDirectory)res')"
          Condition=" Exists('%(_AndroidAarLibraryImport._AndroidImportsDirectory)res') or Exists('%(_AndroidAarLibraryImport._AndroidImportsDirectory)R.txt') "
          KeepMetadata="OriginalFile;AndroidSkipResourceProcessing;NuGetPackageId;NuGetPackageVersion"
      />
      <!-- Include the stamp of every .aar, so removing all resources from an .aar still invalidates resource generation -->
      <_LibraryResourceDirectoryStamps
          Include="@(_AndroidAarLibraryImport->'%(_AndroidImportStamp)')"
          Condition=" Exists('%(_AndroidAarLibraryImport._AndroidImportStamp)') "
          KeepMetadata="OriginalFile"
      />
      <LibraryAssetDirectories
          Include="@(_AndroidAarLibraryImport->'%(_AndroidImportsDirectory)assets')"
          Condition=" Exists('%(_AndroidAarLibraryImport._AndroidImportsDirectory)assets') "
          KeepMetadata="OriginalFile;NuGetPackageId;NuGetPackageVersion"
      />
    </ItemGroup>
    <ItemGroup Condition=" '@(_AndroidAarLibraryImport->Count())' != '0' ">
      <LibraryEnvironments
          Include="%(_AndroidAarLibraryImport._AndroidImportsDirectory).net/env/**"
          OriginalFile="%(_AndroidAarLibraryImport.OriginalFile)"
          NuGetPackageId="%(_AndroidAarLibraryImport.NuGetPackageId)"
          NuGetPackageVersion="%(_AndroidAarLibraryImport.NuGetPackageVersion)"
      />
      <ProguardConfiguration
          Include="@(_AndroidAarLibraryImport->'%(_AndroidImportsDirectory)proguard.txt')"
          Condition=" '$(AndroidApplication)' == 'true' and Exists('%(_AndroidAarLibraryImport._AndroidImportsDirectory)proguard.txt') "
          KeepMetadata="OriginalFile;NuGetPackageId;NuGetPackageVersion"
      />
    </ItemGroup>
  </Target>

  <Target Name="_BuildLibraryImportsCache"
      Inputs="$(_AndroidLibraryProjectImportsCache);$(_AndroidAarLibraryMapFile);@(_AndroidAarLibraryImport->'%(_AndroidImportStamp)')"
      Outputs="$(_AndroidStampDirectory)_BuildLibraryImportsCache.stamp">
    <GetImportedLibraries
        ExtractedDirectories="@(_ExtractedDirectories)"
        CacheFile="$(_AndroidLibraryImportsCache)"
    />
    <Touch Files="$(_AndroidStampDirectory)_BuildLibraryImportsCache.stamp" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(_AndroidStampDirectory)_BuildLibraryImportsCache.stamp" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <_GetLibraryImportsDependsOnTargets>
      _ExtractLibraryProjectImports;
      _AddMultiDexDependencyJars;
      _BuildLibraryImportsCache;
    </_GetLibraryImportsDependsOnTargets>
  </PropertyGroup>

  <Target Name="_GetLibraryImports" DependsOnTargets="$(_GetLibraryImportsDependsOnTargets)">
    <ReadImportedLibrariesCache CacheFile="$(_AndroidLibraryImportsCache)">
      <Output TaskParameter="Jars"              ItemName="ExtractedJarImports" />
      <Output TaskParameter="NativeLibraries"   ItemName="ExtractedNativeLibraryImports" />
      <Output TaskParameter="NativeLibraries"   ItemName="AndroidNativeLibrary" />
      <Output TaskParameter="ManifestDocuments" ItemName="ExtractedManifestDocuments" />
    </ReadImportedLibrariesCache>
  </Target>

</Project>
