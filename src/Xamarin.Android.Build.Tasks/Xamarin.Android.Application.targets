<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="StartAndroidActivity" DependsOnTargets="Run" />
  <Target Name="StopAndroidPackage"
      DependsOnTargets="_ResolveMonoAndroidSdks;_GetAndroidPackageName;_AndroidAdbToolPath">
    <Exec Command="&quot;$(_AdbToolPath)&quot; $(AdbTarget) shell am force-stop &quot;$(_AndroidPackage)&quot;" StandardOutputImportance="Low" />
  </Target>
</Project>
