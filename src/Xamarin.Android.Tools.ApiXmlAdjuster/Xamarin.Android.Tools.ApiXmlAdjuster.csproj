<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\Configuration.props" />

  <PropertyGroup>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>11.0.0</Version>
    <LangVersion>13.0</LangVersion>
    <TargetFramework>$(DotNetStableTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <!-- Use SDK analyzer defaults instead of the repository's legacy severity overrides. -->
    <DiscoverEditorConfigFiles>false</DiscoverEditorConfigFiles>
  </PropertyGroup>

  <PropertyGroup>
    <OutputPath>$(TestOutputDirectory)$(DotNetStableTargetFramework)\</OutputPath>
  </PropertyGroup>

</Project>
