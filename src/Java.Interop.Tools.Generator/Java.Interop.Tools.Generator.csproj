<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\Configuration.props" />

  <PropertyGroup>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>11.0.0</Version>
    <LangVersion>13.0</LangVersion>
    <TargetFramework>$(DotNetStableTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <Features>$(Features);updated-memory-safety-rules</Features>
  </PropertyGroup>

  <PropertyGroup>
    <OutputPath>$(MicrosoftAndroidSdkOutDir)</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Java.Interop.Localization\Java.Interop.Localization.csproj" />
  </ItemGroup>

</Project>
