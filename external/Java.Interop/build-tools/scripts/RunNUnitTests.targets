<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="RunTests" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import
      Condition=" Exists('..\..\bin\Build$(Configuration)\PackagePaths.props') "
      Project="..\..\bin\Build$(Configuration)\PackagePaths.props"
  />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <_TopDir>$(MSBuildThisFileDirectory)..\..</_TopDir>
    <DotnetToolPath Condition=" '$(DotnetToolPath)' == '' ">dotnet</DotnetToolPath>
    <_Run Condition=" '$(RUN)' != '' ">--filter &quot;FullyQualifiedName~$(RUN)&quot;</_Run>
  </PropertyGroup>
  <Import
      Condition=" Exists('..\..\bin\Build$(Configuration)\JdkInfo.props') "
      Project="..\..\bin\Build$(Configuration)\JdkInfo.props"
  />
  <ItemGroup>
    <_TestAssembly Include="$(_TopDir)\bin\Test$(Configuration)-net10.0\*-*Tests.dll;$(_TopDir)\bin\Test$(Configuration)-net11.0\*-*Tests.dll" Condition=" '$(TestAssembly)' == '' " />
    <_TestAssembly Include="$(TestAssembly)" Condition=" '$(TestAssembly)' != '' " />
  </ItemGroup>
  <Target Name="RunTests"
      Outputs="$(_TopDir)\TestResult-%(_TestAssembly.Filename).xml">
    <Exec
        Command="&quot;$(DotnetToolPath)&quot; test &quot;%(_TestAssembly.Identity)&quot; $(NUNIT_EXTRA) $(_Run) --logger &quot;trx;LogFileName=TestResult-%(_TestAssembly.Filename).trx&quot; --results-directory &quot;%(_TestAssembly.RootDir)%(_TestAssembly.Directory)&quot;"
        EnvironmentVariables="ANDROID_SDK_PATH=$(AndroidSdkDirectory);MONO_TRACE_LISTENER=Console.Out;JAVA_INTEROP_GREF_LOG=%(_TestAssembly.RootDir)%(_TestAssembly.Directory)g-%(_TestAssembly.Filename).txt;JAVA_INTEROP_LREF_LOG=%(_TestAssembly.RootDir)%(_TestAssembly.Directory)l-%(_TestAssembly.Filename).txt;JI_JVM_PATH=$(JdkJvmPath)"
        WorkingDirectory="$(_TopDir)"
        ContinueOnError="ErrorAndContinue"
    />
    <MSBuild
        Condition=" '$(SkipJSUTests)' != 'true' "
        Projects="$(MSBuildThisFileDirectory)..\..\tools\java-source-utils\java-source-utils.csproj"
        Targets="RunTests"
    />
  </Target>
</Project>