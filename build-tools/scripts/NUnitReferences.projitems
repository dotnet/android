<Project>
  <!-- This file assumes Configuration.props has been imported -->
  <ItemGroup>
    <PackageReference Include="NUnit"               Version="$(NUnitVersion)" />
    <PackageReference Include="NUnit.ConsoleRunner" Version="$(NUnitConsoleVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.5.0" />
  </ItemGroup>
  <ItemGroup Condition=" '$(EnableNUnitRunner)' != 'true' ">
    <PackageReference Include="NUnit3TestAdapter"   Version="4.4.2" />
  </ItemGroup>
  <!-- EnableNUnitRunner=true runs with Microsoft.Testing.Platform (`dotnet Foo.dll`) and with VSTest (`dotnet test Foo.dll`) -->
  <ItemGroup Condition=" '$(EnableNUnitRunner)' == 'true' ">
    <PackageReference Include="NUnit3TestAdapter"   Version="6.3.1" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3" />
  </ItemGroup>
</Project>