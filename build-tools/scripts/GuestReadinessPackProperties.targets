<Project>
  <Target Name="_GuestReadinessPackProperties" BeforeTargets="_SetGlobalProperties"
      Condition=" '$(AndroidGuestReadinessBuild)' == 'true' ">
    <Error Condition=" !$([System.Text.RegularExpressions.Regex]::IsMatch('$(AndroidPackVersionLong)', '\A36\.1\.69-guest\.[1-9][0-9]{0,11}\.[1-9][0-9]{0,3}\z')) "
        Text="Guest readiness requires a canonical unique package version." />
    <Error Condition=" '$(PackageVersion)' != '$(AndroidPackVersionLong)' "
        Text="Guest readiness package versions must agree." />
    <Error Condition=" !$([System.Text.RegularExpressions.Regex]::IsMatch('$(AndroidStartupDiagnosticsBuildId)', '\Aandroid-d549-[1-9][0-9]{0,11}-[1-9][0-9]{0,3}\z')) "
        Text="Guest readiness requires its validated producer marker." />
    <Error Condition=" '$(AndroidStartupDiagnosticsBuildId)' != 'android-d549-$(AndroidPackVersionLong.Replace(`36.1.69-guest.`, ``).Replace(`.`, `-`))' "
        Text="Guest readiness version and marker must bind the same build and attempt." />
    <ItemGroup>
      <_GlobalProperties Include="-p:AndroidGuestReadinessBuild=true" />
      <_GlobalProperties Include="-p:AndroidPackVersionLong=$(AndroidPackVersionLong)" />
      <_GlobalProperties Include="-p:PackageVersion=$(PackageVersion)" />
      <_GlobalProperties Include="-p:AndroidStartupDiagnosticsBuildId=$(AndroidStartupDiagnosticsBuildId)" />
      <_GlobalProperties Include="-p:RunningOnCI=true" />
    </ItemGroup>
  </Target>
</Project>
