<Project>
  <Import Project="XAVersionInfo.targets" />
  <PropertyGroup>
    <_Root>$(MSBuildThisFileDirectory)..\..\</_Root>
    <_BinlogPathPrefix>$(_Root)bin/Build$(Configuration)/msbuild-$([System.DateTime]::Now.ToString("yyyyMMddTHHmmss"))</_BinlogPathPrefix>
    <MauiUseLocalPacks Condition=" '$(MauiUseLocalPacks)' == '' ">false</MauiUseLocalPacks>
    <MauiSourcePath Condition=" '$(MauiSourcePath)' == '' ">$(_Root)..\maui</MauiSourcePath>
    <!-- Arcade SDK outputs packages to artifacts/packages/Configuration/Shipping/ -->
    <MauiPackagePath Condition=" '$(MauiPackagePath)' == '' ">$(MauiSourcePath)\artifacts\packages\$(Configuration)\Shipping</MauiPackagePath>
    <MauiWorkloadToInstall Condition=" '$(MauiWorkloadToInstall)' == '' ">maui-android</MauiWorkloadToInstall>
  </PropertyGroup>

  <Target Name="PrepareOpenJDK">
    <!-- Build out of process so NuGet-generated props are evaluated after restore. -->
    <Exec
        Command="&quot;$(DotNetPreviewTool)&quot; build &quot;$(_Root)src\openjdk\openjdk.csproj&quot; -p:Configuration=$(Configuration) -bl:$(_BinlogPathPrefix)-openjdk.binlog"
        WorkingDirectory="$(_Root)"
    />
  </Target>

  <!-- Build Mono.Android.dll for additional API levels if necessary -->
  <Target Name="BuildExtraApiLevels"
      Inputs="@(AndroidBuildApiLevel)"
      Outputs="$(_MonoAndroidNETOutputRoot)%(AndroidBuildApiLevel.Identity)\Mono.Android.dll">
    <MSBuild
         Condition=" '%(AndroidBuildApiLevel.Identity)' != '$(AndroidApiLevel)' "
         Projects="$(_Root)src\Mono.Android\Mono.Android.csproj"
         Properties="AndroidApiLevel=%(AndroidBuildApiLevel.Identity);AndroidPlatformId=%(AndroidBuildApiLevel.PlatformId);AndroidFrameworkVersion=%(AndroidBuildApiLevel.FrameworkVersion);IsUnstableVersion=%(AndroidBuildApiLevel.Unstable)"
    />
  </Target>

  <Target Name="UpdateMauiWorkloadsProj">
    <XmlPoke
      XmlInputPath="$(MauiSourcePath)\src\DotNet\Dependencies\Workloads.csproj"
      Value="Microsoft.NET.Sdk.Android.Manifest-$(DotNetAndroidManifestVersionBand)"
      Query="/Project/ItemGroup/PackageDownload[contains(@Include,'Microsoft.NET.Sdk.Android.Manifest-')]/@Include" />
    <XmlPeek
        XmlInputPath="$(_Root)NuGet.config"
        Query="/configuration/packageSources/add[starts-with(@key,'darc-pub-')]">
      <Output TaskParameter="Result" ItemName="_DotNetAndroidFeeds" />
    </XmlPeek>
    <XmlPeek
        Condition=" '@(_DotNetAndroidFeeds->Count())' != '0' "
        XmlInputPath="$(MauiSourcePath)\NuGet.config"
        Query="/configuration/packageSources/*">
      <Output TaskParameter="Result" ItemName="_DotNetMauiFeeds" />
    </XmlPeek>
    <ItemGroup>
      <_DotNetMauiFeeds Include="@(_DotNetAndroidFeeds)" />
    </ItemGroup>
    <XmlPoke
        Condition=" '@(_DotNetAndroidFeeds->Count())' != '0' "
        XmlInputPath="$(MauiSourcePath)\NuGet.config"
        Value="@(_DotNetMauiFeeds, ' ')"
        Query="/configuration/packageSources"
    />
  </Target>

  <Target Name="InstallMaui" DependsOnTargets="GetXAVersionInfo">
    <Error Text="%24(MauiVersion) must be specified." Condition=" '$(MauiVersion)' == '' and '$(MauiUseLocalPacks)' != 'true' " />
    <PropertyGroup>
      <_TempDirectory>$(BootstrapOutputDirectory).xa-workload-temp-$([System.IO.Path]::GetRandomFileName())</_TempDirectory>
      <MauiVersionBand Condition=" '$(MauiVersionBand)' == '' ">$(DotNetSdkManifestsFolder)</MauiVersionBand>
      <_MauiWorkloadRoot>$(BuildOutputDirectory)lib</_MauiWorkloadRoot>
      <_MauiWorkloadRoot Condition=" Exists('$(BuildOutputDirectory)workload/sdk-manifests') ">$(BuildOutputDirectory)workload</_MauiWorkloadRoot>
      <_MauiAndroidManifestFolder>$(_MauiWorkloadRoot)/sdk-manifests/$(DotNetSdkManifestsFolder)/microsoft.net.sdk.android/$(AndroidPackVersionLong)/</_MauiAndroidManifestFolder>
    </PropertyGroup>
    <MakeDir Directories="$(_TempDirectory)" />

    <!-- Restore or extract WorkloadManifest.* files-->
    <Exec
        Condition=" '$(MauiUseLocalPacks)' != 'true' "
        Command="&quot;$(DotNetPreviewTool)&quot; restore maui.proj -p:MauiVersion=$(MauiVersion) -p:MauiVersionBand=$(MauiVersionBand)"
        WorkingDirectory="$(MSBuildThisFileDirectory)"
        EnvironmentVariables="NUGET_PACKAGES=$(_TempDirectory);DOTNET_MULTILEVEL_LOOKUP=0"
    />
    <ItemGroup>
      <_WLManifestPack Condition=" '$(MauiUseLocalPacks)' == 'true' " Include="$(MauiPackagePath)\Microsoft.NET.Sdk.Maui.Manifest-*.nupkg" />
    </ItemGroup>
    <Error
        Condition=" '$(MauiUseLocalPacks)' == 'true' and '@(_WLManifestPack->Count())' != '1' "
        Text="Expected exactly one local .NET MAUI workload manifest package in '$(MauiPackagePath)', found @(_WLManifestPack->Count())." />
    <Unzip
        Condition=" '$(MauiUseLocalPacks)' == 'true' "
        SourceFiles="@(_WLManifestPack)"
        DestinationFolder="$(_TempDirectory)"
    />
    <Error
        Condition=" '$(MauiUseLocalPacks)' == 'true' and !Exists('$(_TempDirectory)\data\WorkloadManifest.json') "
        Text="The local .NET MAUI manifest package '@(_WLManifestPack)' does not contain data\WorkloadManifest.json." />

    <!-- Copy WorkloadManifest.* files-->
    <ItemGroup>
      <_WLManifest Condition=" '$(MauiUseLocalPacks)' != 'true' " Include="$(_TempDirectory)\microsoft.net.sdk.maui.manifest-$(MauiVersionBand)\$(MauiVersion)\data\WorkloadManifest.*" />
      <_WLManifest Condition=" '$(MauiUseLocalPacks)' == 'true' " Include="$(_TempDirectory)\data\*" />
    </ItemGroup>
    <!-- Copy manifest to diagnostics folder if specified -->
    <Copy Condition=" '$(MauiManifestDiagnosticsPath)' != '' " SourceFiles="@(_WLManifest)" DestinationFolder="$(MauiManifestDiagnosticsPath)" />
    <Copy SourceFiles="@(_WLManifest)" DestinationFolder="$(_MauiWorkloadRoot)/sdk-manifests/$(DotNetSdkManifestsFolder)/microsoft.net.sdk.maui/$(MauiVersion)/" />
    <MSBuild Projects="$(XamarinAndroidSourcePath)build-tools/create-packs/Microsoft.Android.Sdk.proj"
        Targets="InstallWorkloadPacks"
        Properties="_WorkloadPackRoot=$(_MauiWorkloadRoot);_LocalAndroidManifestFolder=$(_MauiAndroidManifestFolder);_WorkloadToInstall=$(MauiWorkloadToInstall);MauiUseLocalPacks=$(MauiUseLocalPacks);MauiPackagePath=$(MauiPackagePath);MauiSourcePath=$(MauiSourcePath)" />
    <RemoveDir Directories="$(_TempDirectory)" />
  </Target>
</Project>
