<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <TargetName>android.@VSMAN_VERSION@</TargetName>
    <ManifestBuildVersion>@WORKLOAD_VERSION@</ManifestBuildVersion>
    <EnableSideBySideManifests>true</EnableSideBySideManifests>
    <UseVisualStudioComponentPrefix>false</UseVisualStudioComponentPrefix>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shorten package names to avoid long path caching issues in Visual Studio -->
    <ShortNames Include="@PACK_VERSION_LONG@">
      <Replacement>@PACK_VERSION_SHORT@</Replacement>
    </ShortNames>
    <ShortNames Include="Microsoft.NET.Sdk.Android.Manifest">
      <Replacement>Android.Manifest</Replacement>
    </ShortNames>
    <ComponentResources Include="android" Version="@WORKLOAD_VERSION@" Category=".NET" Title=".NET SDK for Android" Description=".NET SDK Workload for building Android applications."/>
    <WorkloadPackages Include="$(NuGetPackagePath)\Microsoft.NET.Sdk.Android.Manifest*.nupkg" Version="@WORKLOAD_VERSION@" SupportsMachineArch="true" />
  </ItemGroup>

  <!-- Adding 100 to the product major keeps stable MSIs above shipped previews.
       MSI major <= 255 limits the product major to 155 (255 - 100). -->
  <Target Name="_AndroidSetNet11StableManifestMsiVersion"
      BeforeTargets="_SetMsiVersionFromNuGetVersion;_CreateManifestMsiVersionsWithDateTime;_SetStableMsiVersions;_SetPreviewMsiVersions">
    <ItemGroup>
      <WorkloadPackages Condition="'%(WorkloadPackages.Filename)' == 'Microsoft.NET.Sdk.Android.Manifest-11.0.100.@PACK_VERSION_LONG@'
          and '%(WorkloadPackages.MsiVersion)' == ''">
        <_AndroidMsiMajor>$([MSBuild]::Add($([System.Version]::Parse('%(WorkloadPackages.Version)').Major), 100))</_AndroidMsiMajor>
        <_AndroidMsiMinor>$([System.Version]::Parse('%(WorkloadPackages.Version)').Minor)</_AndroidMsiMinor>
        <_AndroidMsiPatch>$([System.Version]::Parse('%(WorkloadPackages.Version)').Build)</_AndroidMsiPatch>
      </WorkloadPackages>
    </ItemGroup>
    <Error
        Condition="'%(WorkloadPackages._AndroidMsiMajor)' != ''
          and (%(WorkloadPackages._AndroidMsiMajor) &gt; 255 or %(WorkloadPackages._AndroidMsiMinor) &gt; 255
            or %(WorkloadPackages._AndroidMsiPatch) &lt; 0 or %(WorkloadPackages._AndroidMsiPatch) &gt; 65535)"
        Text="The stable Android manifest MSI version %(WorkloadPackages._AndroidMsiMajor).%(WorkloadPackages._AndroidMsiMinor).%(WorkloadPackages._AndroidMsiPatch)
          for %(WorkloadPackages.Identity) exceeds Windows Installer limits (major/minor: 0-255, patch: 0-65535)." />
    <ItemGroup>
      <WorkloadPackages Condition="'%(WorkloadPackages._AndroidMsiMajor)' != ''">
        <MsiVersion>%(WorkloadPackages._AndroidMsiMajor).%(WorkloadPackages._AndroidMsiMinor).%(WorkloadPackages._AndroidMsiPatch)</MsiVersion>
      </WorkloadPackages>
    </ItemGroup>
  </Target>
</Project>
