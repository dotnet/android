<Project DefaultTargets="Test">
  <PropertyGroup>
    <_TestRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', '..', 'bin', 'BuildDebug', 'ManifestMsiVersionTests'))</_TestRoot>
    <_Template>$(MSBuildThisFileDirectory)..\vs-workload.in.props</_Template>
    <NuGetPackagePath Condition="'$(TestProps)' != ''">$([System.IO.Path]::GetDirectoryName('$(TestProps)'))</NuGetPackagePath>
    <WorkloadMsiGenProps>$(TestProps)</WorkloadMsiGenProps>
    <ArtifactsDir>$(_TestRoot)adapter</ArtifactsDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <WorkloadPackages>
      <MsiVersion>$(ExplicitMsiVersion)</MsiVersion>
    </WorkloadPackages>
  </ItemDefinitionGroup>
  <Import Project="$(TestProps)" Condition="'$(TestProps)' != '' and '$(ConverterTarget)' != '_SetStableMsiVersions'" />

  <UsingTask TaskName="Xamarin.Android.BuildTools.PrepTasks.ReplaceFileContents"
      TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)..\..\xa-prep-tasks\Xamarin.Android.BuildTools.PrepTasks\ReplaceFileContents.cs" />
    </Task>
  </UsingTask>

  <ItemDefinitionGroup>
    <Case>
      <Band>11.0.100</Band>
      <Version>37.2.29</Version>
      <Expected>137.2.29</Expected>
      <Explicit />
      <Late />
      <Previous />
      <Invalid>false</Invalid>
    </Case>
  </ItemDefinitionGroup>
  <ItemGroup Condition="'$(TestProps)' == ''">
    <Case Include="ga" Previous="40.128.60116" />
    <Case Include="servicing" Version="37.2.30" Expected="137.2.30" Previous="137.2.29" />
    <Case Include="next-major" Version="38.0.0" Expected="138.0.0" Previous="137.2.30" />
    <Case Include="patch15" Version="37.2.15" Expected="137.2.15" />
    <Case Include="patch16" Version="37.2.16" Expected="137.2.16" Previous="137.2.15" />
    <Case Include="patch31" Version="37.2.31" Expected="137.2.31" />
    <Case Include="patch32" Version="37.2.32" Expected="137.2.32" Previous="137.2.31" />
    <Case Include="patch255" Version="37.2.255" Expected="137.2.255" />
    <Case Include="patch256" Version="37.2.256" Expected="137.2.256" Previous="137.2.255" />
    <Case Include="msi-limit" Version="155.255.65535" Expected="255.255.65535" />
    <Case Include="override" Explicit="200.3.400" Expected="200.3.400" />
    <Case Include="late-override" Late="200.3.400" Expected="200.3.400" />
    <Case Include="override-outside-offset-range" Version="156.2.29" Explicit="200.3.400" Expected="200.3.400" />
    <Case Include="rc2" Band="11.0.100-rc.2" Expected="" />
    <Case Include="preview" Band="11.0.100-preview.7" Expected="" />
    <Case Include="older-band" Band="10.0.100" Expected="" />
    <Case Include="other-band" Band="11.0.200" Expected="" />
    <Case Include="major-overflow" Version="156.2.29" Invalid="true" />
    <Case Include="minor-overflow" Version="37.256.29" Invalid="true" />
    <Case Include="patch-overflow" Version="37.2.65536" Invalid="true" />
  </ItemGroup>

  <Target Name="_GenerateTestProps"
      Inputs="$(MSBuildProjectFullPath);$(_Template);$(MSBuildThisFileDirectory)..\..\xa-prep-tasks\Xamarin.Android.BuildTools.PrepTasks\ReplaceFileContents.cs"
      Outputs="@(Case->'$(_TestRoot)%(Identity)/vs-workload.props')">
    <MakeDir Directories="@(Case->'$(_TestRoot)%(Identity)')" />
    <Touch Files="@(Case->'$(_TestRoot)%(Identity)/Microsoft.NET.Sdk.Android.Manifest-%(Band).%(Version).nupkg')" AlwaysCreate="true" />
    <!-- A second band in the same directory must not inherit the stable override. -->
    <Touch Files="@(Case->'$(_TestRoot)%(Identity)/Microsoft.NET.Sdk.Android.Manifest-9.0.100.%(Version).nupkg')" AlwaysCreate="true" />
    <ReplaceFileContents
        SourceFile="$(_Template)"
        DestinationFile="$(_TestRoot)%(Case.Identity)/vs-workload.props"
        Replacements="@PACK_VERSION_LONG@=%(Case.Version);@PACK_VERSION_SHORT@=%(Case.Version);@WORKLOAD_VERSION@=%(Case.Version).0;@VSMAN_VERSION@=net11.0" />
  </Target>

  <Target Name="Test" DependsOnTargets="_GenerateTestProps">
    <ItemGroup>
      <_TestProject Include="$(MSBuildProjectFullPath)" Condition="'%(Case.Invalid)' != 'true'">
        <AdditionalProperties>TestProps=$(_TestRoot)%(Case.Identity)/vs-workload.props;TestVersion=%(Case.Version);TestBand=%(Case.Band);Expected=%(Case.Expected);ExplicitMsiVersion=%(Case.Explicit);LateMsiVersion=%(Case.Late);PreviousMsiVersion=%(Case.Previous)</AdditionalProperties>
      </_TestProject>
    </ItemGroup>
    <MSBuild Projects="@(_TestProject)" Targets="AssertPolicy" Properties="ConverterTarget=_SetMsiVersionFromNuGetVersion" />
    <MSBuild Projects="@(_TestProject)" Targets="AssertPolicy" Properties="ConverterTarget=_CreateManifestMsiVersionsWithDateTime" />
    <MSBuild Projects="@(_TestProject)" Targets="AssertPolicy" Properties="ConverterTarget=_SetStableMsiVersions" />
    <MSBuild Projects="@(_TestProject)" Targets="AssertPolicy" Properties="ConverterTarget=_SetPreviewMsiVersions" />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="AssertInvalid"
        Properties="TestProps=$(_TestRoot)%(Case.Identity)/vs-workload.props"
        Condition="'%(Case.Invalid)' == 'true'" />
    <Message Text="All @(Case->Count()) manifest MSI version cases passed." Importance="high" />
  </Target>

  <!-- Stand-ins exercise the shared-template hooks and the encoded-preview hook.
       Import the actual in-repo stable converter below; no signing tasks are run. -->
  <Target Name="_SetMsiVersionFromNuGetVersion" />
  <Target Name="_CreateManifestMsiVersionsWithDateTime" />
  <Target Name="_SetStableMsiVersions" />
  <Target Name="_SetPreviewMsiVersions" />
  <Import Project="..\..\automation\dnceng\arcade\Workloads.proj"
      Condition="'$(TestProps)' != '' and '$(ConverterTarget)' == '_SetStableMsiVersions'" />
  <ItemGroup Condition="'$(LateMsiVersion)' != ''">
    <WorkloadPackages Update="$(NuGetPackagePath)\Microsoft.NET.Sdk.Android.Manifest-$(TestBand).$(TestVersion).nupkg">
      <MsiVersion>$(LateMsiVersion)</MsiVersion>
    </WorkloadPackages>
  </ItemGroup>

  <Target Name="AssertPolicy"
      DependsOnTargets="$(ConverterTarget)">
    <PropertyGroup>
      <_ExpectedMsiVersion>$(Expected)</_ExpectedMsiVersion>
      <_ExpectedOtherMsiVersion>$(ExplicitMsiVersion)</_ExpectedOtherMsiVersion>
      <_ExpectedMsiVersion Condition="'$(ConverterTarget)' == '_SetStableMsiVersions' and '$(Expected)' == '' and !$(TestBand.Contains('-'))">$(TestVersion)</_ExpectedMsiVersion>
      <_ExpectedOtherMsiVersion Condition="'$(ConverterTarget)' == '_SetStableMsiVersions' and '$(ExplicitMsiVersion)' == ''">$(TestVersion)</_ExpectedOtherMsiVersion>
    </PropertyGroup>
    <Error Condition="'@(WorkloadPackages->Count())' != '2'" Text="Expected the tested manifest and an unrelated manifest." />
    <Error Condition="'%(WorkloadPackages.Filename)' == 'Microsoft.NET.Sdk.Android.Manifest-$(TestBand).$(TestVersion)' and '%(WorkloadPackages.MsiVersion)' != '$(_ExpectedMsiVersion)'"
        Text="Expected MSI $(_ExpectedMsiVersion), got %(WorkloadPackages.MsiVersion) for %(WorkloadPackages.Identity)." />
    <Error Condition="'%(WorkloadPackages.Filename)' == 'Microsoft.NET.Sdk.Android.Manifest-9.0.100.$(TestVersion)' and '%(WorkloadPackages.MsiVersion)' != '$(_ExpectedOtherMsiVersion)'"
        Text="An unrelated manifest band was changed." />
    <Error Condition="'%(WorkloadPackages.Version)' != '$(TestVersion).0' or '%(WorkloadPackages.SupportsMachineArch)' != 'true'"
        Text="Public workload metadata was changed." />
    <Error Condition="'$(ManifestBuildVersion)' != '$(TestVersion).0' or '$(TargetName)' != 'android.net11.0'"
        Text="Outer drop metadata was changed." />
    <Error Condition="'$(PreviousMsiVersion)' != '' and '%(WorkloadPackages.Filename)' == 'Microsoft.NET.Sdk.Android.Manifest-$(TestBand).$(TestVersion)' and '%(WorkloadPackages.MsiVersion)' &lt;= '$(PreviousMsiVersion)'"
        Text="MSI %(WorkloadPackages.MsiVersion) must upgrade $(PreviousMsiVersion)." />
  </Target>

  <Target Name="AssertInvalid">
    <Exec Command="dotnet &quot;$(MSBuildToolsPath)/MSBuild.dll&quot; &quot;$(MSBuildProjectFullPath)&quot; -nologo -v:minimal -t:_SetMsiVersionFromNuGetVersion -p:TestProps=&quot;$(TestProps)&quot;"
        IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"
        StandardOutputImportance="low" StandardErrorImportance="low" ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" PropertyName="_InvalidExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="_InvalidOutput" />
    </Exec>
    <Error Condition="'$(_InvalidExitCode)' == '0'" Text="An out-of-range MSI version was accepted." />
    <PropertyGroup>
      <_InvalidOutputText>@(_InvalidOutput)</_InvalidOutputText>
    </PropertyGroup>
    <Error Condition="!$(_InvalidOutputText.Contains('exceeds Windows Installer limits'))"
        Text="Expected the MSI bounds diagnostic, got: @(_InvalidOutput)" />
  </Target>
</Project>
