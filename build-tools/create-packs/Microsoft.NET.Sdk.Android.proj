<!--
***********************************************************************************************
Microsoft.NET.Sdk.Android.proj

This project file is used to create the Microsoft.NET.Sdk.Android
NuGet, which is the workload manifest pack containing information
about the various Microsoft.Android workloads.
***********************************************************************************************
-->
<Project Sdk="Microsoft.Build.NoTargets">

  <PropertyGroup>
    <PackageId>Microsoft.NET.Sdk.Android.Manifest-$(DotNetAndroidManifestVersionBand)</PackageId>
    <Description>Microsoft.NET.Sdk.Android workload manifest. Please do not reference directly.</Description>
  </PropertyGroup>

  <UsingTask AssemblyFile="$(PrepTasksAssembly)" TaskName="Xamarin.Android.BuildTools.PrepTasks.ReplaceFileContents" TaskFactory="TaskHostFactory" Runtime="NET" />

  <PropertyGroup>
    <BeforePack>
      _GenerateXAWorkloadContent;
      $(BeforePack);
    </BeforePack>
  </PropertyGroup>

  <Target Name="_GenerateXAWorkloadContent"
      DependsOnTargets="_GetDefaultPackageVersion;_GetLicense;_CreateItemGroups">
    <PropertyGroup>
      <WorkloadDependenciesPath Condition="'$(WorkloadDependenciesPath)' == ''">$(OutputPath)workload-manifest\WorkloadDependencies.json</WorkloadDependenciesPath>
      <WorkloadManifestJsonPath Condition="'$(WorkloadManifestJsonPath)' == ''">$(OutputPath)workload-manifest\WorkloadManifest.json</WorkloadManifestJsonPath>
      <_AndroidWorkloadManifestLocalizationPath>$([System.IO.Path]::GetDirectoryName('$(WorkloadManifestJsonPath)'))\localize</_AndroidWorkloadManifestLocalizationPath>
      <WorkloadManifestTargetsPath Condition="'$(WorkloadManifestTargetsPath)' == ''">$(OutputPath)workload-manifest\WorkloadManifest.targets</WorkloadManifestTargetsPath>
      <WorkloadVersion Condition="'$(WorkloadVersion)' == ''">$(AndroidPackVersionLong)</WorkloadVersion>
    </PropertyGroup>
    <ItemGroup>
      <_DefaultAndroidApiLevel Include="@(AndroidBuildApiLevel)" Condition=" '%(Identity)' == '$(AndroidDefaultTargetDotnetApiLevel)' " />
    </ItemGroup>
    <PropertyGroup>
      <_DefaultTargetPlatformVersion>@(_DefaultAndroidApiLevel->'%(PlatformId)')</_DefaultTargetPlatformVersion>
      <_RefPackageIds>@(_AndroidPackageApiLevel->'&quot;$(MicrosoftAndroidSdkPackageId).Ref.%(PlatformId)&quot;,', ' ')</_RefPackageIds>
      <_RefPacks>@(_AndroidPackageApiLevel->'&quot;$(MicrosoftAndroidSdkPackageId).Ref.%(PlatformId)&quot;: { &quot;kind&quot;: &quot;library&quot;, &quot;version&quot;: &quot;$(WorkloadVersion)&quot; },', ' ')</_RefPacks>
    </PropertyGroup>
    <ItemGroup>
      <_WorkloadManifestJsonReplacement Include="@WORKLOAD_VERSION@=$(WorkloadVersion)" />
      <_WorkloadManifestJsonReplacement Include="@NET_PREVIOUS_VERSION@=$(AndroidNetPreviousVersion)" />
      <_WorkloadManifestJsonReplacement Include="@MICROSOFT_ANDROID_SDK_PACKAGE_ID@=$(MicrosoftAndroidSdkPackageId)" />
      <_WorkloadManifestJsonReplacement Include="@MICROSOFT_ANDROID_REF_PACKAGE_IDS@=$(_RefPackageIds)" />
      <_WorkloadManifestJsonReplacement Include="@MICROSOFT_ANDROID_REF_PACKS@=$(_RefPacks)" />
      <_WorkloadManifestTargetsReplacement Include="@WORKLOAD_VERSION@=$(WorkloadVersion)" />
      <_WorkloadManifestTargetsReplacement Include="@NET_PREVIOUS_VERSION@=$(AndroidNetPreviousVersion)" />
      <_WorkloadManifestTargetsReplacement Include="@NET_PREVIOUS_ILLINK_VERSION@=$(AndroidNetPreviousILLinkVersion)" />
      <_WorkloadManifestTargetsReplacement Include="@DOTNET_TARGET_FRAMEWORK_VERSION@=$(DotNetTargetFrameworkVersion)" />
      <_WorkloadManifestTargetsReplacement Include="@DEFAULT_TARGET_PLATFORM_VERSION@=$(_DefaultTargetPlatformVersion)" />
    </ItemGroup>

    <MakeDir Directories="$(OutputPath)workload-manifest;$(_AndroidWorkloadManifestLocalizationPath)" />
    <ReplaceFileContents
        SourceFile="$(XamarinAndroidSourcePath)src\Xamarin.Android.Build.Tasks\Microsoft.NET.Sdk.Android\WorkloadManifest.in.json"
        DestinationFile="$(WorkloadManifestJsonPath)"
        Replacements="@(_WorkloadManifestJsonReplacement)">
    </ReplaceFileContents>
    <ReplaceFileContents
        SourceFile="$(XamarinAndroidSourcePath)src\Xamarin.Android.Build.Tasks\Microsoft.NET.Sdk.Android\WorkloadManifest.in.targets"
        DestinationFile="$(WorkloadManifestTargetsPath)"
        Replacements="@(_WorkloadManifestTargetsReplacement)">
    </ReplaceFileContents>
    <ItemGroup>
      <_AndroidWorkloadManifestLocalizationFiles Include="$(XamarinAndroidSourcePath)src\Xamarin.Android.Build.Tasks\Microsoft.NET.Sdk.Android\localize\WorkloadManifest.*.json" />
    </ItemGroup>
    <Copy
        SourceFiles="@(_AndroidWorkloadManifestLocalizationFiles)"
        DestinationFolder="$(_AndroidWorkloadManifestLocalizationPath)"
        SkipUnchangedFiles="true"
    />

    <ItemGroup>
      <_AndroidPreviewPlatformId
          Include="@(AndroidBuildApiLevel)"
          Condition=" '%(AndroidBuildApiLevel.Unstable)' == 'true' "
      />
    </ItemGroup>
    <PropertyGroup>
      <_AndroidPreviewPlatformIds>@(_AndroidPreviewPlatformId->'%(PlatformId)', ',')</_AndroidPreviewPlatformIds>
    </PropertyGroup>
    <ItemGroup>
      <_WorkloadDepProp Include="AndroidLatestStablePlatformId=$(AndroidLatestStablePlatformId)" />
      <_WorkloadDepProp Include="AndroidPreviewPlatformIds=$(_AndroidPreviewPlatformIds)" />
      <_WorkloadDepProp Include="DotNetStableTargetFramework=$(DotNetStableTargetFramework)" />
      <_WorkloadDepProp Include="MicrosoftAndroidSdkOutDir=$(MicrosoftAndroidSdkOutDir)" />
      <_WorkloadDepProp Include="MonoOptionsVersion=$(MonoOptionsVersion)" />
      <_WorkloadDepProp Include="WorkloadDependenciesPath=$(WorkloadDependenciesPath)" />
      <_WorkloadDepProp Include="WorkloadVersion=$(WorkloadVersion)" />
    </ItemGroup>

    <MSBuild
        Projects="$(MSBuildThisFileDirectory)/../../tools/workload-dependencies/WorkloadDependencies.proj"
        Properties="@(_WorkloadDepProp)"
        Targets="GenerateWorkloadDependencies"
    />

    <ItemGroup>
      <_PackageFiles Include="$(WorkloadManifestJsonPath)" PackagePath="data" />
      <_PackageFiles Include="$(_AndroidWorkloadManifestLocalizationPath)\WorkloadManifest.*.json" PackagePath="data\localize" />
      <_PackageFiles Include="$(WorkloadManifestTargetsPath)" PackagePath="data" />
      <_PackageFiles Include="$(WorkloadDependenciesPath)" PackagePath="data" />
    </ItemGroup>
  </Target>

</Project>
