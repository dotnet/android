<!--
***********************************************************************************************
Microsoft.Android.Ref.proj

This project file is used to create the Microsoft.Android.$(DotNetTargetFramework).Ref.[API] NuGet.
It contains the reference assemblies (ref/) and the managed runtime assemblies
(runtimes/android/lib/) for one Android API level. Projects get it through the
Microsoft.Android NuGet.
***********************************************************************************************
-->
<Project Sdk="Microsoft.Build.NoTargets">

  <Sdk Name="Microsoft.DotNet.SharedFramework.Sdk" Version="$(MicrosoftDotNetBuildTasksFeedPackageVersion)" />

  <PropertyGroup>
    <PackageId>$(MicrosoftAndroidSdkPackageId).Ref.$(AndroidPlatformId)</PackageId>
    <OverridePackageId>$(PackageId)</OverridePackageId>
    <PlatformPackageType>ToolPack</PlatformPackageType>
    <!-- A normal NuGet package; restore rejects the DotnetPlatform package type. -->
    <PackageType>Dependency</PackageType>
    <Description>Microsoft.Android assemblies for API $(AndroidPlatformId). Please do not reference directly; reference the Microsoft.Android package.</Description>
    <_AndroidTargetFramework>$(DotNetAndroidTargetFramework)$(AndroidPlatformId)</_AndroidTargetFramework>
    <_AndroidRefAssemblyPath>ref/$(_AndroidTargetFramework)</_AndroidRefAssemblyPath>
    <_AndroidRuntimeAssemblyPath>runtimes/android/lib/$(_AndroidTargetFramework)</_AndroidRuntimeAssemblyPath>
  </PropertyGroup>

  <PropertyGroup>
    <BeforePack>
      _GetDefaultPackageVersion;
      $(BeforePack);
    </BeforePack>
  </PropertyGroup>

  <Target Name="_GetAndroidAssemblyItems"
      DependsOnTargets="_GetLicense"
      BeforeTargets="GetFilesToPackage" >
    <ItemGroup>
      <_AndroidRefAssemblies Include="$(BuildOutputDirectory)$(DotNetStableTargetFramework)\ref\Java.Interop.dll" />
      <_AndroidRefAssemblies Include="$(_MonoAndroidNETDefaultOutDir)ref\Mono.Android.dll" />
      <!-- XML documentation is only generated by some builds -->
      <_AndroidRefAssemblies Include="$(_MonoAndroidNETDefaultOutDir)Java.Interop.xml" Condition=" Exists('$(_MonoAndroidNETDefaultOutDir)Java.Interop.xml') " />
      <_AndroidRefAssemblies Include="$(_MonoAndroidNETDefaultOutDir)Mono.Android.xml" Condition=" Exists('$(_MonoAndroidNETDefaultOutDir)Mono.Android.xml') " />
      <_AndroidRuntimeAssemblies Include="$(_MonoAndroidNETDefaultOutDir)Java.Interop.dll" />
      <_AndroidRuntimeAssemblies Include="$(_MonoAndroidNETDefaultOutDir)Mono.Android.dll" />
      <_AndroidRuntimeAssemblies Include="$(_MonoAndroidNETDefaultOutDir)System.IO.Hashing.dll" NoSymbols="true" />
    </ItemGroup>

    <!-- For symbols use a relative path one directory up to circumvent the inclusion of a root 'runtimes' folder in the target path, see Microsoft.Android.Sdk.proj -->
    <ItemGroup>
      <FilesToPackage Include="@(_AndroidRefAssemblies)" TargetPath="$(_AndroidRefAssemblyPath)" />
      <FilesToPackage Include="@(_AndroidRuntimeAssemblies)" TargetPath="$(_AndroidRuntimeAssemblyPath)" />
      <FilesToPackage Include="@(_AndroidRuntimeAssemblies->'%(RelativeDir)%(Filename).pdb')" Condition=" '%(_AndroidRuntimeAssemblies.NoSymbols)' != 'true' " TargetPath="..\$(_AndroidRuntimeAssemblyPath)" IsSymbolFile="true" />
    </ItemGroup>
  </Target>

</Project>
