<Project>

  <Target Name="_CreateLocalFrameworkLists">
    <ItemGroup>
      <_FrameworkListInputs Include="$(BuildOutputDirectory)lib\packs\Microsoft.Android.Ref.%(AndroidBuildApiLevel.Identity)\$(AndroidPackVersion)\ref\**" />
      <_FrameworkListInputs Include="$(MicrosoftAndroidSdkAnalysisOutDir)Microsoft.Android.Sdk.Analysis.dll" />
      <_FrameworkListOutputs Include="$(BuildOutputDirectory)lib\packs\Microsoft.Android.Ref.%(AndroidBuildApiLevel.Identity)\$(AndroidPackVersion)\data\FrameworkList.xml">
        <AndroidApiLevel>%(AndroidBuildApiLevel.Identity)</AndroidApiLevel>
      </_FrameworkListOutputs>
      <_FrameworkListAnalyzerOutputs Include="$(BuildOutputDirectory)lib\packs\Microsoft.Android.Ref.%(AndroidBuildApiLevel.Identity)\$(AndroidPackVersion)\analyzers\dotnet\cs\Microsoft.Android.Sdk.Analysis.dll"
          Condition=" '%(AndroidBuildApiLevel.Identity)' != '$(AndroidLatestStableApiLevel)' " />
      <_TemplatesInputs Include="$(XamarinAndroidSourcePath)src\Microsoft.Android.Templates\**" Exclude="$(XamarinAndroidSourcePath)src\Microsoft.Android.Templates\bin\**;$(XamarinAndroidSourcePath)src\Microsoft.Android.Templates\obj\**" />
      <_TemplatesOutputs Include="$(BuildOutputDirectory)lib\template-packs\microsoft.android.templates.$(AndroidPackVersion).nupkg" />
    </ItemGroup>
  </Target>

  <Target Name="_CreateLocalRuntimeListsInputs"
      DependsOnTargets="_CreateLocalFrameworkLists">
    <ItemGroup>
      <!-- Native runtime packs are API-independent and use the latest stable API level. -->
      <_RuntimeListInputs
          Include="$(BuildOutputDirectory)lib\packs\Microsoft.Android.Runtime.%(AndroidAbiAndRuntimeFlavor.AndroidRuntime).$(AndroidLatestStableApiLevel).%(AndroidAbiAndRuntimeFlavor.AndroidRID)\$(AndroidPackVersion)\runtimes\%(AndroidAbiAndRuntimeFlavor.AndroidRID)\**" />
      <_RuntimeListOutputs
          Include="$(BuildOutputDirectory)lib\packs\Microsoft.Android.Runtime.%(AndroidAbiAndRuntimeFlavor.AndroidRuntime).$(AndroidLatestStableApiLevel).%(AndroidAbiAndRuntimeFlavor.AndroidRID)\$(AndroidPackVersion)\data\RuntimeList.xml"
          AndroidApiLevel="$(AndroidLatestStableApiLevel)"
          AndroidRID="%(AndroidAbiAndRuntimeFlavor.AndroidRID)"
          AndroidRuntime="%(AndroidAbiAndRuntimeFlavor.AndroidRuntime)"
      />
      <_ManagedRuntimeListOutputs
          Include="$(BuildOutputDirectory)lib\packs\Microsoft.Android.Runtime.%(AndroidBuildApiLevel.Identity).android\$(AndroidPackVersion)\data\RuntimeList.xml"
          AndroidApiLevel="%(AndroidBuildApiLevel.Identity)"
          AssemblyDirectory="$(_MonoAndroidNETOutputRoot)%(AndroidBuildApiLevel.Identity)\"
      />
    </ItemGroup>
  </Target>

  <Target Name="_CreateLocalManagedRuntimeLists"
      DependsOnTargets="_CreateLocalRuntimeListsInputs"
      Inputs="$(MSBuildAllProjects);$(MSBuildThisFileDirectory)Microsoft.Android.Runtime.Managed.proj;%(_ManagedRuntimeListOutputs.AssemblyDirectory)Java.Interop.dll;%(_ManagedRuntimeListOutputs.AssemblyDirectory)Java.Interop.pdb;%(_ManagedRuntimeListOutputs.AssemblyDirectory)Mono.Android.dll;%(_ManagedRuntimeListOutputs.AssemblyDirectory)Mono.Android.pdb;%(_ManagedRuntimeListOutputs.AssemblyDirectory)System.IO.Hashing.dll"
      Outputs="%(_ManagedRuntimeListOutputs.Identity)">
    <Exec Command="&quot;$(DotNetPreviewTool)&quot; build -t:_GenerateFrameworkList -p:IntermediateOutputPath=%(_ManagedRuntimeListOutputs.RelativeDir) -p:AndroidApiLevel=%(_ManagedRuntimeListOutputs.AndroidApiLevel) -p:Configuration=$(Configuration) &quot;$(MSBuildThisFileDirectory)Microsoft.Android.Runtime.Managed.proj&quot;" />
    <ItemGroup>
      <FileWrites Include="%(_ManagedRuntimeListOutputs.Identity)" />
    </ItemGroup>
  </Target>

  <Target Name="CreateLocalRuntimeLists"
      DependsOnTargets="_CreateLocalRuntimeListsInputs;_CreateLocalManagedRuntimeLists"
      Inputs="$(MSBuildAllProjects);$(MSBuildThisFileDirectory)Microsoft.Android.Runtime.proj;@(_RuntimeListInputs)"
      Outputs="@(_RuntimeListOutputs)">
    <Exec Command="&quot;$(DotNetPreviewTool)&quot; build -t:_GenerateFrameworkList -p:IntermediateOutputPath=%(_RuntimeListOutputs.RelativeDir) -p:AndroidApiLevel=%(_RuntimeListOutputs.AndroidApiLevel) -p:AndroidRID=%(_RuntimeListOutputs.AndroidRID) -p:AndroidRuntime=%(_RuntimeListOutputs.AndroidRuntime) -p:Configuration=$(Configuration) &quot;$(MSBuildThisFileDirectory)Microsoft.Android.Runtime.proj&quot;" />
    <ItemGroup>
      <FileWrites Include="@(_RuntimeListOutputs)" />
    </ItemGroup>
  </Target>

  <Target Name="_CopyLocalReferencePackAnalyzers"
      DependsOnTargets="_CreateLocalFrameworkLists"
      Inputs="$(MicrosoftAndroidSdkAnalysisOutDir)Microsoft.Android.Sdk.Analysis.dll"
      Outputs="@(_FrameworkListAnalyzerOutputs)">
    <Copy SourceFiles="@(_FrameworkListAnalyzerOutputs->'$(MicrosoftAndroidSdkAnalysisOutDir)Microsoft.Android.Sdk.Analysis.dll')"
        DestinationFiles="@(_FrameworkListAnalyzerOutputs)"
        SkipUnchangedFiles="true"
        Condition=" '@(_FrameworkListAnalyzerOutputs->Count())' != '0' " />
    <ItemGroup>
      <FileWrites Include="@(_FrameworkListAnalyzerOutputs)" />
    </ItemGroup>
  </Target>

  <Target Name="CreateLocalFrameworkLists"
      DependsOnTargets="_CreateLocalFrameworkLists;_CopyLocalReferencePackAnalyzers"
      Inputs="$(MSBuildAllProjects);@(_FrameworkListInputs)"
      Outputs="@(_FrameworkListOutputs)">
    <Exec Command="&quot;$(DotNetPreviewTool)&quot; build -t:_GenerateFrameworkList -p:IntermediateOutputPath=%(_FrameworkListOutputs.RelativeDir) -p:AndroidApiLevel=%(_FrameworkListOutputs.AndroidApiLevel) -p:Configuration=$(Configuration) &quot;$(MSBuildThisFileDirectory)Microsoft.Android.Ref.proj&quot;" />
  </Target>

  <Target Name="PackLocalTemplates"
      Inputs="@(_TemplatesInputs)"
      Outputs="@(_TemplatesOutputs)">
    <ItemGroup>
      <_PackProps Include="-v:n -c $(Configuration)" />
      <_PackProps Condition=" '$(LocalizeTemplates)' != '' " Include="-p:LocalizeTemplates=$(LocalizeTemplates)" />
      <_PackProps Include="-p:IncludeSymbols=False" />
      <_PackProps Include="-p:OutputPath=$(BuildOutputDirectory)lib\template-packs" />
      <_PackProps Include="-p:TemplatePackVersion=$(AndroidPackVersion)" />
      <_PackProps Include="-p:PackageId=microsoft.android.templates" />
    </ItemGroup>
    <Exec Command="&quot;$(DotNetPreviewTool)&quot; pack @(_PackProps, ' ') &quot;$(XamarinAndroidSourcePath)src\Microsoft.Android.Templates\Microsoft.Android.Templates.csproj&quot;" />
  </Target>

  <Target Name="_DetermineLocalSdkFeatureBand">
    <PropertyGroup>
      <_LocalSdkFeatureBandPrefix>$([System.Text.RegularExpressions.Regex]::Match($(NETCoreSdkVersion), `^\d+\.\d+\.\d`))</_LocalSdkFeatureBandPrefix>
      <_LocalSdkFeatureBand Condition=" '$(_LocalSdkFeatureBandPrefix)' != '' ">$(_LocalSdkFeatureBandPrefix)00</_LocalSdkFeatureBand>
      <_LocalSdkPrerelease>$([System.Text.RegularExpressions.Regex]::Match($(NETCoreSdkVersion), `(?&lt;=-)[^+]+`))</_LocalSdkPrerelease>
      <_LocalSdkPrereleaseFeatureBand>$([System.Text.RegularExpressions.Regex]::Match($(_LocalSdkPrerelease), `^[^.]+(\.[^.]+)?`))</_LocalSdkPrereleaseFeatureBand>
      <_LocalSdkFeatureBand Condition=" '$(_LocalSdkFeatureBandPrefix)' != '' and '$(_LocalSdkPrerelease)' != '' and !$(_LocalSdkPrerelease.Contains('dev')) and !$(_LocalSdkPrerelease.Contains('ci')) and !$(_LocalSdkPrerelease.Contains('rtm')) ">$(_LocalSdkFeatureBand)-$(_LocalSdkPrereleaseFeatureBand)</_LocalSdkFeatureBand>
    </PropertyGroup>

    <Error Condition=" '$(_LocalSdkFeatureBand)' == '' " Text="Failed to determine the SDK feature band from NETCoreSdkVersion '$(NETCoreSdkVersion)'." />
  </Target>

  <Target Name="InstallManifestAndDependencies"
      DependsOnTargets="_GetDefaultPackageVersion;_DetermineLocalSdkFeatureBand">
    <PropertyGroup>
      <!-- Use the installed SDK version because stabilized SDK builds can retain a prerelease package version. -->
      <_LocalSdkManifestsFolder>$(BuildOutputDirectory)lib\sdk-manifests\$(_LocalSdkFeatureBand)\</_LocalSdkManifestsFolder>
      <_LocalAndroidManifestFolder>$(_LocalSdkManifestsFolder)microsoft.net.sdk.android\$(AndroidPackVersionLong)\</_LocalAndroidManifestFolder>
      <_WorkloadPackRoot>$(BuildOutputDirectory)lib</_WorkloadPackRoot>
      <_WorkloadToInstall>dependencies</_WorkloadToInstall>
    </PropertyGroup>

    <MakeDir Directories="$(_LocalAndroidManifestFolder)" />
    <MSBuild
        Projects="$(MSBuildThisFileDirectory)Microsoft.NET.Sdk.Android.proj"
        Properties="WorkloadManifestJsonPath=$(_LocalAndroidManifestFolder)WorkloadManifest.json;WorkloadManifestTargetsPath=$(_LocalAndroidManifestFolder)WorkloadManifest.targets;WorkloadVersion=$(AndroidPackVersion);_AndroidSkipWorkloadDependencies=true"
        Targets="_GenerateXAWorkloadContent"
    />

    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="InstallWorkloadPacks"
        Properties="_WorkloadPackRoot=$(_WorkloadPackRoot);_WorkloadToInstall=$(_WorkloadToInstall);_LocalAndroidManifestFolder=$(_LocalAndroidManifestFolder)" />
  </Target>

  <Target Name="_ResolveWorkloadPacksInputs">
    <PropertyGroup>
      <_WorkloadPackagesProject>$(BootstrapOutputDirectory)workload-dependencies\$(_WorkloadToInstall).proj</_WorkloadPackagesProject>
      <_WorkloadToolAssembly>$([MSBuild]::NormalizePath('$(BootstrapOutputDirectory)', '$(DotNetTargetFramework)', 'workload-tools.dll'))</_WorkloadToolAssembly>
      <_WorkloadManifestDirectory>$([MSBuild]::NormalizeDirectory('$(_LocalAndroidManifestFolder)'))</_WorkloadManifestDirectory>
      <_WorkloadDestination>$([MSBuild]::NormalizeDirectory('$(_WorkloadPackRoot)'))</_WorkloadDestination>
      <_WorkloadPackageDirectory>$([MSBuild]::NormalizeDirectory('$(XamarinAndroidSourcePath)', 'bin', 'Build$(Configuration)', 'nuget-unsigned'))</_WorkloadPackageDirectory>
      <_WorkloadPackageDirectory Condition=" '$(MauiUseLocalPacks)' == 'true' ">$(_WorkloadPackageDirectory)$([System.IO.Path]::PathSeparator)$([MSBuild]::NormalizeDirectory('$(MauiPackagePath)'))</_WorkloadPackageDirectory>
      <_WorkloadPackagesProject>$([MSBuild]::NormalizePath('$(_WorkloadPackagesProject)'))</_WorkloadPackagesProject>
    </PropertyGroup>
    <XmlPeek Condition=" '$(MauiUseLocalPacks)' == 'true' "
        XmlInputPath="$(MauiSourcePath)/NuGet.config" Query="/configuration/packageSources/add/@value">
      <Output TaskParameter="Result" ItemName="_WorkloadSources" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(XamarinAndroidSourcePath)NuGet.config" Query="/configuration/packageSources/add/@value">
      <Output TaskParameter="Result" ItemName="_WorkloadSources" />
    </XmlPeek>
    <Exec Command="&quot;$(DotNetPreviewTool)&quot; build &quot;$(XamarinAndroidSourcePath)build-tools/workload-tools/workload-tools.csproj&quot; -p:Configuration=$(Configuration)" />
  </Target>

  <!-- SDK pack availability and changing input sets cannot be tracked by timestamps alone. -->
  <Target Name="_ResolveWorkloadPacks" DependsOnTargets="_ResolveWorkloadPacksInputs">
    <!-- A directory's trailing backslash must not escape the closing quote on Windows. -->
    <Exec
        Command="&quot;$(DotNetPreviewTool)&quot; &quot;$(_WorkloadToolAssembly)&quot; &quot;$(DotNetPreviewPath).&quot; &quot;$(NETCoreSdkVersion)&quot; &quot;$(_WorkloadManifestDirectory).&quot; &quot;$(_WorkloadDestination).&quot; &quot;$(_WorkloadPackageDirectory).&quot; &quot;$(_WorkloadPackagesProject)&quot; $(_WorkloadToInstall) &quot;@(_WorkloadSources, ';')&quot;"
        EnvironmentVariables="DOTNETSDK_WORKLOAD_MANIFEST_ROOTS=;DOTNETSDK_WORKLOAD_PACK_ROOTS="
    />
  </Target>

  <!-- Restore immutable dependencies through NuGet, then extract only into this worktree. -->
  <Target Name="InstallWorkloadPacks" DependsOnTargets="_ResolveWorkloadPacks">
    <!-- Use a fresh evaluation after restore so NuGetPackageRoot is available. -->
    <Exec Command="&quot;$(DotNetPreviewTool)&quot; msbuild &quot;$(_WorkloadPackagesProject)&quot; -restore -t:Install -p:Configuration=$(Configuration)" />
  </Target>

  <PropertyGroup>
    <ConfigureLocalWorkloadDependsOn>DeleteExtractedWorkloadPacks;CreateLocalFrameworkLists;CreateLocalRuntimeLists;InstallManifestAndDependencies;PackLocalTemplates</ConfigureLocalWorkloadDependsOn>
  </PropertyGroup>
  <Target Name="ConfigureLocalWorkload" DependsOnTargets="$(ConfigureLocalWorkloadDependsOn)" />

</Project>
