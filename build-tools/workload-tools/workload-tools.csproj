<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(DotNetTargetFramework)</TargetFramework>
    <OutputPath>$(BootstrapOutputDirectory)</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Microsoft.Android.Build.BaseTasks/Microsoft.Android.Build.BaseTasks.csproj" />
    <!-- Use the pinned SDK's resolver rather than duplicating workload graph and host-alias resolution. -->
    <Reference Include="Microsoft.NET.Sdk.WorkloadManifestReader" HintPath="$(MSBuildToolsPath)/Microsoft.NET.Sdk.WorkloadManifestReader.dll" />
    <Reference Include="Microsoft.Deployment.DotNet.Releases" HintPath="$(MSBuildToolsPath)/Microsoft.Deployment.DotNet.Releases.dll" />
  </ItemGroup>
</Project>
