<ContentPage
    xmlns:local="clr-namespace:MauiBenchmarkApp"
    x:Class="MauiBenchmarkApp.LandingPage"
    Title="Dashboard">
    <Grid Padding="24" RowDefinitions="Auto,*">
        <Label
            FontSize="28"
            Text="Dashboard"
            VerticalOptions="Center" />
        <CollectionView
            x:Name="PageList"
            Grid.Row="1"
            Margin="0,20,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:PageLink">
                    <Button
                        AutomationId="{Binding AutomationId}"
                        Clicked="OnPageClicked"
                        Text="{Binding Title}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
