<Project>

  <PropertyGroup>
    <!-- 10.0.301 fixes SourceLink for worktrees with packed refs. -->
    <SourceLinkGitHubPackageVersion Condition=" '$(SourceLinkGitHubPackageVersion)' == '' ">10.0.301</SourceLinkGitHubPackageVersion>
  </PropertyGroup>

  <!-- NuGet Package Versions -->
  <ItemGroup>
    <PackageReference Update="Microsoft.Win32.Registry"                     Version="5.0.0" />
    <PackageReference Update="System.CodeDom"                               Version="10.0.12" />
    <PackageReference Update="Irony"                                        Version="1.5.3" />
  </ItemGroup>

  <!-- Embed Source Link information in PDBs for every project in the repo. -->
  <ItemGroup>
    <!--
      SourceLink is a build-time only package (PrivateAssets="All"), but in 10.x its dependency
      Microsoft.Build.Tasks.Git pulls System.IO.Hashing in as a compile and runtime asset.
      Projects without a direct reference to the pinned $(SystemIOHashingPackageVersion) can pick
      a conflicting version or ship it in the SDK pack's `tools/` directory. System.IO.Hashing
      bumps its AssemblyVersion every patch, so this can cause a MissingMethodException (XACRP7000).
      Exclude SourceLink's compile and runtime assets; source linking uses its build assets.
    -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="$(SourceLinkGitHubPackageVersion)" PrivateAssets="All" ExcludeAssets="compile;runtime" />
  </ItemGroup>

  <!-- Automatically add NRT attribute support for netstandard2.0 projects using NRT -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' AND ('$(Nullable)' == 'enable' OR '$(Nullable)' == 'annotations') ">
    <Compile Include="$(MSBuildThisFileDirectory)src\utils\NullableAttributes.cs" Visible="false" />
  </ItemGroup>

</Project>
